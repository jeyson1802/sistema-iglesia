# Copiar como .env (ignorado por git) y completar. En producción usar variables de entorno reales.
DB_URL=jdbc:postgresql://localhost:5432/iglesia_negocio

# Rol de la aplicación (no dueño de las tablas). Crearlo con scripts/configurar-rol-aplicacion.sql
DB_APP_USUARIO=iglesia_app
DB_APP_CONTRASENA=

# Rol dueño, usado solo por Flyway para crear tablas y políticas
DB_DUENO_USUARIO=
DB_DUENO_CONTRASENA=

JWT_JWKS_URI=http://localhost:8081/oauth2/jwks
JWT_EMISOR=http://localhost:8081

CORS_ORIGENES=http://localhost:4200
