# Copiar como .env (ignorado por git) y completar. En producción usar variables de entorno reales.
DB_URL=jdbc:postgresql://localhost:5432/iglesia_seguridad
DB_USUARIO=
DB_CONTRASENA=

# Ubicación de las claves RSA (formato PEM: pública X.509 y privada PKCS#8)
JWT_CLAVE_PUBLICA=file:./config/claves/publica.pem
JWT_CLAVE_PRIVADA=file:./config/claves/privada.pem
JWT_EMISOR=http://localhost:8081

CORS_ORIGENES=http://localhost:4200

# Opcional: crea el primer administrador del sistema si aún no existe
SEGURIDAD_ADMIN_CORREO=
SEGURIDAD_ADMIN_CONTRASENA=
