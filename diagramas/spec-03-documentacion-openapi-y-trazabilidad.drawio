<mxfile host="app.diagrams.net" pages="4"><diagram id="recorrido" name="1. Recorrido de una petición"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1350" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="recorrido-1" value="&lt;b&gt;Recorrido de una petición: del navegador a la base de datos con un solo traceId&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="40" as="geometry"/></mxCell><mxCell id="recorrido-2" value="Orden real de los filtros en iglesia-seguridad e iglesia-api. El traceId nace en el backend que recibe la petición y viaja en el MDC: toda línea de log de esa petición lo lleva, y la respuesta lo devuelve en X-Trace-Id." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1620" height="40" as="geometry"/></mxCell><mxCell id="recorrido-3" value="iglesia-web (Angular)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=3;fontSize=15;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="560" as="geometry"/></mxCell><mxCell id="recorrido-4" value="&lt;b&gt;Página / servicio&lt;/b&gt;&lt;br&gt;p. ej. LoginComponent → SesionService → HttpClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="340" height="60" as="geometry"/></mxCell><mxCell id="recorrido-5" value="&lt;b&gt;auth.interceptor&lt;/b&gt;&lt;br&gt;agrega Authorization: Bearer (solo a los backends propios); ante 401 refresca y reintenta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="340" height="70" as="geometry"/></mxCell><mxCell id="recorrido-6" value="&lt;b&gt;errores.interceptor&lt;/b&gt; (después de auth)&lt;br&gt;ve cada respuesta una vez; 5xx / status 0 → toast global (página 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="340" height="70" as="geometry"/></mxCell><mxCell id="recorrido-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-4" target="recorrido-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-5" target="recorrido-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-9" value="&lt;b&gt;Respuesta que recibe el frontend&lt;/b&gt;&lt;br&gt;• Cabecera &lt;b&gt;X-Trace-Id&lt;/b&gt; en toda respuesta (200, 401, 404, 500…), expuesta en CORS para que JavaScript la lea.&lt;br&gt;• Si es error: ProblemDetail con &lt;b&gt;traceId&lt;/b&gt; igual a la cabecera.&lt;br&gt;• El navegador no envía traceparent: la traza nace en el backend (YAGNI)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="340" height="170" as="geometry"/></mxCell><mxCell id="recorrido-10" value="iglesia-seguridad (8081) / iglesia-api (8080): mismo recorrido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=3;fontSize=15;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="560" height="1000" as="geometry"/></mxCell><mxCell id="recorrido-11" value="&lt;b&gt;① ServerHttpObservationFilter&lt;/b&gt; (Micrometer Tracing + bridge OTel)&lt;br&gt;abre el span: traceId nuevo o el del traceparent W3C; lo pone en el MDC (traceId, spanId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="500" height="70" as="geometry"/></mxCell><mxCell id="recorrido-12" value="&lt;b&gt;② FiltroCabeceraTraza&lt;/b&gt; · common/traza/filter · orden HIGHEST_PRECEDENCE + 2&lt;br&gt;escribe X-Trace-Id &lt;i&gt;antes&lt;/i&gt; de seguir: también sale en los 401/403 que corta Spring Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="260" width="500" height="70" as="geometry"/></mxCell><mxCell id="recorrido-13" value="&lt;b&gt;③ Spring Security&lt;/b&gt; (SeguridadHttpConfig)&lt;br&gt;CORS · BearerTokenAuthenticationFilter valida el JWT (RS256, JWKS)&lt;br&gt;sin token / inválido → EntryPointProblemDetail (401) · sin rol → AccessDeniedProblemDetail (403)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="360" width="500" height="80" as="geometry"/></mxCell><mxCell id="recorrido-14" value="&lt;b&gt;④ FiltroContextoUsuario&lt;/b&gt; · common/traza/filter&lt;br&gt;registrado con addFilterAfter(BearerTokenAuthenticationFilter); no es @Component&lt;br&gt;MDC: &lt;b&gt;usuarioId&lt;/b&gt; = sub · &lt;b&gt;iglesiaId&lt;/b&gt; = claim iglesia_id · se limpian en finally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="470" width="500" height="80" as="geometry"/></mxCell><mxCell id="recorrido-15" value="&lt;b&gt;⑤ @RestController&lt;/b&gt;&lt;br&gt;@Valid, delega y responde (en login pasa la IP: getRemoteAddr)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="580" width="500" height="60" as="geometry"/></mxCell><mxCell id="recorrido-16" value="&lt;b&gt;⑥ @Service&lt;/b&gt;&lt;br&gt;reglas de negocio · &lt;b&gt;log INFO del evento&lt;/b&gt; con ids (nunca correo, nombre ni contraseña)&lt;br&gt;p. ej. «Usuario creado id=12 iglesiaId=1 por usuarioId=3»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="670" width="500" height="70" as="geometry"/></mxCell><mxCell id="recorrido-17" value="&lt;b&gt;⑦ Repository&lt;/b&gt; (Spring Data JPA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="770" width="500" height="50" as="geometry"/></mxCell><mxCell id="recorrido-18" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;iglesia_seguridad / iglesia_negocio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="860" width="300" height="60" as="geometry"/></mxCell><mxCell id="recorrido-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-11" target="recorrido-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-12" target="recorrido-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-13" target="recorrido-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-14" target="recorrido-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-15" target="recorrido-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-16" target="recorrido-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recorrido-17" target="recorrido-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-26" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="recorrido-6" target="recorrido-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-27" value="&lt;b&gt;¿Y si algo falla?&lt;/b&gt; Cualquier excepción de ⑤–⑦ sube a ManejadorGlobalErrores, que registra WARN (4xx) o ERROR con stack trace (5xx) una sola vez y responde ProblemDetail con traceId. Las capas inferiores no registran el error: lo relanzan.&lt;br&gt;&lt;br&gt;Detalle en la página «2. Anatomía de un error»." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="550" y="950" width="500" height="140" as="geometry"/></mxCell><mxCell id="recorrido-28" value="Lo que queda en los logs (misma petición)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=3;fontSize=15;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1160" y="110" width="500" height="560" as="geometry"/></mxCell><mxCell id="recorrido-29" value="&lt;b&gt;Perfil local&lt;/b&gt; (texto, logging.pattern.correlation):&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;INFO [4bf92f35…4736,00f067aa…,u=3,i=1] UsuarioService : Usuario creado id=12 iglesiaId=1 por usuarioId=3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="460" height="150" as="geometry"/></mxCell><mxCell id="recorrido-30" value="&lt;b&gt;Sin perfil = producción&lt;/b&gt; (JSON ECS):&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;{&quot;log&quot;:{&quot;level&quot;:&quot;INFO&quot;},&lt;br&gt;&quot;service&quot;:{&quot;name&quot;:&quot;iglesia-seguridad&quot;},&lt;br&gt;&quot;traceId&quot;:&quot;4bf92f35…4736&quot;,&quot;spanId&quot;:&quot;00f0…&quot;,&lt;br&gt;&quot;usuarioId&quot;:&quot;3&quot;,&quot;iglesiaId&quot;:&quot;1&quot;,&lt;br&gt;&quot;message&quot;:&quot;Usuario creado id=12 …&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="330" width="460" height="190" as="geometry"/></mxCell><mxCell id="recorrido-31" value="&lt;b&gt;Para rastrear un error:&lt;/b&gt; el usuario comunica el código del toast → soporte filtra los logs por traceId → aparecen todas las líneas de esa petición, de todos los filtros y capas, con el usuario y la iglesia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="540" width="460" height="110" as="geometry"/></mxCell><mxCell id="recorrido-32" value="traceId, spanId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="recorrido-11" target="recorrido-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-33" value="usuarioId, iglesiaId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="recorrido-14" target="recorrido-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="recorrido-34" value="&lt;b&gt;Nunca en los logs&lt;/b&gt;&lt;br&gt;• contraseñas ni tokens (JWT, refresco)&lt;br&gt;• cabeceras Authorization / Cookie&lt;br&gt;• correo, nombre u otros datos personales&lt;br&gt;• cuerpos completos de peticiones&lt;br&gt;&lt;br&gt;El login fallido registra usuarioId (o «inexistente») e IP, no el correo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1160" y="700" width="500" height="190" as="geometry"/></mxCell><mxCell id="recorrido-35" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="300" height="24" as="geometry"/></mxCell><mxCell id="recorrido-36" value="Frontend (iglesia-web)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="270" height="30" as="geometry"/></mxCell><mxCell id="recorrido-37" value="Backend: filtros y clases Spring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1180" width="270" height="30" as="geometry"/></mxCell><mxCell id="recorrido-38" value="Spring Security / Micrometer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="270" height="30" as="geometry"/></mxCell><mxCell id="recorrido-39" value="Errores y ProblemDetail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1220" width="270" height="30" as="geometry"/></mxCell><mxCell id="recorrido-40" value="Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="270" height="30" as="geometry"/></mxCell><mxCell id="recorrido-41" value="Notas y decisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1260" width="270" height="30" as="geometry"/></mxCell><mxCell id="recorrido-42" value="Base de datos / herramientas externas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="270" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="error" name="2. Anatomía de un error"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="error-1" value="&lt;b&gt;Anatomía de un error: de la excepción al ProblemDetail, al log y al toast con el código&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="40" as="geometry"/></mxCell><mxCell id="error-2" value="Ejemplo: una excepción inesperada en un servicio (500). A la izquierda el backend, a la derecha el frontend. Los 4xx siguen el mismo camino en el backend, pero en el frontend los maneja la página." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1620" height="40" as="geometry"/></mxCell><mxCell id="error-3" value="Backend (iglesia-seguridad / iglesia-api)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=3;fontSize=15;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="760" height="1040" as="geometry"/></mxCell><mxCell id="error-4" value="&lt;b&gt;@Service&lt;/b&gt; lanza una excepción&lt;br&gt;p. ej. NullPointerException (5xx) o RecursoNoEncontradoException (404)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="330" height="70" as="geometry"/></mxCell><mxCell id="error-5" value="&lt;b&gt;Spring Security&lt;/b&gt; corta antes del controlador:&lt;br&gt;EntryPointProblemDetail (401, + WWW-Authenticate)&lt;br&gt;AccessDeniedProblemDetail (403)&lt;br&gt;→ delegan en handlerExceptionResolver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="160" width="340" height="90" as="geometry"/></mxCell><mxCell id="error-6" value="&lt;b&gt;ManejadorGlobalErrores&lt;/b&gt; · common/error/handler · @RestControllerAdvice (extiende ResponseEntityExceptionHandler)&lt;br&gt;Único punto que decide el estado y registra. También cubre los errores propios de Spring MVC (handleExceptionInternal).&lt;br&gt;En iglesia-seguridad, ManejadorErroresAuth atiende el token de refresco inválido (401 + borra la cookie) con la misma fábrica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="700" height="90" as="geometry"/></mxCell><mxCell id="error-7" value="sube sin registrarse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="error-4" target="error-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-8" value="resolver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="error-5" target="error-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-9" value="&lt;b&gt;FabricaProblemDetail&lt;/b&gt; · common/error/component&lt;br&gt;title y detail en español&lt;br&gt;+ propiedad &lt;b&gt;traceId&lt;/b&gt; (ProveedorTraceId)&lt;br&gt;5xx: detalle genérico, nunca ex.getMessage()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="330" height="110" as="geometry"/></mxCell><mxCell id="error-10" value="crea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="error-6" target="error-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-11" value="&lt;b&gt;4xx → WARN&lt;/b&gt; sin stack trace&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;404 GET /api/usuarios/9: Usuario no encontrado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="430" width="340" height="60" as="geometry"/></mxCell><mxCell id="error-12" value="&lt;b&gt;5xx → ERROR&lt;/b&gt; con la excepción completa, una sola vez&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Error no controlado en GET /api/usuarios&lt;br&gt;java.lang.NullPointerException … at …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="510" width="340" height="80" as="geometry"/></mxCell><mxCell id="error-13" value="registra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="error-6" target="error-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-14" value="&lt;b&gt;Respuesta HTTP 500&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;X-Trace-Id: 4bf92f3577b34da6a3ce929d0e0e4736&lt;br&gt;Content-Type: application/problem+json&lt;br&gt;&lt;br&gt;{ &quot;type&quot;: &quot;about:blank&quot;, &quot;title&quot;: &quot;Error interno&quot;, &quot;status&quot;: 500,&lt;br&gt;  &quot;detail&quot;: &quot;Ocurrió un error inesperado. Comunica el código de seguimiento a soporte.&quot;,&lt;br&gt;  &quot;instance&quot;: &quot;/api/usuarios&quot;, &quot;traceId&quot;: &quot;4bf92f3577b34da6a3ce929d0e0e4736&quot; }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="600" width="700" height="200" as="geometry"/></mxCell><mxCell id="error-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="error-9" target="error-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-16" value="&lt;b&gt;Garantías verificadas por pruebas&lt;/b&gt; (ErroresIntegrationTest, OutputCaptureExtension)&lt;br&gt;• 401, 403, 404 y 500 devuelven ProblemDetail con traceId = cabecera X-Trace-Id.&lt;br&gt;• El 500 no expone el mensaje interno; su log tiene una sola línea ERROR con stack trace y el mismo traceId.&lt;br&gt;• El 404 deja una línea WARN sin stack trace." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="840" width="700" height="120" as="geometry"/></mxCell><mxCell id="error-17" value="&lt;b&gt;Soporte&lt;/b&gt;: con el código que reporta el usuario busca &lt;font face=&quot;Courier New&quot;&gt;traceId = 4bf92f35…&lt;/font&gt; en los logs JSON y encuentra la línea ERROR con el stack trace, el usuarioId, la iglesiaId, el método y la ruta. No hace falta pedir capturas ni reproducir el error." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="990" width="700" height="130" as="geometry"/></mxCell><mxCell id="error-18" value="Frontend (iglesia-web)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=3;fontSize=15;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="800" height="1040" as="geometry"/></mxCell><mxCell id="error-19" value="&lt;b&gt;errores.interceptor&lt;/b&gt; · core/interceptors&lt;br&gt;tap({ error }) — el error &lt;b&gt;siempre se relanza&lt;/b&gt; para que la página siga su flujo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="160" width="350" height="80" as="geometry"/></mxCell><mxCell id="error-20" value="HttpErrorResponse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="error-14" target="error-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-21" value="&lt;b&gt;clasificar-error.ts&lt;/b&gt; · core/errores&lt;br&gt;esErrorInesperado: status ≥ 500&lt;br&gt;esErrorDeConexion: status 0&lt;br&gt;esErrorGlobal = cualquiera de los dos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="280" width="350" height="80" as="geometry"/></mxCell><mxCell id="error-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="error-19" target="error-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-23" value="&lt;b&gt;extraer-trace-id.ts&lt;/b&gt;&lt;br&gt;ProblemDetail.traceId ?? cabecera X-Trace-Id ?? null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="400" width="350" height="70" as="geometry"/></mxCell><mxCell id="error-24" value="5xx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="error-21" target="error-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-25" value="&lt;b&gt;4xx&lt;/b&gt; (400, 401, 403, 404, 409…)&lt;br&gt;sin toast global: la página muestra su mensaje junto al formulario (p. ej. «Correo o contraseña incorrectos»). El 401 lo resuelve antes auth.interceptor con el refresco." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1290" y="280" width="340" height="110" as="geometry"/></mxCell><mxCell id="error-26" value="no global" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="error-21" target="error-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-27" value="&lt;b&gt;NotificadorErroresService&lt;/b&gt; · fachada sobre MessageService&lt;br&gt;errorInesperado(traceId): toast rojo, fijo (sticky)&lt;br&gt;sinConexion(): toast amarillo, 6 s, sin código&lt;br&gt;data: { traceId }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="510" width="350" height="110" as="geometry"/></mxCell><mxCell id="error-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="error-23" target="error-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-29" value="status 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="error-21" target="error-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-30" value="&lt;b&gt;app-toast-errores-globales&lt;/b&gt; · core/errores&lt;br&gt;&amp;lt;p-toast key=&quot;errores-globales&quot;&amp;gt; en AppComponent&lt;br&gt;a ancho completo en móvil (&amp;lt; 640 px)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="660" width="350" height="90" as="geometry"/></mxCell><mxCell id="error-31" value="MessageService.add" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="error-27" target="error-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-32" value="&lt;b&gt;app-codigo-seguimiento&lt;/b&gt; · shared/components&lt;br&gt;código en monoespaciada (select-all) + botón «Copiar» (aria-label) → «Copiado» 2 s; aviso aria-live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="790" width="350" height="90" as="geometry"/></mxCell><mxCell id="error-33" value="si hay traceId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="error-30" target="error-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="error-34" value="&lt;b&gt;Lo que ve el usuario&lt;/b&gt;&lt;br&gt;&lt;br&gt;✖ &lt;b&gt;Error inesperado&lt;/b&gt;&lt;br&gt;Ocurrió un error inesperado. Si persiste, comunica este código a soporte.&lt;br&gt;&lt;br&gt;Código de seguimiento:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;4bf92f3577b34da6a3ce929d0e0e4736&lt;/b&gt;&lt;/font&gt;  [ Copiar ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1290" y="660" width="340" height="220" as="geometry"/></mxCell><mxCell id="error-35" value="&lt;b&gt;Decisiones&lt;/b&gt;&lt;br&gt;• Toast global solo para 5xx y falta de conexión: los 4xx ya tienen mensaje en la página y un toast los duplicaría.&lt;br&gt;• Las páginas (login, cambiar-contrasena) usan la misma regla esErrorGlobal para no repetir el aviso del toast.&lt;br&gt;• El toast de error queda fijo para dar tiempo a copiar el código; si un 5xx llega sin código (p. ej. un proxy), pide reintentar en vez de pedir un código inexistente.&lt;br&gt;• Si el portapapeles falla (sin permiso o fuera de HTTPS), avisa y el código queda seleccionable para copiarlo a mano." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="890" y="920" width="740" height="200" as="geometry"/></mxCell><mxCell id="error-36" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="300" height="24" as="geometry"/></mxCell><mxCell id="error-37" value="Frontend (iglesia-web)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="270" height="30" as="geometry"/></mxCell><mxCell id="error-38" value="Backend: filtros y clases Spring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1230" width="270" height="30" as="geometry"/></mxCell><mxCell id="error-39" value="Spring Security / Micrometer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="270" height="30" as="geometry"/></mxCell><mxCell id="error-40" value="Errores y ProblemDetail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1270" width="270" height="30" as="geometry"/></mxCell><mxCell id="error-41" value="Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="270" height="30" as="geometry"/></mxCell><mxCell id="error-42" value="Notas y decisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1310" width="270" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="perfiles" name="3. Perfiles local y por defecto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="perfiles-1" value="&lt;b&gt;Perfiles: producción segura por defecto, desarrollo con el perfil local&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="40" as="geometry"/></mxCell><mxCell id="perfiles-2" value="Mismo código en ambos backends. Lo que cambia es la configuración: application.properties (por defecto) y application-local.properties (perfil local). Olvidar el perfil en producción deja la opción segura." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1620" height="40" as="geometry"/></mxCell><mxCell id="perfiles-3" value="Sin perfil = producción (application.properties)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=3;fontSize=15;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="760" height="400" as="geometry"/></mxCell><mxCell id="perfiles-4" value="&lt;font face=&quot;Courier New&quot;&gt;spring.application.name=iglesia-seguridad&lt;br&gt;logging.structured.format.console=ecs&lt;br&gt;management.tracing.sampling.probability=1.0&lt;br&gt;server.forward-headers-strategy=framework&lt;br&gt;springdoc.api-docs.enabled=false&lt;br&gt;springdoc.swagger-ui.enabled=false&lt;br&gt;springdoc.default-produces-media-type=application/json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="700" height="150" as="geometry"/></mxCell><mxCell id="perfiles-5" value="&lt;b&gt;Resultado&lt;/b&gt;&lt;br&gt;• Logs en &lt;b&gt;JSON ECS&lt;/b&gt;, una línea por evento, con service.name, traceId, spanId, usuarioId e iglesiaId: listos para un agregador de logs.&lt;br&gt;• &lt;b&gt;Toda petición se traza&lt;/b&gt; (muestreo 1.0); no se exportan trazas a un backend de observabilidad (fuera de alcance).&lt;br&gt;• &lt;b&gt;IP real del cliente&lt;/b&gt; detrás del proxy inverso (X-Forwarded-For): la usa el log del login fallido.&lt;br&gt;• &lt;b&gt;/v3/api-docs y /swagger-ui.html responden 404&lt;/b&gt;: la API no se publica en producción.&lt;br&gt;• Secretos solo por variables de entorno; nada sensible en el repositorio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="700" height="160" as="geometry"/></mxCell><mxCell id="perfiles-6" value="Perfil local (application-local.properties)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=3;fontSize=15;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="800" height="400" as="geometry"/></mxCell><mxCell id="perfiles-7" value="&lt;font face=&quot;Courier New&quot;&gt;# lo activa ./gradlew bootRun (build.gradle)&lt;br&gt;logging.structured.format.console=&lt;br&gt;logging.pattern.correlation=[%X{traceId:-},%X{spanId:-},u=%X{usuarioId:-},i=%X{iglesiaId:-}]&lt;br&gt;springdoc.api-docs.enabled=true&lt;br&gt;springdoc.swagger-ui.enabled=true&lt;br&gt;springdoc.swagger-ui.path=/swagger-ui.html&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="890" y="160" width="740" height="150" as="geometry"/></mxCell><mxCell id="perfiles-8" value="&lt;b&gt;Resultado&lt;/b&gt;&lt;br&gt;• Logs en &lt;b&gt;texto legible&lt;/b&gt; con el contexto de correlación:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;INFO [4bf9…,00f0…,u=3,i=1] AuthService : Inicio de sesión exitoso usuarioId=3&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Swagger UI&lt;/b&gt; en http://localhost:8081/swagger-ui.html (seguridad) y :8080 (api).&lt;br&gt;• &lt;b&gt;/v3/api-docs&lt;/b&gt; público (permitAll de OpenApiConfig.RUTAS_DOCUMENTACION).&lt;br&gt;• Lo usa también la carpeta «Documentación» de Postman." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="890" y="330" width="740" height="160" as="geometry"/></mxCell><mxCell id="perfiles-9" value="&lt;b&gt;./gradlew bootRun&lt;/b&gt;&lt;br&gt;tasks.named(&#x27;bootRun&#x27;) { systemProperty &#x27;spring.profiles.active&#x27;, &#x27;local&#x27; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="560" width="380" height="90" as="geometry"/></mxCell><mxCell id="perfiles-10" value="&lt;b&gt;java -jar app.jar&lt;/b&gt; / contenedor&lt;br&gt;sin perfil → producción" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="360" height="90" as="geometry"/></mxCell><mxCell id="perfiles-11" value="&lt;b&gt;./gradlew test&lt;/b&gt;&lt;br&gt;sin perfil: las pruebas ven el formato JSON de producción y lo verifican" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="560" width="360" height="90" as="geometry"/></mxCell><mxCell id="perfiles-12" value="&lt;b&gt;Pruebas con @ActiveProfiles(&quot;local&quot;)&lt;/b&gt;&lt;br&gt;OpenApiLocalIntegrationTest, OpenApiCoberturaIntegrationTest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="560" width="380" height="90" as="geometry"/></mxCell><mxCell id="perfiles-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.26;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="perfiles-9" target="perfiles-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="perfiles-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.24;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="perfiles-10" target="perfiles-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="perfiles-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.76;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="perfiles-11" target="perfiles-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="perfiles-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="perfiles-12" target="perfiles-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="perfiles-17" value="&lt;b&gt;Por qué así&lt;/b&gt;: el perfil por defecto es el seguro, de modo que un despliegue sin configurar no expone Swagger ni escribe logs difíciles de procesar. El perfil local nunca se activa en producción. Las pruebas corren sin perfil para validar el comportamiento real de producción (JSON con traceId, usuarioId e iglesiaId, 404 en la documentación), y solo las de OpenAPI activan local." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1620" height="90" as="geometry"/></mxCell><mxCell id="perfiles-18" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="300" height="24" as="geometry"/></mxCell><mxCell id="perfiles-19" value="Configuración / perfiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="270" height="30" as="geometry"/></mxCell><mxCell id="perfiles-20" value="Notas y decisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="850" width="270" height="30" as="geometry"/></mxCell><mxCell id="perfiles-21" value="Base de datos / herramientas externas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="270" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="openapi" name="4. Documentación OpenAPI y Postman"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="openapi-1" value="&lt;b&gt;Documentación OpenAPI y Postman&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="40" as="geometry"/></mxCell><mxCell id="openapi-2" value="La documentación vive junto al endpoint (anotaciones) y una prueba falla si algo queda sin documentar. Postman verifica X-Trace-Id en cada respuesta." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1620" height="40" as="geometry"/></mxCell><mxCell id="openapi-3" value="&lt;b&gt;OpenApiConfig&lt;/b&gt; · common/openapi/config (ambos backends)&lt;br&gt;• Bean OpenAPI: título, versión v1, descripción del backend&lt;br&gt;• Esquema &lt;b&gt;bearerAuth&lt;/b&gt; (HTTP bearer JWT) aplicado globalmente; los públicos con @SecurityRequirements vacío&lt;br&gt;• OpenApiCustomizer: cabecera &lt;b&gt;X-Trace-Id&lt;/b&gt; en todas las respuestas&lt;br&gt;• RUTAS_DOCUMENTACION con permitAll en SeguridadHttpConfig" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="220" as="geometry"/></mxCell><mxCell id="openapi-4" value="&lt;b&gt;Controladores&lt;/b&gt; (iglesia-seguridad)&lt;br&gt;• AuthController «Autenticación»: login, refresh, logout (públicos; cookie iglesia_refresco y Set-Cookie documentados)&lt;br&gt;• UsuarioController «Usuarios»: 6 operaciones con rol y reglas en la descripción, @ApiResponse por código, @ParameterObject en la paginación&lt;br&gt;• JwksController «Infraestructura»: /oauth2/jwks público" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="520" height="200" as="geometry"/></mxCell><mxCell id="openapi-5" value="&lt;b&gt;DTOs y errores&lt;/b&gt;&lt;br&gt;• Cada record *Request / *Response y el enum Rol con @Schema en clase y campos (descripción + ejemplo ficticio)&lt;br&gt;• &lt;b&gt;ProblemDetailEsquema&lt;/b&gt; (@Schema name=&quot;ProblemDetail&quot;): la forma real del error, con traceId y errores&lt;br&gt;• &lt;b&gt;RespuestasOpenApi&lt;/b&gt;: textos comunes de 400 / 401 / 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="520" height="170" as="geometry"/></mxCell><mxCell id="openapi-6" value="&lt;b&gt;springdoc-openapi 3.2.0&lt;/b&gt;&lt;br&gt;genera la especificación a partir de las anotaciones y de Bean Validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="340" height="110" as="geometry"/></mxCell><mxCell id="openapi-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="openapi-3" target="openapi-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="openapi-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="openapi-4" target="openapi-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="openapi-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="openapi-5" target="openapi-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="openapi-10" value="&lt;b&gt;GET /v3/api-docs&lt;/b&gt;&lt;br&gt;especificación OpenAPI 3 (JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="300" height="70" as="geometry"/></mxCell><mxCell id="openapi-11" value="&lt;b&gt;/swagger-ui.html&lt;/b&gt;&lt;br&gt;documentación navegable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="300" width="300" height="70" as="geometry"/></mxCell><mxCell id="openapi-12" value="&lt;b&gt;Postman&lt;/b&gt; «5. Documentación» (seguridad) / «2. Documentación» (api)&lt;br&gt;{{seguridadUrl}} / {{apiUrl}} + /v3/api-docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="400" width="300" height="90" as="geometry"/></mxCell><mxCell id="openapi-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="openapi-6" target="openapi-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="openapi-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="openapi-6" target="openapi-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="openapi-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="openapi-6" target="openapi-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="openapi-16" value="&lt;b&gt;OpenApiCoberturaIntegrationTest&lt;/b&gt; (perfil local) falla si…&lt;br&gt;• una operación no tiene summary, description o tag;&lt;br&gt;• una respuesta no tiene descripción o la cabecera X-Trace-Id;&lt;br&gt;• un 4xx/5xx no declara ProblemDetail como application/problem+json;&lt;br&gt;• una operación es pública sin estar en la lista de públicas, o al revés;&lt;br&gt;• un DTO de un paquete dto (búsqueda en el classpath) no tiene descripción, o un campo no tiene descripción o ejemplo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="640" y="590" width="720" height="170" as="geometry"/></mxCell><mxCell id="openapi-17" value="la prueba recorre /v3/api-docs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="openapi-6" target="openapi-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="openapi-18" value="Colecciones Postman" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=3;fontSize=15;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1400" y="110" width="260" height="650" as="geometry"/></mxCell><mxCell id="openapi-19" value="&lt;b&gt;Prueba a nivel de colección&lt;/b&gt; (ambas)&lt;br&gt;• toda respuesta trae X-Trace-Id de 32 hex&lt;br&gt;• si es application/problem+json, traceId del cuerpo = cabecera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1420" y="160" width="220" height="290" as="geometry"/></mxCell><mxCell id="openapi-20" value="&lt;b&gt;iglesia-api&lt;/b&gt; (nueva)&lt;br&gt;1. Infraestructura: /actuator/health&lt;br&gt;2. Documentación: /v3/api-docs&lt;br&gt;&lt;br&gt;Los módulos de negocio agregan sus carpetas en sus specs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1420" y="470" width="220" height="270" as="geometry"/></mxCell><mxCell id="openapi-21" value="&lt;b&gt;Regla del proyecto&lt;/b&gt;: un endpoint no está terminado sin su documentación OpenAPI y su request en Postman. ProblemDetailEsquema y RespuestasOpenApi se copian a iglesia-api con su primer controlador (YAGNI)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1620" height="90" as="geometry"/></mxCell><mxCell id="openapi-22" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="300" height="24" as="geometry"/></mxCell><mxCell id="openapi-23" value="Backend: filtros y clases Spring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="270" height="30" as="geometry"/></mxCell><mxCell id="openapi-24" value="Spring Security / Micrometer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="960" width="270" height="30" as="geometry"/></mxCell><mxCell id="openapi-25" value="Errores y ProblemDetail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="270" height="30" as="geometry"/></mxCell><mxCell id="openapi-26" value="Notas y decisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1000" width="270" height="30" as="geometry"/></mxCell><mxCell id="openapi-27" value="Base de datos / herramientas externas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="270" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
