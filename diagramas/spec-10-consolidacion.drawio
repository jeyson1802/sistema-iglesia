<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arquitectura" name="1. Arquitectura de la consolidación"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arquitectura-1" value="&lt;b&gt;Arquitectura: consolidación de nuevos y seguimiento pastoral&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-2" value="Pantallas del frontend, servicios REST que consumen, clases de iglesia-api que los atienden y tablas que leen o escriben." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-3" value="iglesia-web · features/consolidacion (+ miembros)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="820" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-4" value="Contrato HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="880" y="110" width="360" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-5" value="iglesia-api · paquete consolidacion/ (+ miembros y asistencia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1270" y="110" width="900" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;Rutas (/consolidacion, hijas de AppLayout)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&#x27;&#x27; → inicio (ver | administrar) · rondas/nueva (administrar)&lt;br&gt;rondas/:id (ver | administrar) · mis-asignados (contactar | administrar)&lt;br&gt;casos/:id (cualquiera) · resultados (administrar)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="520" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-7" value="&lt;b&gt;Menú&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Iglesia › Consolidación (pi-heart)&lt;br&gt;Iglesia › Mis asignados (pi-phone)&lt;br&gt;Administración › Resultados de consolidación&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="590" y="150" width="240" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-8" value="&lt;b&gt;ConsolidacionInicioComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pestaña Rondas: «En curso» (TarjetaRonda + MedidorRonda)&lt;br&gt;y TablaRondas (servidor) · pestaña Equipo: TarjetasEquipo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="260" width="380" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-9" value="&lt;b&gt;NuevaRondaComponent (asistente)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;1 FormularioRonda · 2 SelectorLote (vista previa en vivo)&lt;br&gt;3 Reparto · 4 Resumen → Iniciar o dejar planificada&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="260" width="380" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-10" value="&lt;b&gt;DetalleRondaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Personas: FiltrosCasos + TablaCasos (selección)&lt;br&gt;barra: Asignar a… · Repartir · Quitar · Avance: AvanceRonda&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="360" width="380" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;ResultadosConsolidacionComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;TablaResultados + FormularioResultado&lt;br&gt;ordenar · desactivar · vista previa de botones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="360" width="380" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-12" value="&lt;b&gt;MisAsignadosComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;saludo + medidor · búsqueda · 3 SeccionCasos&lt;br&gt;(Para hoy · Sin contactar · En contacto) con TarjetaCaso&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="460" width="380" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-13" value="&lt;b&gt;CasoConsolidacionComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Antes de contactar» · datos · asistencia&lt;br&gt;LineaTiempo · IteracionesAnteriores · barra fija en el celular&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="460" width="380" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-14" value="&lt;b&gt;Piezas del registro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;BotonesContacto (shared: tel: y wa.me) · HojaContacto&lt;br&gt;CerrarCaso · GrupoOpciones (radiogroup con flechas)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="560" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-15" value="&lt;b&gt;ContactoEnCursoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;recuerda el contacto iniciado y, al volver a la pestaña&lt;br&gt;(visibilitychange), abre la hoja con el medio elegido&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="560" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-16" value="&lt;b&gt;Ficha del miembro (miembros)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ConsolidacionMiembro: iteraciones, último resultado, caso abierto&lt;br&gt;«Iniciar seguimiento» · «Ver historial»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="650" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-17" value="&lt;b&gt;HistorialConsolidacionMiembroComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/miembros/:id/consolidacion · SemanasAsistencia con&lt;br&gt;las semanas de contacto marcadas · iteraciones paginadas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="650" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-18" value="&lt;b&gt;RondasService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · obtener · crear · actualizar · borrar · iniciar · cerrar&lt;br&gt;vistaPreviaLote · agregarLote · casos · quitarCaso · reparto · avance&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="750" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-19" value="&lt;b&gt;CasosService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;misCasos · resumenMisCasos · detalle · abrir · cerrar · reabrir&lt;br&gt;contactos (registrar · corregir · borrar) · reasignar · historial&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="750" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-20" value="&lt;b&gt;EquipoConsolidacionService · ResultadosConsolidacionService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · agregar · cambiarEstado · crear · renombrar · ordenar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="840" width="780" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-21" value="&lt;b&gt;Contenedor / presentacional&lt;/b&gt;&lt;br&gt;Las páginas orquestan y llaman a los servicios; tarjetas, tablas, hojas y diálogos solo reciben datos y emiten eventos. Las secciones de «Mis asignados» paginan cada una por su cuenta en el servidor." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="920" width="380" height="120" as="geometry" /></mxCell><mxCell id="arquitectura-22" value="&lt;b&gt;Registro en un toque&lt;/b&gt;&lt;br&gt;Llamar o escribir abre la app del teléfono; al volver, la hoja ya tiene el medio. Tras guardar, la tarjeta sale de la lista al instante y un toast ofrece «Deshacer» durante 8 s." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="450" y="920" width="380" height="120" as="geometry" /></mxCell><mxCell id="arquitectura-23" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="50" y="1070" width="230" height="220" as="geometry" /></mxCell><mxCell id="arquitectura-24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="62" y="1104" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-25" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1100" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-26" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1" ><mxGeometry x="62" y="1134" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-27" value="Rutas y guards" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1130" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="62" y="1164" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-29" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1160" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="62" y="1194" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-31" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1190" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="62" y="1224" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-33" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1220" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="62" y="1254" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-35" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1250" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-36" value="&lt;b&gt;GET · POST · PUT · DELETE /api/consolidacion/rondas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;filtros por estado y texto · borrar solo PLANIFICADA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="150" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-37" value="&lt;b&gt;POST /rondas/{id}/iniciar · /cerrar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iniciar exige personas · cerrar deja los casos abiertos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="255" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-38" value="&lt;b&gt;POST /rondas/{id}/lote/vista-previa · /lote&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;filtros (nuevos, faltas, sin grupo…) o lista a mano&lt;br&gt;omite quien ya tiene un caso abierto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="360" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-39" value="&lt;b&gt;POST /rondas/{id}/repartir/vista-previa · /repartir&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;partes iguales entre el equipo elegido + ajustes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="465" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-40" value="&lt;b&gt;GET /rondas/{id}/casos · DELETE /casos/{casoId} · GET /avance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Page · quitar del lote · embudo y por consolidador&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="570" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-41" value="&lt;b&gt;GET /api/consolidacion/mis-casos?seccion · /resumen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PARA_HOY · SIN_CONTACTAR · EN_CONTACTO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="675" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-42" value="&lt;b&gt;GET · POST /casos · POST /casos/{id}/cerrar · /reabrir&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;detalle con antes, asistencia e iteraciones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="780" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-43" value="&lt;b&gt;POST /casos/{id}/contactos · PUT · DELETE /contactos/{id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;corregir y borrar: autor o coordinador, 24 h&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="885" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-44" value="&lt;b&gt;PATCH /casos/{id}/consolidador · /casos/consolidador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reasignar uno o varios (administrar)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="990" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-45" value="&lt;b&gt;GET · POST · PATCH /equipo · /resultados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;equipo por miembro · resultados ordenables&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="1095" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-46" value="&lt;b&gt;GET /api/miembros/{id}/consolidacion · /historial&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;resumen para la ficha · iteraciones paginadas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="1200" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-47" value="&lt;b&gt;RondaConsolidacionController → RondaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;crear · actualizar · borrar · iniciar · cerrar&lt;br&gt;listado con EspecificacionesConsolidacion&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="150" width="420" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-48" value="&lt;b&gt;LoteService · RepartoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CriteriosLote → consulta nativa con faltas seguidas&lt;br&gt;Reparto: propuesta round-robin por carga&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="360" width="420" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-49" value="&lt;b&gt;AvanceRondaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;embudo · resultados · por consolidador&lt;br&gt;tiempo al primer contacto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="570" width="420" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-50" value="&lt;b&gt;CasoConsolidacionController → CasoService · ContactoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;mis casos · detalle · abrir · cerrar · reabrir&lt;br&gt;registrar / corregir / borrar contacto · reasignar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="720" width="420" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-51" value="&lt;b&gt;EquipoConsolidacionController · ResultadoConsolidacionController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;EquipoConsolidacionService · ResultadoConsolidacionService&lt;br&gt;ResultadosPorDefecto al crear la iglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="1080" width="420" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-52" value="&lt;b&gt;ConsolidacionMiembroController → HistorialConsolidacionService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ResumenesDeCasos (antes de contactar, iteraciones)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="1200" width="420" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-53" value="&lt;b&gt;AmbitoConsolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;administrar o ver: toda la iglesia&lt;br&gt;contactar: sus casos (y su red si es líder)&lt;br&gt;fuera de ámbito → 404 / 403&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1740" y="720" width="400" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-54" value="&lt;b&gt;MiembrosParaConsolidacion (miembros)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PersonaConsolidacion · ContactoPersona&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1740" y="880" width="400" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-55" value="&lt;b&gt;AsistenciaParaConsolidacion (asistencia)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;resumen, últimas asistencias, FechaAsistida&lt;br&gt;«volvió a asistir» tras hablarle&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1740" y="970" width="400" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-36" target="arquitectura-47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-37" target="arquitectura-47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-38" target="arquitectura-48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-39" target="arquitectura-48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-40" target="arquitectura-49"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-41" target="arquitectura-50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-42" target="arquitectura-50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-43" target="arquitectura-50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-44" target="arquitectura-50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-45" target="arquitectura-51"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-46" target="arquitectura-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-50" target="arquitectura-53"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-50" target="arquitectura-54"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-50" target="arquitectura-55"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-70" value="&lt;b&gt;ronda_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre · fechas · estado&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1740" y="160" width="200" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-71" value="&lt;b&gt;caso_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ronda_id? · miembro_id · consolidador_id&lt;br&gt;estado · proximo_contacto · resultado&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1950" y="160" width="210" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-72" value="&lt;b&gt;contacto_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fecha_hora · medio · resultado&lt;br&gt;observaciones · registrado_por&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1740" y="270" width="200" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-73" value="&lt;b&gt;consolidador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembro_id · activo&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1950" y="270" width="210" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-74" value="&lt;b&gt;resultado_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre · orden · activo&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1740" y="380" width="200" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-75" value="&lt;b&gt;miembro · asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lectura (otros contextos)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1950" y="380" width="210" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-76" value="&lt;b&gt;Los contextos no se mezclan&lt;/b&gt;&lt;br&gt;consolidacion lee personas y asistencia solo a través de servicios públicos de miembros y asistencia (records de &lt;code&gt;model&lt;/code&gt;), nunca de sus entidades ni repositorios." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1740" y="1080" width="400" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ronda" name="2. Ciclo de una ronda"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ronda-1" value="&lt;b&gt;Ciclo de una ronda (coordinador)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="ronda-2" value="Del lote en papel a un tablero: planificar, armar el lote, repartir, iniciar, seguir el avance y cerrar." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="ronda-3" value="&lt;b&gt;1. Crear la ronda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;FormularioRonda: nombre sugerido («Noviembre 2026»), fechas con atajos&lt;br&gt;POST /rondas → PLANIFICADA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="140" width="380" height="80" as="geometry" /></mxCell><mxCell id="ronda-4" value="&lt;b&gt;2. Armar el lote&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SelectorLote: chips (Nuevos, Nuevo sin volver, Faltas seguidas,&lt;br&gt;Sin grupo, Nunca consolidados) · vista previa en vivo (300 ms)&lt;br&gt;POST /lote/vista-previa → POST /lote&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="260" width="380" height="95" as="geometry" /></mxCell><mxCell id="ronda-5" value="&lt;b&gt;3. Repartir&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Reparto: consolidadores activos, propuesta en partes iguales,&lt;br&gt;«Mover a…» por persona · POST /repartir&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="395" width="380" height="80" as="geometry" /></mxCell><mxCell id="ronda-6" value="&lt;b&gt;4. Iniciar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;POST /iniciar → EN_CURSO: los casos aparecen en «Mis asignados»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="515" width="380" height="65" as="geometry" /></mxCell><mxCell id="ronda-7" value="&lt;b&gt;5. Seguir el avance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DetalleRonda › Avance: embudo (asignados → contactados → hablados&lt;br&gt;→ cerrados), resultados y tabla por consolidador&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="620" width="380" height="80" as="geometry" /></mxCell><mxCell id="ronda-8" value="&lt;b&gt;6. Cerrar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;POST /cerrar → CERRADA: se conserva todo; ya no se registra&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="740" width="380" height="65" as="geometry" /></mxCell><mxCell id="ronda-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-3" target="ronda-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-4" target="ronda-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-5" target="ronda-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-6" target="ronda-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-7" target="ronda-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-14" value="&lt;b&gt;LoteService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;una sola consulta nativa con los criterios&lt;br&gt;filtra iglesia_id también en la CTE de faltas&lt;br&gt;omite a quien ya tiene un caso abierto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="560" y="250" width="360" height="100" as="geometry" /></mxCell><mxCell id="ronda-15" value="&lt;b&gt;RepartoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reparte por carga actual (menos casos primero)&lt;br&gt;valida que cada consolidador esté activo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="560" y="385" width="360" height="90" as="geometry" /></mxCell><mxCell id="ronda-16" value="&lt;b&gt;RondaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;transiciones PLANIFICADA → EN_CURSO → CERRADA&lt;br&gt;reglas: iniciar con personas; borrar solo planificada&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="560" y="515" width="360" height="90" as="geometry" /></mxCell><mxCell id="ronda-17" value="&lt;b&gt;AvanceRondaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;conteos agregados en la base (sin bucles)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="560" y="630" width="360" height="70" as="geometry" /></mxCell><mxCell id="ronda-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-4" target="ronda-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-5" target="ronda-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-6" target="ronda-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-8" target="ronda-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-7" target="ronda-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-23" value="&lt;b&gt;caso_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;un caso por persona y ronda&lt;br&gt;ux_caso_abierto_por_miembro&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1000" y="300" width="230" height="95" as="geometry" /></mxCell><mxCell id="ronda-24" value="&lt;b&gt;ronda_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;estado · fechas&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1000" y="520" width="230" height="80" as="geometry" /></mxCell><mxCell id="ronda-25" value="&lt;b&gt;Rechazos (409 ProblemDetail)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• iniciar una ronda sin personas&lt;br&gt;• editar o agregar a una ronda cerrada&lt;br&gt;• borrar una ronda que no está planificada&lt;br&gt;• asignar a un consolidador inactivo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="640" width="300" height="110" as="geometry" /></mxCell><mxCell id="ronda-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="ronda-16" target="ronda-25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ronda-27" value="&lt;b&gt;¿Por qué «Salir y seguir después»?&lt;/b&gt;&lt;br&gt;El asistente guarda en cada paso: la ronda existe desde el paso 1, así que el coordinador puede cerrar la pestaña y retomarla desde su detalle sin perder el lote." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1350" y="140" width="400" height="110" as="geometry" /></mxCell><mxCell id="ronda-28" value="&lt;b&gt;Seguimiento individual&lt;/b&gt;&lt;br&gt;Fuera de rondas, desde la ficha («Iniciar seguimiento») se abre un caso sin ronda. Cuenta como iteración igual que los de ronda." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1350" y="280" width="400" height="95" as="geometry" /></mxCell><mxCell id="ronda-29" value="&lt;b&gt;Sin arrastrar y soltar&lt;/b&gt;&lt;br&gt;El reparto se ajusta con «Mover a…» por persona: funciona igual con teclado, lector de pantalla y en el celular." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1350" y="405" width="400" height="90" as="geometry" /></mxCell><mxCell id="ronda-30" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1350" y="540" width="230" height="190" as="geometry" /></mxCell><mxCell id="ronda-31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1362" y="574" width="28" height="20" as="geometry" /></mxCell><mxCell id="ronda-32" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1398" y="570" width="175" height="28" as="geometry" /></mxCell><mxCell id="ronda-33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1362" y="604" width="28" height="20" as="geometry" /></mxCell><mxCell id="ronda-34" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1398" y="600" width="175" height="28" as="geometry" /></mxCell><mxCell id="ronda-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1362" y="634" width="28" height="20" as="geometry" /></mxCell><mxCell id="ronda-36" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1398" y="630" width="175" height="28" as="geometry" /></mxCell><mxCell id="ronda-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1362" y="664" width="28" height="20" as="geometry" /></mxCell><mxCell id="ronda-38" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1398" y="660" width="175" height="28" as="geometry" /></mxCell><mxCell id="ronda-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1362" y="694" width="28" height="20" as="geometry" /></mxCell><mxCell id="ronda-40" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1398" y="690" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="contacto" name="3. Registrar un contacto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="contacto-1" value="&lt;b&gt;Registrar un contacto (consolidador)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="contacto-2" value="Desde «Mis asignados» o el caso: llamar o escribir, volver, registrar en un toque y, si corresponde, cerrar." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="contacto-3" value="&lt;b&gt;1. Tocar «Llamar» o «WhatsApp»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;BotonesContacto: enlaces reales tel:+51… / wa.me/51…&lt;br&gt;ContactoEnCursoService.iniciar({casoId, nombre, medio})&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="140" width="400" height="85" as="geometry" /></mxCell><mxCell id="contacto-4" value="&lt;b&gt;2. Volver a la pestaña&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;visibilitychange → alVolver() → se abre HojaContacto&lt;br&gt;con el medio ya elegido (y «Llamada sin registrar» si no)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="265" width="400" height="85" as="geometry" /></mxCell><mxCell id="contacto-5" value="&lt;b&gt;3. Elegir resultado y guardar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GrupoOpciones: resultados filtrados por medio&lt;br&gt;observaciones · próximo contacto con atajos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="390" width="400" height="85" as="geometry" /></mxCell><mxCell id="contacto-6" value="&lt;b&gt;4. Respuesta inmediata&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;la tarjeta sale de la sección · toast «Contacto registrado»&lt;br&gt;con «Deshacer» (8 s) · recarga resumen y secciones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="515" width="400" height="85" as="geometry" /></mxCell><mxCell id="contacto-7" value="&lt;b&gt;5. Guardar y cerrar (opcional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CerrarCaso: resultado configurable + observación&lt;br&gt;POST /casos/{id}/cerrar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="640" width="400" height="85" as="geometry" /></mxCell><mxCell id="contacto-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-3" target="contacto-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-4" target="contacto-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-5" target="contacto-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-6" target="contacto-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-12" value="&lt;b&gt;POST /api/consolidacion/casos/{id}/contactos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;RegistrarContactoRequest: fechaHora · medio · resultado&lt;br&gt;observaciones · proximoContacto · consolidadorId?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="560" y="390" width="380" height="85" as="geometry" /></mxCell><mxCell id="contacto-13" value="&lt;b&gt;DELETE /api/consolidacion/contactos/{id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Deshacer» · también «Borrar» en la línea de tiempo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="560" y="515" width="380" height="70" as="geometry" /></mxCell><mxCell id="contacto-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-5" target="contacto-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-6" target="contacto-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-16" value="&lt;b&gt;ContactoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• AmbitoConsolidacion: su caso o coordinador&lt;br&gt;• caso abierto y ronda EN_CURSO&lt;br&gt;• fecha no futura (5 min de tolerancia)&lt;br&gt;• SIN_CONTACTAR → EN_CONTACTO · próximo contacto&lt;br&gt;• registrado_por = usuario del JWT&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1020" y="380" width="400" height="130" as="geometry" /></mxCell><mxCell id="contacto-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-12" target="contacto-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-13" target="contacto-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-19" value="&lt;b&gt;contacto_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;INSERT&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1500" y="360" width="200" height="80" as="geometry" /></mxCell><mxCell id="contacto-20" value="&lt;b&gt;caso_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;UPDATE estado · proximo_contacto&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1500" y="470" width="200" height="80" as="geometry" /></mxCell><mxCell id="contacto-21" value="&lt;b&gt;Rechazos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;400 fecha futura o datos inválidos (junto al campo)&lt;br&gt;404 caso fuera de su ámbito&lt;br&gt;409 caso cerrado, ronda no en curso o pasadas 24 h&lt;br&gt;403 corregir o borrar un contacto ajeno&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1020" y="580" width="400" height="100" as="geometry" /></mxCell><mxCell id="contacto-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="contacto-16" target="contacto-21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="contacto-23" value="&lt;b&gt;«Antes de contactar»&lt;/b&gt;&lt;br&gt;El caso resume en frases lo que hay que saber: iteración, qué respondió antes, si volvió a asistir, faltas seguidas y la petición con la que llegó. Así el consolidador no llama «en frío»." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="560" y="140" width="380" height="120" as="geometry" /></mxCell><mxCell id="contacto-24" value="&lt;b&gt;Historial durante la consolidación&lt;/b&gt;&lt;br&gt;IteracionesAnteriores muestra cada ronda previa con su consolidador, contactos, resultado y observación de cierre, pedido explícito del usuario." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1020" y="140" width="400" height="110" as="geometry" /></mxCell><mxCell id="contacto-25" value="&lt;b&gt;El coordinador puede todo&lt;/b&gt;&lt;br&gt;Con consolidacion.administrar registra, corrige, cierra y reabre cualquier caso, y puede registrar en nombre de un integrante del equipo («¿Quién hizo el contacto?»)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1500" y="140" width="340" height="130" as="geometry" /></mxCell><mxCell id="contacto-26" value="&lt;b&gt;Foco y teclado&lt;/b&gt;&lt;br&gt;Al cerrar la hoja el foco vuelve al botón «Registrar» de la tarjeta; las opciones se recorren con flechas (radiogroup con roving tabindex)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="60" y="770" width="400" height="90" as="geometry" /></mxCell><mxCell id="contacto-27" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1500" y="620" width="230" height="220" as="geometry" /></mxCell><mxCell id="contacto-28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1512" y="654" width="28" height="20" as="geometry" /></mxCell><mxCell id="contacto-29" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="650" width="175" height="28" as="geometry" /></mxCell><mxCell id="contacto-30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1512" y="684" width="28" height="20" as="geometry" /></mxCell><mxCell id="contacto-31" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="680" width="175" height="28" as="geometry" /></mxCell><mxCell id="contacto-32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1512" y="714" width="28" height="20" as="geometry" /></mxCell><mxCell id="contacto-33" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="710" width="175" height="28" as="geometry" /></mxCell><mxCell id="contacto-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1512" y="744" width="28" height="20" as="geometry" /></mxCell><mxCell id="contacto-35" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="740" width="175" height="28" as="geometry" /></mxCell><mxCell id="contacto-36" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1512" y="774" width="28" height="20" as="geometry" /></mxCell><mxCell id="contacto-37" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="770" width="175" height="28" as="geometry" /></mxCell><mxCell id="contacto-38" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1512" y="804" width="28" height="20" as="geometry" /></mxCell><mxCell id="contacto-39" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="800" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="datos" name="4. Modelo de datos y permisos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="datos-1" value="&lt;b&gt;Modelo de datos (V11) y permisos&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="datos-2" value="Todas las tablas llevan iglesia_id con RLS; las FK compuestas (iglesia_id, id) impiden referenciar filas de otra iglesia." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="datos-3" value="&lt;b&gt;ronda_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;id · iglesia_id · nombre · descripcion&lt;br&gt;fecha_inicio · fecha_fin · estado&lt;br&gt;PLANIFICADA | EN_CURSO | CERRADA&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="60" y="150" width="280" height="120" as="geometry" /></mxCell><mxCell id="datos-4" value="&lt;b&gt;caso_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;id · iglesia_id · ronda_id (null = individual)&lt;br&gt;miembro_id · consolidador_id · estado&lt;br&gt;SIN_CONTACTAR | EN_CONTACTO | CERRADO&lt;br&gt;proximo_contacto · resultado_id · observacion_cierre&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="440" y="140" width="330" height="140" as="geometry" /></mxCell><mxCell id="datos-5" value="&lt;b&gt;contacto_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;id · iglesia_id · caso_id · fecha_hora&lt;br&gt;medio LLAMADA | WHATSAPP | VISITA | OTRO&lt;br&gt;resultado SE_HABLO | NO_RESPONDIO | …&lt;br&gt;observaciones · registrado_por&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="870" y="140" width="330" height="140" as="geometry" /></mxCell><mxCell id="datos-6" value="&lt;b&gt;consolidador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;id · iglesia_id · miembro_id · activo&lt;br&gt;UNIQUE (iglesia_id, miembro_id)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="440" y="360" width="330" height="100" as="geometry" /></mxCell><mxCell id="datos-7" value="&lt;b&gt;resultado_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;id · iglesia_id · nombre · orden · activo&lt;br&gt;valores por defecto al crear la iglesia&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="60" y="360" width="280" height="100" as="geometry" /></mxCell><mxCell id="datos-8" value="&lt;b&gt;miembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(spec 01)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="870" y="360" width="200" height="80" as="geometry" /></mxCell><mxCell id="datos-9" value="ronda_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="datos-4" target="datos-3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="datos-10" value="caso_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="datos-5" target="datos-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="datos-11" value="consolidador_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="datos-4" target="datos-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="datos-12" value="resultado_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="datos-4" target="datos-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="datos-13" value="miembro_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="datos-4" target="datos-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="datos-14" value="miembro_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" parent="1" edge="1" source="datos-6" target="datos-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="datos-15" value="&lt;b&gt;Índices que expresan reglas&lt;/b&gt;&lt;br&gt;• ux_caso_abierto_por_miembro: un solo caso abierto por persona (parcial, estado &amp;lt;&amp;gt; CERRADO).&lt;br&gt;• ux_caso_ronda_miembro: una persona aparece una vez por ronda.&lt;br&gt;• ux_*_nombre: nombres únicos por iglesia sin distinguir mayúsculas.&lt;br&gt;• Todos los índices empiezan por iglesia_id." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="60" y="520" width="560" height="130" as="geometry" /></mxCell><mxCell id="datos-16" value="&lt;b&gt;Una iteración = un caso&lt;/b&gt;&lt;br&gt;Cada vez que la persona entra a una ronda o a un seguimiento individual nace un caso nuevo; las iteraciones anteriores son los casos cerrados. El resultado es configurable por iglesia; cerrar «no hace nada más», solo registra." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="660" y="520" width="540" height="130" as="geometry" /></mxCell><mxCell id="datos-17" value="&lt;b&gt;Permisos (iglesia-seguridad, V9)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1280" y="140" width="560" height="50" as="geometry" /></mxCell><mxCell id="datos-18" value="&lt;b&gt;consolidacion.administrar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;coordinador: rondas, lote, reparto, equipo, resultados,&lt;br&gt;reasignar y todo lo del consolidador · ADMIN_IGLESIA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1280" y="210" width="560" height="70" as="geometry" /></mxCell><mxCell id="datos-19" value="&lt;b&gt;consolidacion.ver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;supervisión: ve rondas, avance y casos sin modificar · ADMIN_IGLESIA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1280" y="300" width="560" height="60" as="geometry" /></mxCell><mxCell id="datos-20" value="&lt;b&gt;consolidacion.contactar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;consolidador: «Mis asignados», registrar en sus casos,&lt;br&gt;iniciar seguimiento a su red · ADMIN_IGLESIA y LIDER&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1280" y="380" width="560" height="70" as="geometry" /></mxCell><mxCell id="datos-21" value="&lt;b&gt;Sin bases compartidas&lt;/b&gt;&lt;br&gt;El consolidador es un miembro (iglesia-api); el permiso viene en el JWT de iglesia-seguridad. Por eso no se puede mostrar «Sin acceso al sistema» en el equipo: iglesia-api no sabe si ese miembro tiene usuario." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1280" y="480" width="560" height="110" as="geometry" /></mxCell><mxCell id="datos-22" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1280" y="630" width="230" height="130" as="geometry" /></mxCell><mxCell id="datos-23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1292" y="664" width="28" height="20" as="geometry" /></mxCell><mxCell id="datos-24" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1328" y="660" width="175" height="28" as="geometry" /></mxCell><mxCell id="datos-25" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1292" y="694" width="28" height="20" as="geometry" /></mxCell><mxCell id="datos-26" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1328" y="690" width="175" height="28" as="geometry" /></mxCell><mxCell id="datos-27" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1292" y="724" width="28" height="20" as="geometry" /></mxCell><mxCell id="datos-28" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1328" y="720" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
