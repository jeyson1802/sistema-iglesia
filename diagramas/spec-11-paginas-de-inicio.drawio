nar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1790" y="150" width="460" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-43" target="arquitectura-59"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-44" target="arquitectura-59"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-45" target="arquitectura-59"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-46" target="arquitectura-59"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-47" target="arquitectura-59"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-65" value="&lt;b&gt;miembro · grupo · reunion · asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lectura agregada con RLS&lt;br&gt;(app.iglesia_id)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1790" y="330" width="460" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-66" value="&lt;b&gt;caso · contacto · ronda de consolidación&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lectura agregada&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1790" y="520" width="460" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-67" value="&lt;b&gt;aporte&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;solo /estadisticas/aportes&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1790" y="650" width="460" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-68" value="&lt;b&gt;funciones estadisticas_sistema_*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;solo agregados de todas las iglesias&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1790" y="780" width="460" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-69" value="&lt;b&gt;actividad_usuario · usuario (iglesia_seguridad)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;una fila por usuario y día&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1790" y="1030" width="460" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-70" value="&lt;b&gt;Regla de aportes&lt;/b&gt;&lt;br&gt;Ningún endpoint de estadísticas, salvo /aportes, devuelve importes ni conteos de aportes (prueba ReglaDeAportesIntegrationTest sobre 6 rutas). El inicio del líder y el del miembro nunca piden aportes." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1790" y="1170" width="460" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="perfiles" name="2. Inicio por perfil y su ámbito"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="perfiles-1" value="&lt;b&gt;Qué ve cada perfil y con qué alcance&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="perfiles-2" value="El inicio sale del rol base del perfil elegido; cada bloque, del permiso de su módulo; el alcance de las cifras, del token (nunca de un parámetro)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="perfiles-3" value="&lt;b&gt;Administrador del sistema&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/sistema&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="120" width="470" height="55" as="geometry" /></mxCell><mxCell id="perfiles-4" value="&lt;b&gt;Administrador de iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/administracion&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="550" y="120" width="470" height="55" as="geometry" /></mxCell><mxCell id="perfiles-5" value="&lt;b&gt;Líder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/mi-red&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1060" y="120" width="470" height="55" as="geometry" /></mxCell><mxCell id="perfiles-6" value="&lt;b&gt;Miembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/mi-perfil&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1570" y="120" width="470" height="55" as="geometry" /></mxCell><mxCell id="perfiles-7" value="&lt;b&gt;Vista global&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tarjetas: iglesias activas, miembros activos,&lt;br&gt;usuarios activos en el mes, iglesias nuevas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="200" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-8" value="&lt;b&gt;Crecimiento (BloqueSistema)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;altas, bajas e iglesias nuevas por intervalo · actividad por módulo&lt;br&gt;iglesias por tamaño · miembros por condición · 10 con más miembros&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="290" width="470" height="85" as="geometry" /></mxCell><mxCell id="perfiles-9" value="&lt;b&gt;Uso del sistema (global)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;activos diarios, semanales y mensuales · iglesias con actividad&lt;br&gt;activos por perfil&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="395" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-10" value="&lt;b&gt;Dentro de una iglesia («Entrar»)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;aviso «Estás viendo el inicio de {iglesia}»&lt;br&gt;+ el mismo inicio de administración · /sistema → 403&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="485" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-11" value="&lt;b&gt;Para hoy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tomar asistencia de hoy · Personas con alerta (N)&lt;br&gt;Rondas en curso (N) · Registrar miembro&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="550" y="200" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-12" value="&lt;b&gt;Tarjetas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembros activos · nuevos · asistentes por culto · con alerta&lt;br&gt;+ total de aportes solo con aportes.ver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="550" y="290" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-13" value="&lt;b&gt;Bloques, en orden&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembros (miembros.ver) · asistencia (asistencia.ver) · grupos (grupos.ver)&lt;br&gt;consolidación (consolidacion.ver | administrar) · aportes (aportes.ver)&lt;br&gt;uso del sistema (usuarios.ver)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="550" y="380" width="470" height="90" as="geometry" /></mxCell><mxCell id="perfiles-14" value="&lt;b&gt;Rol personalizado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;p. ej. «Secretaría» con base ADMIN_IGLESIA y sin aportes.ver:&lt;br&gt;no ve bloque ni tarjeta de aportes y no se hace la petición&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="550" y="490" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-15" value="&lt;b&gt;Para hoy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tomar asistencia de {grupo} (si hoy es su día)&lt;br&gt;Personas de tu red con alerta (N) · Mis asignados (N)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1060" y="200" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-16" value="&lt;b&gt;Tarjetas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;personas en tu red (directas en la ayuda) · nuevos en tu red&lt;br&gt;asistencia de tu red · asistencia a tus grupos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1060" y="290" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-17" value="&lt;b&gt;Bloques&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Mi red (miembros) · Asistencia de mi red · Mis grupos&lt;br&gt;nunca aportes, consolidación de la iglesia ni uso&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1060" y="380" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-18" value="&lt;b&gt;Mi código de asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;QR grande (el del fotocheck) · Pantalla completa · Descargar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1570" y="200" width="470" height="60" as="geometry" /></mxCell><mxCell id="perfiles-19" value="&lt;b&gt;Mi asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;% de 8 semanas con tendencia · faltas seguidas · última vez&lt;br&gt;12 semanas · últimas reuniones (paginadas)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1570" y="280" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-20" value="&lt;b&gt;Mis datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;líder · grupo con día y hora · nivel · condición · ingreso · edad&lt;br&gt;solo lectura: «Pídeselo a tu líder»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1570" y="370" width="470" height="70" as="geometry" /></mxCell><mxCell id="perfiles-21" value="Alcance que decide el backend (ResolutorAlcanceEstadisticas, por rol base del token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="620" width="2000" height="300" as="geometry" /></mxCell><mxCell id="perfiles-22" value="&lt;b&gt;ADMIN_IGLESIA o ADMIN_SISTEMA dentro de una iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AlcanceEstadisticas.iglesia(): toda la iglesia de app.iglesia_id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="670" width="600" height="70" as="geometry" /></mxCell><mxCell id="perfiles-23" value="&lt;b&gt;LIDER con miembro_id&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AlcanceEstadisticas.redDe(miembroId): CTE recursiva sobre lider_id,&lt;br&gt;filtrando iglesia_id en cada paso y sin contarlo a él&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="720" y="670" width="600" height="70" as="geometry" /></mxCell><mxCell id="perfiles-24" value="&lt;b&gt;Otro rol o vista global&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;403 en los endpoints de módulo&lt;br&gt;consolidación y aportes exigen iglesia completa (líder → 403)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1370" y="670" width="640" height="70" as="geometry" /></mxCell><mxCell id="perfiles-25" value="&lt;b&gt;Mi perfil&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cualquier usuario autenticado: solo el miembro de su claim miembro_id&lt;br&gt;sin vínculo → 404 «Tu usuario no está vinculado a un miembro de la iglesia»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="780" width="940" height="70" as="geometry" /></mxCell><mxCell id="perfiles-26" value="&lt;b&gt;Estadísticas del sistema&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;estadisticas.sistema y vista global (sin iglesia en el token)&lt;br&gt;dentro de una iglesia → 403&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1060" y="780" width="950" height="70" as="geometry" /></mxCell><mxCell id="perfiles-27" value="Periodo (CalculadoraPeriodo, reloj del servidor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="950" width="2000" height="300" as="geometry" /></mxCell><mxCell id="perfiles-28" value="&lt;b&gt;MES&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;del 1 del mes a hoy · serie por semana&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="1000" width="450" height="60" as="geometry" /></mxCell><mxCell id="perfiles-29" value="&lt;b&gt;TRIMESTRE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;13 semanas desde el lunes · por semana&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="560" y="1000" width="450" height="60" as="geometry" /></mxCell><mxCell id="perfiles-30" value="&lt;b&gt;ANIO_MOVIL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;12 meses · por mes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1050" y="1000" width="450" height="60" as="geometry" /></mxCell><mxCell id="perfiles-31" value="&lt;b&gt;ANIO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;del 1 de enero a hoy · por mes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1540" y="1000" width="470" height="60" as="geometry" /></mxCell><mxCell id="perfiles-32" value="&lt;b&gt;Comparación justa&lt;/b&gt;&lt;br&gt;El periodo anterior tiene la misma duración y termina el día antes de «desde». Sin datos en el anterior (0 o nulo) la tarjeta dice «Sin datos para comparar», nunca «+100 %». La variación es verde si mejora y roja si empeora (las bajas invierten el color)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="70" y="1090" width="940" height="120" as="geometry" /></mxCell><mxCell id="perfiles-33" value="&lt;b&gt;Recordado en el navegador&lt;/b&gt;&lt;br&gt;periodoRecordado() guarda el periodo en localStorage (clave inicio.periodo) con try/catch: es una comodidad; sin almacenamiento empieza en «Este mes». Las series se completan con ceros (Series.rellenar) para que el eje no salte intervalos." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1060" y="1090" width="950" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="actividad" name="3. Registro de actividad (uso del sistema)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actividad-1" value="&lt;b&gt;Registro de actividad en iglesia-seguridad&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="actividad-2" value="Una fila por usuario y día al iniciar sesión o renovar el token: mide quién usa el sistema sin guardar navegación, IP ni acciones." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="actividad-3" value="&lt;b&gt;1. POST /api/auth/login · /api/auth/refresh&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AuthService.iniciarSesion / refrescar emite el token&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="140" width="380" height="70" as="geometry" /></mxCell><mxCell id="actividad-4" value="&lt;b&gt;2. RegistroActividadService.registrar(usuario)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;TransactionTemplate REQUIRES_NEW (transacción propia)&lt;br&gt;rol principal = el rol base activo de mayor jerarquía&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="480" y="140" width="420" height="80" as="geometry" /></mxCell><mxCell id="actividad-5" value="&lt;b&gt;3. INSERT … ON CONFLICT (usuario_id, fecha) DO NOTHING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;la segunda entrada del día no hace nada&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="960" y="140" width="420" height="70" as="geometry" /></mxCell><mxCell id="actividad-6" value="&lt;b&gt;actividad_usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PK (usuario_id, fecha) · iglesia_id? · rol_base&lt;br&gt;índice (fecha, iglesia_id) · FK usuario ON DELETE CASCADE&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1440" y="130" width="420" height="100" as="geometry" /></mxCell><mxCell id="actividad-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="actividad-3" target="actividad-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="actividad-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="actividad-4" target="actividad-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="actividad-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="actividad-5" target="actividad-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="actividad-10" value="&lt;b&gt;Si el registro falla&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DataAccessException | TransactionException se capturan fuera de la transacción:&lt;br&gt;WARN en el log y el usuario entra igual&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="480" y="270" width="420" height="80" as="geometry" /></mxCell><mxCell id="actividad-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="actividad-4" target="actividad-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="actividad-12" value="&lt;b&gt;¿Por qué TransactionTemplate y no @Transactional(REQUIRES_NEW)?&lt;/b&gt;&lt;br&gt;Con la anotación, una falla marca la transacción como rollback-only y el commit lanza igual la excepción hacia el login. Con la plantilla, la excepción se atrapa afuera y no toca el inicio de sesión." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="960" y="260" width="420" height="130" as="geometry" /></mxCell><mxCell id="actividad-13" value="&lt;b&gt;4. LimpiezaActividad (@Scheduled, 03:30 diario)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;borra filas de más de seguridad.actividad.meses-retencion (25 por defecto)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="440" width="420" height="80" as="geometry" /></mxCell><mxCell id="actividad-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="actividad-13" target="actividad-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="480" /></Array></mxGeometry></mxCell><mxCell id="actividad-15" value="Consulta: GET /api/estadisticas/uso?periodo=" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="580" width="1820" height="520" as="geometry" /></mxCell><mxCell id="actividad-16" value="&lt;b&gt;EstadisticasUsoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;vista global (sin iglesia): exige estadisticas.sistema → todas las iglesias&lt;br&gt;dentro de una iglesia: exige usuarios.ver → solo la del token&lt;br&gt;otro caso → 403&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="630" width="520" height="100" as="geometry" /></mxCell><mxCell id="actividad-17" value="&lt;b&gt;ActividadUsuarioRepository (consultas nativas)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;usuariosActivos · diasUsuario (para el promedio diario) · iglesiasActivas&lt;br&gt;serie(date_trunc week | month) · porRolBase · usuariosHabilitados · usuariosCreados&lt;br&gt;(CAST(:iglesiaId AS bigint) IS NULL OR iglesia_id = :iglesiaId)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="640" y="630" width="620" height="100" as="geometry" /></mxCell><mxCell id="actividad-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="actividad-16" target="actividad-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="actividad-19" value="&lt;b&gt;EstadisticasUsoResponse&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;usuarios · usuariosNuevos · activosPeriodo (+ anterior)&lt;br&gt;activosDiarios (+ anterior) · activosSemanales (7 días) · activosMensuales (30 días)&lt;br&gt;iglesiasActivas (+ anterior, solo global) · serie (con ceros) · porRolBase&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1310" y="630" width="520" height="100" as="geometry" /></mxCell><mxCell id="actividad-20" value="&lt;b&gt;Qué no se guarda&lt;/b&gt;&lt;br&gt;Ni IP, ni navegador, ni páginas, ni clics: solo «este usuario usó el sistema este día, con este perfil y en esta iglesia». La actividad se cuenta desde que se desplegó esta spec, así que al principio el periodo anterior sale vacío («Sin datos para comparar»)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="70" y="780" width="560" height="140" as="geometry" /></mxCell><mxCell id="actividad-21" value="&lt;b&gt;Dentro de una iglesia no se cuenta al administrador del sistema&lt;/b&gt;&lt;br&gt;porRolBase excluye ADMIN_SISTEMA cuando la consulta es de una iglesia, y las iglesias con actividad ignoran las filas sin iglesia_id." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="680" y="780" width="560" height="140" as="geometry" /></mxCell><mxCell id="actividad-22" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1310" y="780" width="230" height="190" as="geometry" /></mxCell><mxCell id="actividad-23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1322" y="814" width="28" height="20" as="geometry" /></mxCell><mxCell id="actividad-24" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="810" width="175" height="28" as="geometry" /></mxCell><mxCell id="actividad-25" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1322" y="844" width="28" height="20" as="geometry" /></mxCell><mxCell id="actividad-26" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="840" width="175" height="28" as="geometry" /></mxCell><mxCell id="actividad-27" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1322" y="874" width="28" height="20" as="geometry" /></mxCell><mxCell id="actividad-28" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="870" width="175" height="28" as="geometry" /></mxCell><mxCell id="actividad-29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1322" y="904" width="28" height="20" as="geometry" /></mxCell><mxCell id="actividad-30" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="900" width="175" height="28" as="geometry" /></mxCell><mxCell id="actividad-31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1322" y="934" width="28" height="20" as="geometry" /></mxCell><mxCell id="actividad-32" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="930" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="funciones" name="4. Funciones entre iglesias y la RLS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="funciones-1" value="&lt;b&gt;Estadísticas entre iglesias sin abrir la RLS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="funciones-2" value="En la vista global no hay app.iglesia_id y la RLS no deja leer filas de negocio. En vez de un rol con BYPASSRLS, Flyway crea funciones que solo devuelven agregados." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="funciones-3" value="&lt;b&gt;1. PanoramaSistema pide GET /api/estadisticas/sistema&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;token del administrador del sistema sin iglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="140" width="400" height="70" as="geometry" /></mxCell><mxCell id="funciones-4" value="&lt;b&gt;2. EstadisticasSistemaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;exige estadisticas.sistema · si IglesiaActual tiene id → 403&lt;br&gt;CalculadoraPeriodo → rango y periodo anterior&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="140" width="420" height="80" as="geometry" /></mxCell><mxCell id="funciones-5" value="&lt;b&gt;3. EstadisticasSistemaRepository&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SELECT * FROM estadisticas_sistema_resumen(:desde, …)&lt;br&gt;serie · condiciones · tamanos · mayores(10)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="980" y="140" width="420" height="80" as="geometry" /></mxCell><mxCell id="funciones-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="funciones-3" target="funciones-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="funciones-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="funciones-4" target="funciones-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="funciones-8" value="PostgreSQL · iglesia_negocio (V12__estadisticas_del_sistema.sql)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="280" width="1820" height="470" as="geometry" /></mxCell><mxCell id="funciones-9" value="&lt;b&gt;Funciones estadisticas_sistema_*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;LANGUAGE sql STABLE SECURITY DEFINER&lt;br&gt;SET search_path = public · dueño: el rol propietario de las tablas&lt;br&gt;REVOKE … FROM PUBLIC · GRANT EXECUTE TO ${rol_aplicacion}&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="80" y="330" width="560" height="100" as="geometry" /></mxCell><mxCell id="funciones-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="funciones-5" target="funciones-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="380" /></Array></mxGeometry></mxCell><mxCell id="funciones-11" value="&lt;b&gt;resumen(desde, hasta, anterior_desde, anterior_hasta)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesias · nuevas · con_actividad · miembros · altas · bajas (+ anteriores)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="80" y="460" width="560" height="60" as="geometry" /></mxCell><mxCell id="funciones-12" value="&lt;b&gt;serie(desde, hasta, unidad)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesias nuevas · altas · bajas · miembros registrados&lt;br&gt;asistencias marcadas · contactos de consolidación&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="80" y="540" width="560" height="65" as="geometry" /></mxCell><mxCell id="funciones-13" value="&lt;b&gt;condiciones() · tamanos() · mayores(limite)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembros por condición · iglesias por tamaño (SIN_MIEMBROS…MAS_DE_1000)&lt;br&gt;nombre de la iglesia y su conteo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="80" y="625" width="560" height="65" as="geometry" /></mxCell><mxCell id="funciones-14" value="&lt;b&gt;iglesia · miembro · reunion · asistencia · contacto_consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;con RLS: USING (iglesia_id = app.iglesia_id)&lt;br&gt;sin FORCE: el dueño la salta dentro de la función&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="720" y="340" width="520" height="110" as="geometry" /></mxCell><mxCell id="funciones-15" value="dueño: lee todas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="funciones-9" target="funciones-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="funciones-16" value="&lt;b&gt;Rol de la aplicación, fuera de las funciones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SELECT directo sin app.iglesia_id → 0 filas (RLS)&lt;br&gt;no puede crear ni cambiar las funciones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="720" y="500" width="520" height="80" as="geometry" /></mxCell><mxCell id="funciones-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="funciones-16" target="funciones-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="funciones-18" value="&lt;b&gt;Índices nuevos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ix_miembro_iglesia_ingreso (iglesia_id, fecha_ingreso)&lt;br&gt;ix_reunion_iglesia_tipo_fecha (iglesia_id, tipo, fecha)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="720" y="620" width="520" height="70" as="geometry" /></mxCell><mxCell id="funciones-19" value="&lt;b&gt;Solo agregados&lt;/b&gt;&lt;br&gt;Las funciones devuelven conteos por mes, por iglesia o por condición. Nunca nombres, correos, teléfonos ni identificadores de miembros, ni aportes. Las iglesias sí se nombran: son el catálogo de tenants." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1300" y="330" width="520" height="130" as="geometry" /></mxCell><mxCell id="funciones-20" value="&lt;b&gt;Pruebas&lt;/b&gt;&lt;br&gt;EstadisticasSistemaIntegrationTest: solo en la vista global; dentro de una iglesia 403; prosecdef = true; PUBLIC sin EXECUTE; la respuesta no trae datos de personas; el rol de la aplicación sigue sin leer tablas de otra iglesia fuera de las funciones." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1300" y="490" width="520" height="150" as="geometry" /></mxCell><mxCell id="funciones-21" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1300" y="800" width="230" height="190" as="geometry" /></mxCell><mxCell id="funciones-22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1312" y="834" width="28" height="20" as="geometry" /></mxCell><mxCell id="funciones-23" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1348" y="830" width="175" height="28" as="geometry" /></mxCell><mxCell id="funciones-24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1312" y="864" width="28" height="20" as="geometry" /></mxCell><mxCell id="funciones-25" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1348" y="860" width="175" height="28" as="geometry" /></mxCell><mxCell id="funciones-26" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1312" y="894" width="28" height="20" as="geometry" /></mxCell><mxCell id="funciones-27" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1348" y="890" width="175" height="28" as="geometry" /></mxCell><mxCell id="funciones-28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1312" y="924" width="28" height="20" as="geometry" /></mxCell><mxCell id="funciones-29" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1348" y="920" width="175" height="28" as="geometry" /></mxCell><mxCell id="funciones-30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1312" y="954" width="28" height="20" as="geometry" /></mxCell><mxCell id="funciones-31" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1348" y="950" width="175" height="28" as="geometry" /></mxCell><mxCell id="funciones-32" value="&lt;b&gt;¿Por qué no un rol con BYPASSRLS?&lt;/b&gt;&lt;br&gt;Un rol así podría leer cualquier fila con cualquier consulta. Las funciones limitan exactamente qué se puede calcular entre iglesias, y la segunda barrera (RLS) sigue intacta para todo lo demás." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="40" y="800" width="600" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
