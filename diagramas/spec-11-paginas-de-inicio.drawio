<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arquitectura" name="1. Arquitectura de las páginas de inicio"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arquitectura-1" value="&lt;b&gt;Arquitectura: páginas de inicio por perfil&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-2" value="Contenedores y bloques del frontend, servicios REST que consumen, clases de los dos backends que los atienden y tablas o funciones que leen." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-3" value="iglesia-web · features/inicio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="840" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-4" value="Contrato HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="900" y="110" width="380" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-5" value="iglesia-api y iglesia-seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1310" y="110" width="960" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;Rutas (hijas de AppLayout, rolBaseGuard)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/sistema (ADMIN_SISTEMA) · /administracion (ADMIN_IGLESIA)&lt;br&gt;/mi-red (LIDER) · /mi-perfil (MIEMBRO) · el inicio sale del perfil elegido&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="800" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-7" value="&lt;b&gt;InicioSistemaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;vista global → PanoramaSistema&lt;br&gt;dentro de una iglesia → aviso + InicioAdministracion&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="240" width="390" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-8" value="&lt;b&gt;InicioAdministracionComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;atajos · tarjetas · 6 bloques, cada uno con su permiso&lt;br&gt;(sin permiso no se crea ni se pide)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="460" y="240" width="390" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-9" value="&lt;b&gt;InicioLiderComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Mi red»: atajos (grupo de hoy, alertas, mis asignados)&lt;br&gt;tarjetas de su red · bloques red / asistencia / grupos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="335" width="390" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-10" value="&lt;b&gt;InicioMiembroComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MiCodigoQr · MiAsistencia · MisDatos&lt;br&gt;sin vínculo (404) → mensaje claro&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="460" y="335" width="390" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;Encabezado y periodo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;BienvenidaPerfil (compacto, proyecta el selector)&lt;br&gt;SelectorPeriodo · periodoRecordado() en localStorage&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="430" width="390" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-12" value="&lt;b&gt;PanoramaSistemaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tarjetas · BloqueSistema (crecimiento, tamaños,&lt;br&gt;iglesias con más miembros) · BloqueUso global&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="460" y="430" width="390" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-13" value="&lt;b&gt;Bloques (presentacionales)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;BloqueMiembros · BloqueGrupos · BloqueAsistencia · BloqueConsolidacion&lt;br&gt;BloqueAportes · BloqueUso · BloqueSistema → todos dentro de BloqueEstadistico&lt;br&gt;(título, «Ver más», esqueleto, error con «Reintentar»)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="525" width="800" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-14" value="&lt;b&gt;Piezas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;TarjetaIndicador (cifra, ayuda, variación o «Sin datos para comparar»)&lt;br&gt;AtajosDelDia · shared/GraficoDistribucion · shared/GraficoEvolucion&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="625" width="800" height="65" as="geometry" /></mxCell><mxCell id="arquitectura-15" value="&lt;b&gt;cargaReactiva(parametro, pedir, activa)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;una carga por bloque: pide al cambiar el periodo, cancela la anterior,&lt;br&gt;no pide si no hay permiso · datos / cargando / error / recargar()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="710" width="800" height="65" as="geometry" /></mxCell><mxCell id="arquitectura-16" value="&lt;b&gt;EstadisticasService (fachada HTTP)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembros · grupos · asistencia · consolidacion · aportes · sistema(periodo)&lt;br&gt;uso(periodo) → iglesia-seguridad · miPerfil · miAsistencia · miCodigoAsistencia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="795" width="800" height="65" as="geometry" /></mxCell><mxCell id="arquitectura-17" value="&lt;b&gt;Cada bloque es independiente&lt;/b&gt;&lt;br&gt;Se cargan en paralelo; si uno falla, muestra su error con «Reintentar» y los demás siguen. Los de abajo se dibujan con @defer (on viewport)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="890" width="390" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-18" value="&lt;b&gt;Esconder no es la única barrera&lt;/b&gt;&lt;br&gt;El bloque aparece solo con el permiso del módulo, pero el backend exige el mismo permiso en el endpoint y decide el alcance con el token." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="460" y="890" width="390" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-19" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="50" y="1030" width="230" height="250" as="geometry" /></mxCell><mxCell id="arquitectura-20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="62" y="1064" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-21" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1060" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1" ><mxGeometry x="62" y="1094" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-23" value="Rutas y guards" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1090" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="62" y="1124" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-25" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1120" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-26" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="62" y="1154" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-27" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1150" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="62" y="1184" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-29" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1180" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="62" y="1214" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-31" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1210" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="62" y="1244" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-33" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1240" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-34" value="&lt;b&gt;GET /api/estadisticas/miembros&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembros.ver · iglesia o red&lt;br&gt;?periodo=MES | TRIMESTRE | ANIO_MOVIL | ANIO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="915" y="150" width="350" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-35" value="&lt;b&gt;GET /api/estadisticas/grupos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;grupos.ver | asistencia.grupo&lt;br&gt;?periodo=MES | TRIMESTRE | ANIO_MOVIL | ANIO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="915" y="275" width="350" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-36" value="&lt;b&gt;GET /api/estadisticas/asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;asistencia.ver | asistencia.grupo&lt;br&gt;?periodo=MES | TRIMESTRE | ANIO_MOVIL | ANIO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="915" y="400" width="350" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-37" value="&lt;b&gt;GET /api/estadisticas/consolidacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;consolidacion.ver | administrar · solo iglesia&lt;br&gt;?periodo=MES | TRIMESTRE | ANIO_MOVIL | ANIO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="915" y="525" width="350" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-38" value="&lt;b&gt;GET /api/estadisticas/aportes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;aportes.ver · solo iglesia · único con aportes&lt;br&gt;?periodo=MES | TRIMESTRE | ANIO_MOVIL | ANIO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="915" y="650" width="350" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-39" value="&lt;b&gt;GET /api/estadisticas/sistema&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;estadisticas.sistema · solo vista global&lt;br&gt;?periodo=MES | TRIMESTRE | ANIO_MOVIL | ANIO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="915" y="775" width="350" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-40" value="&lt;b&gt;GET /api/mi-perfil · /asistencia · /codigo-asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;autenticado · miembro del claim miembro_id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="915" y="900" width="350" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-41" value="&lt;b&gt;GET /api/estadisticas/uso (iglesia-seguridad)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;global: estadisticas.sistema · iglesia: usuarios.ver&lt;br&gt;?periodo=MES | TRIMESTRE | ANIO_MOVIL | ANIO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="915" y="1025" width="350" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-16" target="arquitectura-34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-43" value="&lt;b&gt;EstadisticasMiembrosController → Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;EstadisticasMiembrosRepository (resumen, serie,&lt;br&gt;condición, género, nivel, edad) · Mapper de etiquetas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1330" y="150" width="430" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-44" value="&lt;b&gt;EstadisticasGruposController → Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;grupos del alcance, asistencia esperada vs. asistida&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1330" y="275" width="430" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-45" value="&lt;b&gt;EstadisticasAsistenciaController → Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;serie de cultos, personas, retorno de nuevos&lt;br&gt;alertas: SeguimientoAsistenciaService.conteos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1330" y="400" width="430" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-46" value="&lt;b&gt;EstadisticasConsolidacionController → Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;rondas, casos, contactos por medio, cierres&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1330" y="525" width="430" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-47" value="&lt;b&gt;EstadisticasAportesController → Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reutiliza ResumenAportesService + serie por periodo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1330" y="650" width="430" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-48" value="&lt;b&gt;EstadisticasSistemaController → Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;EstadisticasSistemaRepository llama a las funciones&lt;br&gt;estadisticas_sistema_* (SECURITY DEFINER)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1330" y="775" width="430" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-49" value="&lt;b&gt;MiPerfilController → MiPerfilService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MiembroService.propio · AsistenciaMiembroService.codigoPropio&lt;br&gt;SeguimientoAsistenciaService.delPropio&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1330" y="900" width="430" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-50" value="&lt;b&gt;EstadisticasUsoController → EstadisticasUsoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ActividadUsuarioRepository (iglesia-seguridad)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1330" y="1025" width="430" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-34" target="arquitectura-43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-35" target="arquitectura-44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-36" target="arquitectura-45"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-3