<mxfile host="app.diagrams.net"><diagram id="antes" name="1. Antes (token en el cuerpo JSON)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c28" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="164" as="sourcePoint"/><mxPoint x="150" y="1232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="164" as="sourcePoint"/><mxPoint x="440" y="1232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="164" as="sourcePoint"/><mxPoint x="730" y="1232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="164" as="sourcePoint"/><mxPoint x="1020" y="1232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="164" as="sourcePoint"/><mxPoint x="1310" y="1232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;ANTES: el token de refresco viajaba en el cuerpo JSON&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Contrato anterior de iglesia-seguridad. El frontend tendría que guardar el token de refresco donde JavaScript pueda leerlo (localStorage) para sobrevivir a un F5." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c5" value="Angular&lt;br&gt;(código JavaScript)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c6" value="localStorage&lt;br&gt;&lt;span style='font-weight:normal'&gt;legible por cualquier script&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c7" value="iglesia-seguridad&lt;br&gt;/api/auth/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c8" value="PostgreSQL&lt;br&gt;tabla token_refresco" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c9" value="Script malicioso&lt;br&gt;(XSS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;① Iniciar sesión&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c11" value="POST /api/auth/login&lt;br&gt;{ correo, contrasena }" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="282" as="sourcePoint"/><mxPoint x="730" y="282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Guarda el &lt;b&gt;hash SHA-256&lt;/b&gt; del token&lt;br&gt;(nunca el valor en claro)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="895.0" y="316" width="250" height="44" as="geometry"/></mxCell><mxCell id="c13" value="200 { tokenAcceso, tipo, expiraEn,&lt;br&gt;&lt;b&gt;&lt;font color='#b85450'&gt;tokenRefresco&lt;/font&gt;&lt;/b&gt; }" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="412" as="sourcePoint"/><mxPoint x="150" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="guarda tokenRefresco (7 días)" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="462" as="sourcePoint"/><mxPoint x="440" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;② El token de acceso (15 min) vence → refrescar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="496" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c16" value="lee tokenRefresco" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="562" as="sourcePoint"/><mxPoint x="150" y="562" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value='POST /api/auth/refresh&lt;br&gt;{ "tokenRefresco": "abc…" }  ← en el cuerpo' style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="628" as="sourcePoint"/><mxPoint x="730" y="628" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="Rotación: revoca el usado&lt;br&gt;y emite uno nuevo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="895.0" y="662" width="250" height="44" as="geometry"/></mxCell><mxCell id="c19" value="200 { tokenAcceso, …, &lt;b&gt;tokenRefresco nuevo&lt;/b&gt; }" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="742" as="sourcePoint"/><mxPoint x="150" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="sobrescribe tokenRefresco" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="792" as="sourcePoint"/><mxPoint x="440" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;③ El riesgo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="826" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c22" value="localStorage.getItem(…)" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="892" as="sourcePoint"/><mxPoint x="440" y="892" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;⚠ Un solo XSS roba el token de refresco.&lt;/b&gt;&lt;br&gt;El atacante puede pedir tokens de acceso nuevos desde su máquina durante &lt;b&gt;7 días&lt;/b&gt;,&lt;br&gt;aunque el usuario cierre la pestaña. JavaScript no tiene forma de protegerlo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="926" width="1090" height="76" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;④ Cerrar sesión&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="1022" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c25" value="POST /api/auth/logout  { tokenRefresco }" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1088" as="sourcePoint"/><mxPoint x="730" y="1088" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="204" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1138" as="sourcePoint"/><mxPoint x="150" y="1138" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="el frontend debe acordarse de borrarlo" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1188" as="sourcePoint"/><mxPoint x="440" y="1188" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="ahora" name="2. Ahora (cookie HttpOnly)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c36" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="164" as="sourcePoint"/><mxPoint x="150" y="1766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="164" as="sourcePoint"/><mxPoint x="440" y="1766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="164" as="sourcePoint"/><mxPoint x="730" y="1766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="164" as="sourcePoint"/><mxPoint x="1020" y="1766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="164" as="sourcePoint"/><mxPoint x="1310" y="1766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;AHORA: el token de refresco viaja en una cookie HttpOnly&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Spec 01, pasos 1 a 4 (backend). El token de acceso vive solo en memoria (signal); el de refresco lo guarda y lo envía el propio navegador, y JavaScript no puede leerlo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c5" value="Angular&lt;br&gt;&lt;span style='font-weight:normal'&gt;tokenAcceso en memoria (signal)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c6" value="Navegador&lt;br&gt;&lt;span style='font-weight:normal'&gt;almacén de cookies&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c7" value="iglesia-seguridad&lt;br&gt;/api/auth/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c8" value="PostgreSQL&lt;br&gt;tabla token_refresco" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c9" value="Script malicioso&lt;br&gt;(XSS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;① Iniciar sesión&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c11" value="POST /api/auth/login { correo, contrasena }&lt;br&gt;withCredentials: true" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="282" as="sourcePoint"/><mxPoint x="440" y="282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="POST /api/auth/login" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="332" as="sourcePoint"/><mxPoint x="730" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="Guarda el &lt;b&gt;hash SHA-256&lt;/b&gt; del token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="895.0" y="366" width="250" height="34" as="geometry"/></mxCell><mxCell id="c14" value="200 { tokenAcceso, tipo, expiraEn }&lt;br&gt;&lt;b&gt;Set-Cookie: iglesia_refresco=…&lt;/b&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="452" as="sourcePoint"/><mxPoint x="440" y="452" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;Cookie iglesia_refresco&lt;/b&gt;&lt;br&gt;• &lt;b&gt;HttpOnly&lt;/b&gt;: JavaScript no la ve&lt;br&gt;• &lt;b&gt;Secure&lt;/b&gt;: solo por HTTPS (y localhost)&lt;br&gt;• &lt;b&gt;SameSite=Strict&lt;/b&gt;: no viaja desde otros sitios&lt;br&gt;• &lt;b&gt;Path=/api/auth&lt;/b&gt;: solo a login/refresh/logout&lt;br&gt;• &lt;b&gt;Max-Age=604800&lt;/b&gt; (7 días)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="290.0" y="486" width="300" height="118" as="geometry"/></mxCell><mxCell id="c16" value="{ tokenAcceso, tipo, expiraEn }  (sin token de refresco)" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="640" as="sourcePoint"/><mxPoint x="150" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;② El token de acceso (15 min) vence → refrescar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="674" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c18" value="POST /api/auth/refresh  (sin cuerpo)&lt;br&gt;withCredentials: true" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="756" as="sourcePoint"/><mxPoint x="440" y="756" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="POST /api/auth/refresh&lt;br&gt;&lt;b&gt;Cookie: iglesia_refresco=…&lt;/b&gt;  ← la adjunta el navegador" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="822" as="sourcePoint"/><mxPoint x="730" y="822" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="@CookieValue lee la cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="620.0" y="856" width="220" height="30" as="geometry"/></mxCell><mxCell id="c21" value="Rotación: revoca el usado&lt;br&gt;y emite uno nuevo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="895.0" y="906" width="250" height="44" as="geometry"/></mxCell><mxCell id="c22" value="200 { tokenAcceso, … }&lt;br&gt;Set-Cookie: iglesia_refresco=&lt;b&gt;valor nuevo&lt;/b&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1002" as="sourcePoint"/><mxPoint x="440" y="1002" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="{ tokenAcceso nuevo }" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1052" as="sourcePoint"/><mxPoint x="150" y="1052" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;③ Si algo falla en /refresh&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="1086" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Sin cookie&lt;/b&gt;, o token &lt;b&gt;inexistente / vencido / revocado&lt;/b&gt; → &lt;b&gt;401&lt;/b&gt; + Set-Cookie con &lt;b&gt;Max-Age=0&lt;/b&gt; (el navegador la borra).&lt;br&gt;&lt;b&gt;Token ya rotado reutilizado&lt;/b&gt; → se asume robo: se revocan &lt;b&gt;todas&lt;/b&gt; las sesiones del usuario y responde 401.&lt;br&gt;&lt;i&gt;Lo maneja ManejadorErroresAuth (solo para AuthController).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="1136" width="800" height="66" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;④ El mismo ataque XSS de antes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="1222" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c27" value="document.cookie" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="1288" as="sourcePoint"/><mxPoint x="440" y="1288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value='""  (la cookie HttpOnly no aparece)' style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1338" as="sourcePoint"/><mxPoint x="1310" y="1338" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;✔ El token de 7 días no se puede robar con JavaScript.&lt;/b&gt;&lt;br&gt;Un XSS solo alcanza el token de acceso en memoria, que vence en 15 minutos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="1372" width="1090" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;⑤ Cerrar sesión&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="1442" width="1380" height="30" as="geometry"/></mxCell><mxCell id="c31" value="POST /api/auth/logout  (sin cuerpo)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1508" as="sourcePoint"/><mxPoint x="440" y="1508" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="POST /api/auth/logout  + Cookie" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1558" as="sourcePoint"/><mxPoint x="730" y="1558" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="Revoca el token (si llegó)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="895.0" y="1592" width="250" height="30" as="geometry"/></mxCell><mxCell id="c34" value="204 + Set-Cookie: iglesia_refresco=; &lt;b&gt;Max-Age=0&lt;/b&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1658" as="sourcePoint"/><mxPoint x="440" y="1658" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="El navegador borra la cookie&lt;br&gt;(siempre, haya llegado o no)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="310.0" y="1692" width="260" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="comparativa" name="3. Comparativa"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Resumen: antes vs. ahora&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="330" height="44" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Antes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="70" width="380" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Ahora&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="70" width="380" height="44" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Dónde va el token de refresco&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="330" height="44" as="geometry"/></mxCell><mxCell id="c8" value="En el cuerpo JSON de la respuesta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="114" width="380" height="44" as="geometry"/></mxCell><mxCell id="c9" value="En la cabecera &lt;b&gt;Set-Cookie&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="114" width="380" height="44" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Dónde lo guarda el frontend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="330" height="44" as="geometry"/></mxCell><mxCell id="c11" value="localStorage (lo hace el código JS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="158" width="380" height="44" as="geometry"/></mxCell><mxCell id="c12" value="Lo guarda el navegador; el JS ni lo ve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="158" width="380" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Cómo se envía en /refresh y /logout&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="330" height="44" as="geometry"/></mxCell><mxCell id="c14" value='{ "tokenRefresco": "…" } en el cuerpo' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="202" width="380" height="44" as="geometry"/></mxCell><mxCell id="c15" value="El navegador adjunta la cookie solo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="202" width="380" height="44" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;¿Lo puede leer un XSS?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="330" height="44" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Sí&lt;/b&gt; → robo por 7 días" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="246" width="380" height="44" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;No&lt;/b&gt; (HttpOnly)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="246" width="380" height="44" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;¿Viaja en cada petición?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="330" height="44" as="geometry"/></mxCell><mxCell id="c20" value="Solo si el JS lo manda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="290" width="380" height="44" as="geometry"/></mxCell><mxCell id="c21" value="Solo a /api/auth (Path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="290" width="380" height="44" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Petición desde otro sitio (CSRF)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="330" height="44" as="geometry"/></mxCell><mxCell id="c23" value="No aplica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="334" width="380" height="44" as="geometry"/></mxCell><mxCell id="c24" value="Bloqueada por SameSite=Strict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="334" width="380" height="44" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Token inválido en /refresh&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="330" height="44" as="geometry"/></mxCell><mxCell id="c26" value="401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="378" width="380" height="44" as="geometry"/></mxCell><mxCell id="c27" value="401 + borra la cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="378" width="380" height="44" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Logout&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="330" height="44" as="geometry"/></mxCell><mxCell id="c29" value="204; el JS debe borrar su copia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="422" width="380" height="44" as="geometry"/></mxCell><mxCell id="c30" value="204 + el servidor borra la cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="422" width="380" height="44" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;CORS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="330" height="44" as="geometry"/></mxCell><mxCell id="c32" value="Sin credenciales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="466" width="380" height="44" as="geometry"/></mxCell><mxCell id="c33" value="allowCredentials=true (orígenes explícitos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="466" width="380" height="44" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Rotación y detección de reutilización&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="330" height="44" as="geometry"/></mxCell><mxCell id="c35" value="Sí" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="510" width="380" height="44" as="geometry"/></mxCell><mxCell id="c36" value="Sí (sin cambios)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="750" y="510" width="380" height="44" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Pendiente (pasos 5 a 16, frontend):&lt;/b&gt; AuthApiService con &lt;i&gt;withCredentials&lt;/i&gt;, SesionService con un único refresco compartido entre peticiones simultáneas, interceptor que reintenta ante 401 y refresco silencioso al recargar (F5)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="574" width="1090" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>