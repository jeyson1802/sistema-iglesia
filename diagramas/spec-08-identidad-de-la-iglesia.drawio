<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arquitectura" name="1. Arquitectura de la identidad"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arquitectura-1" value="&lt;b&gt;Arquitectura: identidad y apariencia de la iglesia&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-2" value="Componentes del frontend, servicios REST que consumen, clases de iglesia-api e iglesia-seguridad que los atienden y tablas que leen o escriben." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="780" height="1280" as="geometry" /></mxCell><mxCell id="arquitectura-4" value="Contrato HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="840" y="110" width="340" height="1280" as="geometry" /></mxCell><mxCell id="arquitectura-5" value="iglesia-api · paquete iglesia/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1210" y="110" width="910" height="1080" as="geometry" /></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;Rutas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/mi-iglesia → iglesia.personalizar + iglesiaFijadaGuard&lt;br&gt;/iglesias → iglesias.ver · /iglesias/:id → iglesias.administrar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="460" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-7" value="&lt;b&gt;AppMenu · construirMenu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sin demos de Sakai en ningún entorno&lt;br&gt;Administración › Mi iglesia (pi-building)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="530" y="150" width="260" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-8" value="&lt;b&gt;Layout (cambios pedidos en la spec)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AppTopbar: logo + nombre · solo modo oscuro&lt;br&gt;AppFooter: nombre, denominación, dirección, contacto, ©&lt;br&gt;AppFloatingConfigurator: solo modo oscuro&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="250" width="460" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-9" value="&lt;b&gt;LogoIglesiaComponent (shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;logo · monograma · esqueleto&lt;br&gt;neutra (login) · vistaPrevia (editor)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="530" y="250" width="260" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="arquitectura-8" target="arquitectura-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;MiIglesiaComponent (/mi-iglesia)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fuente = MiIglesiaService&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="380" width="360" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-12" value="&lt;b&gt;IglesiaEdicionComponent (/iglesias/:id)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fuente = IglesiasService.fuente(id)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="430" y="380" width="360" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-13" value="&lt;b&gt;EditorIglesiaComponent (shared, contenedor)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tres secciones con guardado propio · aviso sin dirección&lt;br&gt;apariencia en vivo · al salir sin guardar vuelve la anterior&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="180" y="475" width="480" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-11" target="arquitectura-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-12" target="arquitectura-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-16" value="&lt;b&gt;CamposIglesiaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombres · dirección · ubigeo · contacto&lt;br&gt;(también en el alta del catálogo)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="590" width="240" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-17" value="&lt;b&gt;SelectorLogoComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tipo y 1 MB antes de subir&lt;br&gt;vista previa clara y oscura&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="300" y="590" width="240" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-18" value="&lt;b&gt;SelectorAparienciaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;preset · color · superficie&lt;br&gt;tarjeta por tipografía&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="550" y="590" width="240" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-13" target="arquitectura-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-13" target="arquitectura-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-13" target="arquitectura-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-22" value="&lt;b&gt;IglesiasListaComponent (/iglesias)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;filtros en la URL · página del servidor&lt;br&gt;FiltrosIglesias · TablaIglesias · MiniaturaIglesia · alta&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="705" width="480" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-23" value="&lt;b&gt;IdentidadIglesiaService (core)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;identidad · urlLogo · cargando (signals)&lt;br&gt;carga al haber iglesia en la sesión; limpia al salir&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="820" width="400" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-24" value="&lt;b&gt;AparienciaService (core)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;$t().preset().surfacePalette().use()&lt;br&gt;--fuente-marca · Google Fonts · localStorage&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="820" width="320" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-25" value="&lt;b&gt;PreferenciaModoOscuroService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;localStorage o prefers-color-scheme&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="915" width="320" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-26" value="&lt;b&gt;TituloIglesiaStrategy · FaviconIglesiaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Página · Nombre comercial» · logo como favicon&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="915" width="400" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-27" value="aplica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-23" target="arquitectura-24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-23" target="arquitectura-26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-9" target="arquitectura-23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="582" y="800" /><mxPoint x="470" y="800" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-30" value="&lt;b&gt;MiIglesiaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;implementa FuenteIglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="1010" width="360" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-31" value="&lt;b&gt;IglesiasService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar(filtro, página) · fuente(id)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="430" y="1010" width="360" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-23" target="arquitectura-30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="1000" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-22" target="arquitectura-31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="740" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-34" value="&lt;b&gt;Strategy: FuenteIglesia&lt;/b&gt;&lt;br&gt;El editor no sabe si edita «mi iglesia» (del token) o una del catálogo (por id): recibe la fuente. Así «Mi iglesia» y /iglesias/:id comparten los mismos componentes." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="1100" width="360" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-35" value="&lt;b&gt;Sin parpadeo&lt;/b&gt;&lt;br&gt;Al arrancar se aplica la última apariencia guardada en localStorage; al llegar &lt;code&gt;GET /api/mi-iglesia&lt;/code&gt; se confirma. En el login se usa la del sistema sin borrar la recordada." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="430" y="1100" width="360" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-36" value="&lt;b&gt;Tipografía sin CSS propio&lt;/b&gt;&lt;br&gt;La utilidad de Tailwind &lt;code&gt;font-marca&lt;/code&gt; lee la variable &lt;code&gt;--fuente-marca&lt;/code&gt;. Solo se descarga la fuente elegida; el selector carga las cinco para la vista previa." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="1230" width="360" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-37" value="&lt;b&gt;GET /api/mi-iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cualquier usuario de la iglesia del token&lt;br&gt;400 sin iglesia en el token&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="860" y="150" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-38" value="&lt;b&gt;PUT /api/mi-iglesia · /apariencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesia.personalizar · 400 · 409 nombre&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="860" y="300" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-39" value="&lt;b&gt;GET · PUT · DELETE /api/mi-iglesia/logo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GET con ETag (304) · PUT binario&lt;br&gt;400 firma · 413 &gt; 1 MB&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="860" y="450" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-40" value="&lt;b&gt;GET /api/iglesias&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;q · ubigeo (2/4/6) · activa · página&lt;br&gt;iglesias.ver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="860" y=