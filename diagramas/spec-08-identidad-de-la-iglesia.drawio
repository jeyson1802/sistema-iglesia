arga-3" value="Arranque (provideAppInitializer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="520" height="420" as="geometry" /></mxCell><mxCell id="carga-4" value="&lt;b&gt;1. Modo oscuro de la persona&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;localStorage «apariencia.modoOscuro»&lt;br&gt;o prefers-color-scheme&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="160" width="460" height="70" as="geometry" /></mxCell><mxCell id="carga-5" value="&lt;b&gt;2. Última apariencia recordada&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;localStorage «apariencia.iglesia»&lt;br&gt;o la del sistema (Aura · emerald · Playfair)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="260" width="460" height="70" as="geometry" /></mxCell><mxCell id="carga-6" value="&lt;b&gt;3. Restaurar la sesión&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cookie de refresco → token con iglesia_id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="360" width="460" height="70" as="geometry" /></mxCell><mxCell id="carga-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="carga-4" target="carga-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="carga-5" target="carga-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-9" value="El usuario ve su tema desde el primer pintado aunque el backend tarde." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="60" y="450" width="460" height="55" as="geometry" /></mxCell><mxCell id="carga-10" value="IdentidadIglesiaService (effect sobre usuarioActual().iglesiaId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="590" y="110" width="600" height="620" as="geometry" /></mxCell><mxCell id="carga-11" value="&lt;b&gt;¿Hay iglesia en la sesión?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="760" y="160" width="260" height="50" as="geometry" /></mxCell><mxCell id="carga-12" value="&lt;b&gt;No (login · admin del sistema)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;identidad = null · apariencia del sistema&lt;br&gt;sin borrar la recordada&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="610" y="260" width="270" height="75" as="geometry" /></mxCell><mxCell id="carga-13" value="&lt;b&gt;1. GET /api/mi-iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cargando = true → esqueleto en la topbar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="900" y="260" width="270" height="75" as="geometry" /></mxCell><mxCell id="carga-14" value="&lt;b&gt;2. aplicar(apariencia)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tema + fuente + guardar en localStorage&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="900" y="370" width="270" height="75" as="geometry" /></mxCell><mxCell id="carga-15" value="&lt;b&gt;3. ¿tieneLogo?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sí: GET /logo como Blob (lleva el token)&lt;br&gt;→ URL.createObjectURL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="900" y="480" width="270" height="75" as="geometry" /></mxCell><mxCell id="carga-16" value="&lt;b&gt;Al salir o cambiar de iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cancela lo pendiente · revokeObjectURL&lt;br&gt;vuelve a la identidad neutra&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="610" y="600" width="270" height="75" as="geometry" /></mxCell><mxCell id="carga-17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="carga-11" target="carga-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-18" value="sí" style="edgeStyle=o