 x="650" y="197" /></Array></mxGeometry></mxCell><mxCell id="catalogo-24" value="&lt;b&gt;ubigeo mal formado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;400 (patrón de 2, 4 o 6 dígitos)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1200" y="160" width="330" height="60" as="geometry" /></mxCell><mxCell id="catalogo-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1" source="catalogo-14" target="catalogo-24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="catalogo-26" value="&lt;b&gt;El catálogo no se filtra por el token&lt;/b&gt;&lt;br&gt;La tabla iglesia no tiene RLS: el administrador del sistema ve todas aunque esté operando dentro de una." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="700" y="560" width="420" height="80" as="geometry" /></mxCell><mxCell id="catalogo-27" value="&lt;b&gt;Alta y edición&lt;/b&gt;&lt;br&gt;El alta pide nombre comercial, denominación, dirección, ubicación y contacto (CamposIglesia). Logo y apariencia se editan en /iglesias/:id con el mismo editor que «Mi iglesia»." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1200" y="560" width="500" height="100" as="geometry" /></mxCell><mxCell id="catalogo-28" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGe