ff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="carga-13" target="carga-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="297" /><mxPoint x="1180" y="637" /></Array></mxGeometry></mxCell><mxCell id="carga-24" value="Quién lo muestra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1230" y="110" width="490" height="620" as="geometry" /></mxCell><mxCell id="carga-25" value="&lt;b&gt;AppTopbar · LogoIglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;logo 40 px o monograma + nombre con font-marca&lt;br&gt;en el móvil solo el logo (nombre en aria-label)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1250" y="160" width="450" height="85" as="geometry" /></mxCell><mxCell id="carga-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="carga-15" target="carga-25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-27" value="&lt;b&gt;AppFooter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre · denominación · dirección con ubicación&lt;br&gt;tel: · mailto: · sitio web · © año&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1250" y="295" width="450" height="85" as="geometry" /></mxCell><mxCell id="carga-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="carga-15" target="carga-27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-29" value="&lt;b&gt;TituloIglesiaStrategy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Aportes · MMM Lima Centro»&lt;br&gt;se rehace cuando llega la identidad&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1250" y="430" width="450" height="85" as="geometry" /></mxCell><mxCell id="carga-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="carga-15" target="carga-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-31" value="&lt;b&gt;FaviconIglesiaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;href = urlLogo o favicon.svg del sistema&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1250" y="565" width="450" height="85" as="geometry" /></mxCell><mxCell id="carga-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="carga-15" target="carga-31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-33" value="Backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="770" width="1690" height="300" as="geometry" /></mxCell><mxCell id="carga-34" value="&lt;b&gt;MiIglesiaController.obtener()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;@PreAuthorize(&quot;isAuthenticated()&quot;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="830" width="320" height="60" as="geometry" /></mxCell><mxCell id="carga-35" value="&lt;b&gt;MiIglesiaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesiaActual.requerida() del claim iglesia_id&lt;br&gt;sin iglesia → 400&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="420" y="830" width="320" height="75" as="geometry" /></mxCell><mxCell id="carga-36" value="&lt;b&gt;IglesiaService.obtener(id)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;IglesiaResponse con ubicación y apariencia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="780" y="830" width="320" height="60" as="geometry" /></mxCell><mxCell id="carga-37" value="&lt;b&gt;iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;una fila por iglesia (catálogo)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1140" y="830" width="260" height="70" as="geometry" /></mxCell><mxCell id="carga-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="carga-34" target="carga-35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="carga-35" target="carga-36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="carga-36" target="carga-37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="carga-41" value="&lt;b&gt;La iglesia nunca viene del cliente&lt;/b&gt;&lt;br&gt;«Mi iglesia» no recibe ids: el backend la toma del token. Una iglesia no puede leer los datos ni el logo de otra." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="60" y="940" width="500" height="85" as="geometry" /></mxCell><mxCell id="carga-42" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1450" y="820" width="230" height="190" as="geometry" /></mxCell><mxCell id="carga-43" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1462" y="854" width="28" height="20" as="geometry" /></mxCell><mxCell id="carga-44" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="850" width="175" height="28" as="geometry" /></mxCell><mxCell id="carga-45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1462" y="884" width="28" height="20" as="geometry" /></mxCell><mxCell id="carga-46" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="880" width="175" height="28" as="geometry" /></mxCell><mxCell id="carga-47" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1462" y="914" width="28" height="20" as="geometry" /></mxCell><mxCell id="carga-48" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="910" width="175" height="28" as="geometry" /></mxCell><mxCell id="carga-49" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1462" y="944" width="28" height="20" as="geometry" /></mxCell><mxCell id="carga-50" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="940" width="175" height="28" as="geometry" /></mxCell><mxCell id="carga-51" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1462" y="974" width="28" height="20" as="geometry" /></mxCell><mxCell id="carga-52" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="970" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="logo" name="3. Logo con validaciones"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="logo-1" value="&lt;b&gt;Subir, servir y quitar el logo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="logo-2" value="Validaciones en el navegador y en el servidor, almacenamiento aislado por RLS y caché con ETag." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="logo-3" value="Navegador · SelectorLogoComponent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="520" height="560" as="geometry" /></mxCell><mxCell id="logo-4" value="&lt;b&gt;1. Elegir imagen (p-fileupload básico)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;accept = image/png, image/jpeg, image/webp&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="160" width="460" height="70" as="geometry" /></mxCell><mxCell id="logo-5" value="&lt;b&gt;2. errorDeLogo(archivo)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SVG u otro tipo → «Elige una imagen PNG, JPEG o WebP»&lt;br&gt;&gt; 1 MB → «La imagen pesa 2.3 MB; elige una de hasta 1 MB.»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="260" width="460" height="85" as="geometry" /></mxCell><mxCell id="logo-6" value="&lt;b&gt;3. Vista previa clara y oscura&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;URL de objeto (se libera al cambiar)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="375" width="460" height="70" as="geometry" /></mxCell><mxCell id="logo-7" value="&lt;b&gt;4. «Subir logo»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PUT con el archivo como cuerpo binario&lt;br&gt;Content-Type del archivo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="475" width="460" height="75" as="geometry" /></mxCell><mxCell id="logo-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-4" target="logo-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-5" target="logo-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-6" target="logo-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-11" value="&lt;b&gt;Quitar&lt;/b&gt; pide confirmación (p-confirmpopup): vuelve el monograma." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="60" y="580" width="460" height="55" as="geometry" /></mxCell><mxCell id="logo-12" value="iglesia-api · LogoIglesiaService.guardar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="590" y="110" width="600" height="700" as="geometry" /></mxCell><mxCell id="logo-13" value="&lt;b&gt;1. readNBytes(1 MB + 1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;no lee más de lo necesario&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="620" y="160" width="540" height="65" as="geometry" /></mxCell><mxCell id="logo-14" value="&lt;b&gt;2. ¿Más de 1 MB?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sí → 413 ContenidoDemasiadoGrandeException&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="620" y="255" width="540" height="65" as="geometry" /></mxCell><mxCell id="logo-15" value="&lt;b&gt;3. ¿Vacío?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sí → 400 «logo»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="620" y="350" width="540" height="65" as="geometry" /></mxCell><mxCell id="logo-16" value="&lt;b&gt;4. TipoImagen.detectar(bytes)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;firma PNG 89 50 4E 47 · JPEG FF D8 FF · WebP RIFF…WEBP&lt;br&gt;otra (SVG, PDF, renombrado) → 400 «logo»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="620" y="445" width="540" height="80" as="geometry" /></mxCell><mxCell id="logo-17" value="&lt;b&gt;5. AlmacenLogoIglesia.guardar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;upsert en logo_iglesia con el tipo detectado (no el de la cabecera)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="620" y="555" width="540" height="70" as="geometry" /></mxCell><mxCell id="logo-18" value="&lt;b&gt;6. iglesia.registrarLogo(reloj.instant())&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;logo_actualizado_en = ahora · log INFO solo con ids&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="620" y="655" width="540" height="70" as="geometry" /></mxCell><mxCell id="logo-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-13" target="logo-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-14" target="logo-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-15" target="logo-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-16" target="logo-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-17" target="logo-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-24" value="PUT /logo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="logo-7" target="logo-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="512" /><mxPoint x="570" y="192" /></Array></mxGeometry></mxCell><mxCell id="logo-25" value="&lt;b&gt;413 · ProblemDetail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Archivo demasiado grande» + traceId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1230" y="255" width="230" height="65" as="geometry" /></mxCell><mxCell id="logo-26" value="&lt;b&gt;400 · errores.logo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«El archivo no es una imagen PNG, JPEG o WebP»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1230" y="445" width="230" height="80" as="geometry" /></mxCell><mxCell id="logo-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="logo-14" target="logo-25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="logo-16" target="logo-26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-29" value="Servir · GET /logo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1230" y="560" width="490" height="460" as="geometry" /></mxCell><mxCell id="logo-30" value="&lt;b&gt;RespuestaLogo.de(logo, petición)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ETag = &quot;epochMillis(logo_actualizado_en)&quot;&lt;br&gt;Cache-Control: no-cache, private&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1250" y="610" width="450" height="75" as="geometry" /></mxCell><mxCell id="logo-31" value="&lt;b&gt;If-None-Match igual&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;304 sin cuerpo: el navegador reutiliza su copia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1250" y="720" width="450" height="60" as="geometry" /></mxCell><mxCell id="logo-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="logo-30" target="logo-31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logo-33" value="&lt;b&gt;logo_iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;RLS: iglesia_id = app.iglesia_id&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1250" y="820" width="300" height="70" as="geometry" /></mxCell><mxCell id="logo-34" value="&lt;b&gt;¿Por qué set_config y no la RLS del token?&lt;/b&gt;&lt;br&gt;El administrador del sistema edita el logo de cualquier iglesia: AlmacenLogoIglesia fija app.iglesia_id a la iglesia destino dentro de la transacción y restaura el valor anterior." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="30" y="700" width="520" height="120" as="geometry" /></mxCell><mxCell id="logo-35" value="&lt;b&gt;Sin SVG&lt;/b&gt;&lt;br&gt;Un SVG puede llevar scripts. La firma del archivo manda: un SVG enviado como image/png también se rechaza." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="30" y="840" width="520" height="80" as="geometry" /></mxCell><mxCell id="logo-36" value="&lt;b&gt;Desviación de la spec&lt;/b&gt;&lt;br&gt;El logo viaja como cuerpo binario (no multipart) para poder cortar la lectura en 1 MB + 1 y responder 413 sin cargar el archivo entero." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="590" y="840" width="600" height="80" as="geometry" /></mxCell><mxCell id="logo-37" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1500" y="820" width="230" height="190" as="geometry" /></mxCell><mxCell id="logo-38" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1512" y="854" width="28" height="20" as="geometry" /></mxCell><mxCell id="logo-39" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="850" width="175" height="28" as="geometry" /></mxCell><mxCell id="logo-40" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1512" y="884" width="28" height="20" as="geometry" /></mxCell><mxCell id="logo-41" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="880" width="175" height="28" as="geometry" /></mxCell><mxCell id="logo-42" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1512" y="914" width="28" height="20" as="geometry" /></mxCell><mxCell id="logo-43" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="910" width="175" height="28" as="geometry" /></mxCell><mxCell id="logo-44" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1512" y="944" width="28" height="20" as="geometry" /></mxCell><mxCell id="logo-45" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="940" width="175" h