ent="1" vertex="1" ><mxGeometry x="1752" y="264" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-78" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1788" y="260" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-79" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1752" y="294" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-80" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1788" y="290" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-81" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1752" y="324" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-82" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1788" y="320" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-83" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1752" y="354" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-84" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1788" y="350" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="alta" name="2. Alta de una iglesia con su administrador"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="alta-1" value="&lt;b&gt;Alta de una iglesia con su primer administrador&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="alta-2" value="El frontend hace dos llamadas a dos backends distintos; cada fallo se maneja según en qué paso ocurre." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="alta-3" value="&lt;b&gt;1. FormularioIglesiaComponent emite AltaIglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre (≤ 150, no solo espacios) · correo · contraseña temporal (8–72)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="130" width="380" height="70" as="geometry" /></mxCell><mxCell id="alta-4" value="&lt;b&gt;2. POST /api/iglesias { nombre }&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;IglesiasService.crear → iglesia-api&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="240" width="380" height="60" as="geometry" /></mxCell><mxCell id="alta-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="alta-3" target="alta-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-6" value="&lt;b&gt;IglesiaService.crear&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;strip · existsByNombreIgnoreCase · saveAndFlush&lt;br&gt;INFO «Iglesia creada id={} por usuarioId={}»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="235" width="330" height="70" as="geometry" /></mxCell><mxCell id="alta-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-4" target="alta-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-8" value="&lt;b&gt;iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;INSERT&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="880" y="225" width="160" height="80" as="geometry" /></mxCell><mxCell id="alta-9" value="&lt;b&gt;400 / 409 «Ya existe una iglesia con ese nombre»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;el mensaje se muestra DENTRO del diálogo, que sigue abierto&lt;br&gt;no se intenta crear el administrador&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="340" width="420" height="70" as="geometry" /></mxCell><mxCell id="alta-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-4" target="alta-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="344" y="375" /></Array></mxGeometry></mxCell><mxCell id="alta-11" value="&lt;b&gt;3. 201 → GET /api/roles&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AdministradoresIglesiaService busca el rol base ADMIN_IGLESIA (base = true)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="450" width="380" height="70" as="geometry" /></mxCell><mxCell id="alta-12" value="201 { id }" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-4" target="alta-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-13" value="&lt;b&gt;4. POST /api/usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ correo, contrasena, iglesiaId: id nuevo, miembroId: null, rolIds: [ADMIN_IGLESIA] }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="560" width="380" height="80" as="geometry" /></mxCell><mxCell id="alta-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="alta-11" target="alta-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-15" value="&lt;b&gt;UsuarioService.crear (iglesia-seguridad)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;actor.esGlobal() → puede elegir la iglesia&lt;br&gt;debe_cambiar_contrasena = true&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="565" width="330" height="70" as="geometry" /></mxCell><mxCell id="alta-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-13" target="alta-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-17" value="&lt;b&gt;usuario · usuario_rol&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;INSERT&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="880" y="560" width="180" height="80" as="geometry" /></mxCell><mxCell id="alta-18" value="&lt;b&gt;5. Éxito&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cierra el diálogo · recarga la tabla&lt;br&gt;toast «Iglesia creada»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="700" width="300" height="80" as="geometry" /></mxCell><mxCell id="alta-19" value="&lt;b&gt;Falla el administrador (409, 400 o 5xx)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cierra el diálogo y recarga: la iglesia YA existe&lt;br&gt;aviso fijo: «La iglesia se creó, pero no su administrador: &amp;lt;detalle&amp;gt;. Usa &quot;Crear administrador&quot;.»&lt;br&gt;con 5xx el detalle es «ocurrió un error inesperado»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="380" y="700" width="480" height="100" as="geometry" /></mxCell><mxCell id="alta-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-13" target="alta-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-13" target="alta-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-22" value="&lt;b&gt;Completar: «Crear administrador»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;FormularioAdministradorComponent → mismos pasos 3 y 4&lt;br&gt;con el id de esa iglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="900" y="715" width="340" height="70" as="geometry" /></mxCell><mxCell id="alta-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-19" target="alta-22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-24" value="&lt;b&gt;¿Por qué no se reintenta todo?&lt;/b&gt;&lt;br&gt;Reintentar el alta duplicaría la iglesia (o daría 409). La acción «Crear administrador» completa la iglesia que quedó sin usuarios, sin tocar el catálogo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1100" y="220" width="380" height="110" as="geometry" /></mxCell><mxCell id="alta-25" value="&lt;b&gt;Sin id fijo del rol&lt;/b&gt;&lt;br&gt;El id del rol ADMIN_IGLESIA lo asigna la base de iglesia-seguridad. El frontend lo busca en &lt;code&gt;GET /api/roles&lt;/code&gt; en vez de codificarlo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1100" y="450" width="380" height="90" as="geometry" /></mxCell><mxCell id="alta-26" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1320" y="830" width="230" height="250" as="geometry" /></mxCell><mxCell id="alta-27" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1332" y="864" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-28" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1368" y="860" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1332" y="894" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-30" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1368" y="890" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1332" y="924" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-32" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1368" y="920" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1332" y="954" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-34" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1368" y="950" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1332" y="984" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-36" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1368" y="980" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1332" y="1014" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-38" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1368" y="1010" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1332" y="1044" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-40" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1368" y="1040" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="entrar" name="3. Entrar y salir de una iglesia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="entrar-1" value="&lt;b&gt;Entrar a una iglesia, refrescar y salir&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="entrar-2" value="El JWT se vuelve a emitir con la iglesia elegida; la cookie de refresco rota y la recuerda." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="entrar-3" value="&lt;b&gt;1. «Entrar» en la tabla&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;IglesiasListaComponent → SesionService.entrarAIglesia(id)&lt;br&gt;«Entrar» deshabilitado mientras tanto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="130" width="360" height="75" as="geometry" /></mxCell><mxCell id="entrar-4" value="&lt;b&gt;2. POST /api/auth/iglesia-actuando&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ iglesiaId } · Bearer (iglesias.administrar) · cookie iglesia_refresco&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="250" width="360" height="70" as="geometry" /></mxCell><mxCell id="entrar-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="entrar-3" target="entrar-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-6" value="&lt;b&gt;AuthService.entrarAIglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;consume la cookie (revoca) · debe ser del usuario del token&lt;br&gt;emite cookie nueva con iglesia_actuando_id = id&lt;br&gt;INFO «usuarioId={} entra a iglesiaId={}»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="240" width="360" height="90" as="geometry" /></mxCell><mxCell id="entrar-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="entrar-4" target="entrar-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-8" value="&lt;b&gt;token_refresco&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;anterior: revocado_en&lt;br&gt;nuevo: iglesia_actuando_id&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="880" y="245" width="210" height="80" as="geometry" /></mxCell><mxCell id="entrar-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="entrar-6" target="entrar-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-10" value="&lt;b&gt;JWT nuevo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;roles: [&quot;ADMIN_SISTEMA&quot;] (no cambia)&lt;br&gt;iglesia_id: id · actuando_en_iglesia: true&lt;br&gt;permisos: propios ∪ ADMIN_IGLESIA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="370" width="360" height="80" as="geometry" /></mxCell><mxCell id="entrar-11" value="GeneradorTokenAcceso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="entrar-6" target="entrar-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-12" value="&lt;b&gt;401 / 403 / 400&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;401: sin cookie o de otro usuario (la ajena queda revocada)&lt;br&gt;403: sin iglesias.administrar · 400: iglesiaId inválido&lt;br&gt;la página avisa el motivo y se queda en el catálogo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="120" width="380" height="85" as="geometry" /></mxCell><mxCell id="entrar-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="entrar-4" target="entrar-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="264" /><mxPoint x="440" y="162" /></Array></mxGeometry></mxCell><mxCell id="entrar-14" value="&lt;b&gt;4. Sesión: guarda el token y recarga GET /api/usuarios/me&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;perfil ADMIN_SISTEMA con los permisos del token&lt;br&gt;actuandoEnIglesia: true · iglesiaId: id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="500" width="420" height="75" as="geometry" /></mxCell><mxCell id="entrar-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="entrar-10" target="entrar-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-16" value="&lt;b&gt;5. Navega a /usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesiaFijadaGuard pasa · menú muestra Miembros/Usuarios/Roles&lt;br&gt;topbar: «Operando en: &amp;lt;nombre&amp;gt;»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="620" width="420" height="75" as="geometry" /></mxCell><mxCell id="entrar-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="entrar-14" target="entrar-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-18" value="&lt;b&gt;iglesia-api con ese token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CurrentTenantIdentifierResolver lee iglesia_id&lt;br&gt;Hibernate @TenantId + SET LOCAL app.iglesia_id (RLS)&lt;br&gt;→ ve solo los datos de esa iglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="520" y="610" width="380" height="90" as="geometry" /></mxCell><mxCell id="entrar-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="entrar-16" target="entrar-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-20" value="&lt;b&gt;POST /api/auth/refresh (cada 15 min)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;consumir → RefrescoConsumido(usuario, iglesiaActuandoId)&lt;br&gt;conserva la iglesia SOLO si aún tiene iglesias.administrar&lt;br&gt;si lo perdió → token global&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="960" y="520" width="400" height="90" as="geometry" /></mxCell><mxCell id="entrar-21" value="&lt;b&gt;El refresco recuerda la iglesia&lt;/b&gt;&lt;br&gt;Sin &lt;code&gt;iglesia_actuando_id&lt;/code&gt;, el primer refresco devolvería al administrador a su vista global en medio del trabajo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1390" y="520" width="330" height="100" as="geometry" /></mxCell><mxCell id="entrar-22" value="cada refresco" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.0625;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="entrar-8" target="entrar-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-23" value="&lt;b&gt;6. «Salir de la iglesia» (topbar)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SesionService.salirDeIglesia()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="770" width="360" height="65" as="geometry" /></mxCell><mxCell id="entrar-24" value="&lt;b&gt;7. DELETE /api/auth/iglesia-actuando&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;rota la cookie con iglesia_actuando_id = NULL&lt;br&gt;JWT sin iglesia_id · permisos propios&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="870" width="360" height="75" as="geometry" /></mxCell><mxCell id="entrar-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="entrar-23" target="entrar-24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-26" value="&lt;b&gt;Vuelve a la vista global&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;recarga /me · navega a /iglesias&lt;br&gt;el menú oculta las páginas de la iglesia&lt;br&gt;INFO «sale de iglesiaId={}»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="865" width="360" height="85" as="geometry" /></mxCell><mxCell id="entrar-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="entrar-24" target="entrar-26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="entrar-28" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1500" y="760" width="230" height="250" as="geometry" /></mxCell><mxCell id="entrar-29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1512" y="794" width="28" height="20" as="geometry" /></mxCell><mxCell id="entrar-30" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="790" width="175" height="28" as="geometry" /></mxCell><mxCell id="entrar-31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1512" y="824" width="28" height="20" as="geometry" /></mxCell><mxCell id="entrar-32" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="820" width="175" height="28" as="geometry" /></mxCell><mxCell id="entrar-33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1512" y="854" width="28" height="20" as="geometry" /></mxCell><mxCell id="entrar-34" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="850" width="175" height="28" as="geometry" /></mxCell><mxCell id="entrar-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1512" y="884" width="28" height="20" as="geometry" /></mxCell><mxCell id="entrar-36" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="880" width="175" height="28" as="geometry" /></mxCell><mxCell id="entrar-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1512" y="914" width="28" height="20" as="geometry" /></mxCell><mxCell id="entrar-38" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="910" width="175" height="28" as="geometry" /></mxCell><mxCell id="entrar-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1512" y="944" width="28" height="20" as="geometry" /></mxCell><mxCell id="entrar-40" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="940" width="175" height="28" as="geometry" /></mxCell><mxCell id="entrar-41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1512" y="974" width="28" height="20" as="geometry" /></mxCell><mxCell id="entrar-42" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="970" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ambito" name="4. Ámbito: vista global o dentro de una iglesia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ambito-1" value="&lt;b&gt;Ámbito del administrador del sistema&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="ambito-2" value="El mismo usuario tiene dos modos; el token decide cuál, y cada capa lo deriva del token, nunca de lo que envía el cliente." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="ambito-3" value="Vista global (sin iglesia_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="120" width="600" height="560" as="geometry" /></mxCell><mxCell id="ambito-4" value="Dentro de una iglesia (iglesia_id + actuando_en_iglesia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="680" y="120" width="600" height="560" as="geometry" /></mxCell><mxCell id="ambito-5" value="&lt;b&gt;UsuarioAutenticado.esGlobal()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ADMIN_SISTEMA y iglesiaId == null&lt;br&gt;PoliticaAdministracionUsuarios: puede elegir la iglesia del usuario nuevo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="170" width="540" height="75" as="geometry" /></mxCell><mxCell id="ambito-6" value="&lt;b&gt;Permisos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;los de sus roles: usuarios.ver/administrar · roles.ver&lt;br&gt;iglesias.ver · iglesias.administrar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="270" width="540" height="70" as="geometry" /></mxCell><mxCell id="ambito-7" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;operaEnIglesia = false&lt;br&gt;menú: Principal + «Sistema › Iglesias»&lt;br&gt;/miembros, /usuarios, /roles → /iglesias (iglesiaFijadaGuard)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="365" width="540" height="90" as="geometry" /></mxCell><mxCell id="ambito-8" value="&lt;b&gt;iglesia-api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;solo el catálogo /api/iglesias (sin tenant)&lt;br&gt;los endpoints de negocio no tienen iglesia que resolver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="480" width="540" height="70" as="geometry" /></mxCell><mxCell id="ambito-9" value="&lt;b&gt;UsuarioAutenticado.actuandoEnIglesia()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ADMIN_SISTEMA y iglesiaId != null&lt;br&gt;se comporta como un administrador de esa iglesia: solo ve y crea en ella&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="710" y="170" width="540" height="75" as="geometry" /></mxCell><mxCell id="ambito-10" value="&lt;b&gt;Permisos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;propios ∪ los del rol base ADMIN_IGLESIA (leídos de la base)&lt;br&gt;roles sigue siendo [&quot;ADMIN_SISTEMA&quot;]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="710" y="270" width="540" height="70" as="geometry" /></mxCell><mxCell id="ambito-11" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;operaEnIglesia = true · actuandoEnIglesia = true&lt;br&gt;menú completo · topbar «Operando en» + «Salir»&lt;br&gt;tabla de iglesias marca «Actual»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="710" y="365" width="540" height="90" as="geometry" /></mxCell><mxCell id="ambito-12" value="&lt;b&gt;iglesia-api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tenant = iglesia_id del token&lt;br&gt;Hibernate @TenantId + RLS: aislado como cualquier usuario de la iglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="710" y="480" width="540" height="70" as="geometry" /></mxCell><mxCell id="ambito-13" value="&lt;b&gt;¿Por qué no cambiar el rol?&lt;/b&gt;&lt;br&gt;Mantener &lt;code&gt;roles = [&quot;ADMIN_SISTEMA&quot;]&lt;/code&gt; deja claro en logs y auditoría quién actúa realmente. Lo que cambia es el alcance (iglesia_id) y los permisos efectivos." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="70" y="580" width="540" height="80" as="geometry" /></mxCell><mxCell id="ambito-14" value="&lt;b&gt;Garantía de administrador&lt;/b&gt;&lt;br&gt;Dentro de una iglesia aplica la misma regla de la SPEC 04: no puede dejarla sin un usuario activo con usuarios.administrar (409)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="710" y="580" width="540" height="80" as="geometry" /></mxCell><mxCell id="ambito-15" value="&lt;b&gt;Los permisos de iglesias no salen del sistema&lt;/b&gt;&lt;br&gt;ADMIN_IGLESIA no tiene &lt;code&gt;iglesias.*&lt;/code&gt;, así que ningún rol personalizado puede marcarlos (sus permisos son un subconjunto del rol base)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1310" y="170" width="330" height="120" as="geometry" /></mxCell><mxCell id="ambito-16" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1310" y="330" width="230" height="160" as="geometry" /></mxCell><mxCell id="ambito-17" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1322" y="364" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-18" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="360" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-19" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1322" y="394" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-20" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="390" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1322" y="424" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-22" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="420" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1322" y="454" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-24" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1358" y="450" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
