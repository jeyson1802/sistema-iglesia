<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arquitectura" name="1. Arquitectura del acceso global"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arquitectura-1" value="&lt;b&gt;Arquitectura: catálogo de iglesias y operar dentro de una iglesia&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-2" value="Componentes del frontend, endpoints REST de los dos backends, clases que los atienden y tablas que leen o escriben." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="700" height="1100" as="geometry" /></mxCell><mxCell id="arquitectura-4" value="Contrato HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="760" y="110" width="330" height="1100" as="geometry" /></mxCell><mxCell id="arquitectura-5" value="Backends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1120" y="110" width="600" height="1100" as="geometry" /></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;app.routes.ts · iglesias.routes.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/iglesias → &lt;code&gt;permisoGuard(&#x27;iglesias.ver&#x27;)&lt;/code&gt;&lt;br&gt;/miembros, /usuarios, /roles → &lt;code&gt;iglesiaFijadaGuard&lt;/code&gt; (primero)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="150" width="400" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-7" value="&lt;b&gt;iglesiaFijadaGuard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;con iglesia → pasa&lt;br&gt;sin iglesia: con iglesias.ver → /iglesias&lt;br&gt;si no → /auth/acceso-denegado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="480" y="150" width="230" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-6" target="arquitectura-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-9" value="&lt;b&gt;IglesiasListaComponent (contenedor)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;carga el catálogo · alta en dos llamadas · renombrar&lt;br&gt;crear administrador · «Entrar» → /usuarios&lt;br&gt;400/409 en el diálogo · toast de éxito · «Reintentar»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="270" width="430" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-6" target="arquitectura-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;TablaIglesiasComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Nombre · Creada · Acciones&lt;br&gt;«Actual» · esqueleto · vacío&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="410" width="210" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-12" value="&lt;b&gt;FormularioIglesiaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;crear: nombre + primer administrador&lt;br&gt;editar: solo el nombre&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="262" y="410" width="220" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-13" value="&lt;b&gt;FormularioAdministradorComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;correo + contraseña temporal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="494" y="410" width="220" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-14" value="&lt;b&gt;CamposAdministradorComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;correo (≤ 254) · temporal (8–72)&lt;br&gt;compartido por los dos diálogos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="380" y="520" width="260" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-9" target="arquitectura-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-9" target="arquitectura-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-9" target="arquitectura-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-12" target="arquitectura-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-13" target="arquitectura-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-20" value="&lt;b&gt;IglesiasService (core/iglesias)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · obtener · crear · renombrar&lt;br&gt;URL base environment.apiUrl&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="630" width="300" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-21" value="&lt;b&gt;AdministradoresIglesiaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;busca el rol base ADMIN_IGLESIA (sin id fijo)&lt;br&gt;→ UsuariosService.crearEnIglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="380" y="630" width="320" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-9" target="arquitectura-20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="103" y="600" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-9" target="arquitectura-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="447" y="380" /><mxPoint x="720" y="380" /><mxPoint x="720" y="600" /><mxPoint x="668" y="600" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-24" value="&lt;b&gt;SesionService (core/auth)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;entrarAIglesia(id) · salirDeIglesia()&lt;br&gt;guardan el token y recargan /me conservando el perfil&lt;br&gt;operaEnIglesia · actuandoEnIglesia (computed)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="760" width="400" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-25" value="«Entrar»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-9" target="arquitectura-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="315" /><mxPoint x="45" y="787" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-26" value="&lt;b&gt;AppTopbar (autorizado)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Operando en: &amp;lt;nombre&amp;gt;» · «Salir de la iglesia»&lt;br&gt;nombre con IglesiasService.obtener&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="890" width="320" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-27" value="&lt;b&gt;AppMenu · construirMenu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Sistema › Iglesias» (iglesias.ver)&lt;br&gt;requiereIglesia oculta Miembros/Usuarios/Roles&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="400" y="890" width="310" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-28" value="salir" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-26" target="arquitectura-24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-29" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-27" target="arquitectura-24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-30" value="&lt;b&gt;¿Por qué el frontend orquesta el alta?&lt;/b&gt;&lt;br&gt;Iglesia y usuario viven en bases distintas (iglesia-api e iglesia-seguridad) sin transacción común. Si falla el administrador, la iglesia ya existe: se cierra el diálogo, se recarga y se indica «Crear administrador», en vez de reintentar y duplicarla." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="60" y="1000" width="400" height="130" as="geometry" /></mxCell><mxCell id="arquitectura-31" value="&lt;b&gt;El perfil trae los permisos&lt;/b&gt;&lt;br&gt;Dentro de una iglesia, &lt;code&gt;/me&lt;/code&gt; devuelve el perfil ADMIN_SISTEMA con los permisos del token (los suyos ∪ ADMIN_IGLESIA). Así guards y menú funcionan sin lógica especial." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="480" y="1000" width="230" height="160" as="geometry" /></mxCell><mxCell id="arquitectura-32" value="&lt;b&gt;GET /api/iglesias[/{id}]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesia-api · iglesias.ver → 200 | 404&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="780" y="600" width="290" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-33" value="&lt;b&gt;POST /api/iglesias&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesias.administrar → 201 | 400 | 409&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="780" y="670" width="290" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-34" value="&lt;b&gt;PUT /api/iglesias/{id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesias.administrar → 200 | 400 | 404 | 409&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="780" y="740" width="290" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-35" value="&lt;b&gt;GET /api/roles · POST /api/usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesia-seguridad · rol base + iglesiaId elegida&lt;br&gt;201 | 400 | 409&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="780" y="520" width="290" height="65" as="geometry" /></m