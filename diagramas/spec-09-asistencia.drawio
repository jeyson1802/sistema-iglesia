ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-54" target="arquitectura-58"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-74" value="&lt;b&gt;culto_programado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre · dia_semana · hora · activo&lt;br&gt;ux (iglesia_id, lower(nombre))&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1300" y="1220" width="260" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-75" value="&lt;b&gt;reunion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tipo · nombre · fecha · hora&lt;br&gt;ux (iglesia, culto, fecha) · ux (iglesia, grupo, fecha)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1580" y="1220" width="290" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-76" value="&lt;b&gt;asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PK (iglesia, reunion, miembro)&lt;br&gt;medio QR | MANUAL · registrada_por/en&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1890" y="1220" width="260" height="95" as="geometry" /></mxCell><mxCell id="arquitectura-77" value="&lt;b&gt;miembro.codigo_asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ux (iglesia_id, codigo_asistencia)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1740" y="1080" width="300" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-51" target="arquitectura-74"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="185" /><mxPoint x="1280" y="1267" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-52" target="arquitectura-75"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1605" y="1190" /><mxPoint x="1725" y="1190" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-53" target="arquitectura-76"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1668" y="1200" /><mxPoint x="2020" y="1200" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-81" value="&lt;b&gt;Multi-iglesia&lt;/b&gt;&lt;br&gt;Las tres tablas llevan &lt;code&gt;iglesia_id&lt;/code&gt;, RLS y FK compuestas &lt;code&gt;(iglesia_id, id)&lt;/code&gt;: una asistencia nunca apunta a una reunión o un miembro de otra iglesia." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1740" y="560" width="400" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="escaneo" name="2. Flujo de un escaneo"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="escaneo-1" value="&lt;b&gt;Flujo de un escaneo: cámara o lector → validación → resultado&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="escaneo-2" value="Quien toma asistencia no debería mirar la pantalla salvo cuando algo sale mal: el resultado llega con color, sonido y vibración." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="escaneo-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="900" height="1010" as="geometry" /></mxCell><mxCell id="escaneo-4" value="iglesia-api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="960" y="110" width="1010" height="1010" as="geometry" /></mxCell><mxCell id="escaneo-5" value="&lt;b&gt;1. Cámara o lector 2D&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CamaraQr lee ~8 veces/s · el lector escribe ASIS:… + Enter&lt;br&gt;en EntradaLector (siempre enfocado)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="160" width="380" height="80" as="geometry" /></mxCell><mxCell id="escaneo-6" value="&lt;b&gt;¿Hay conexión?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;EstadoConexion · sin conexión: franja roja fija&lt;br&gt;y no se envía nada&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="160" width="380" height="80" as="geometry" /></mxCell><mxCell id="escaneo-7" value="&lt;b&gt;2. ProcesadorCodigos.procesar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;¿formato ASIS:XXXXXXXXXXXX? · ¿mismo código hace &amp;lt; 3 s?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="290" width="380" height="80" as="geometry" /></mxCell><mxCell id="escaneo-8" value="&lt;b&gt;No es un código&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;franja roja «Este QR no es un código de asistencia»&lt;br&gt;sin llamar al servidor&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="290" width="380" height="80" as="geometry" /></mxCell><mxCell id="escaneo-9" value="&lt;b&gt;Relectura de la cámara&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;se ignora en silencio&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="400" width="380" height="60" as="geometry" /></mxCell><mxCell id="escaneo-10" value="&lt;b&gt;3. AsistenciasService.marcarPorCodigo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;POST /api/reuniones/{id}/asistencias/codigo&lt;br&gt;{ codigo }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="420" width="380" height="80" as="geometry" /></mxCell><mxCell id="escaneo-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-5" target="escaneo-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-5" target="escaneo-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-13" value="inválida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-7" target="escaneo-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-14" value="repetida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-7" target="escaneo-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-15" value="enviar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-7" target="escaneo-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-16" value="&lt;b&gt;4. AsistenciaController → AsistenciaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reunión en el ámbito (AmbitoAsistencia) · no futura&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="420" width="420" height="80" as="geometry" /></mxCell><mxCell id="escaneo-17" value="&lt;b&gt;5. MiembrosParaAsistencia.porCodigo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembro de esta iglesia (Hibernate @TenantId + RLS) · activo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="550" width="420" height="80" as="geometry" /></mxCell><mxCell id="escaneo-18" value="&lt;b&gt;6. INSERT … ON CONFLICT DO NOTHING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;si ya estaba: yaRegistrado = true y su hora&lt;br&gt;total = COUNT(*) de la reunión&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="680" width="420" height="80" as="geometry" /></mxCell><mxCell id="escaneo-19" value="&lt;b&gt;asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PK (iglesia_id, reunion_id, miembro_id)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1500" y="680" width="280" height="80" as="geometry" /></mxCell><mxCell id="escaneo-20" value="&lt;b&gt;Rechazos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;404 «Código no encontrado en esta iglesia» (otra iglesia, inexistente)&lt;br&gt;400 «El miembro está inactivo» · 400 reunión futura&lt;br&gt;404 reunión fuera de su ámbito&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1460" y="420" width="480" height="100" as="geometry" /></mxCell><mxCell id="escaneo-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-10" target="escaneo-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-16" target="escaneo-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-17" target="escaneo-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-16" target="escaneo-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-17" target="escaneo-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-26" value="&lt;b&gt;7. MarcaResponse&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembroId · nombreCompleto · nivel · yaRegistrado&lt;br&gt;registradaEn · totalAsistentes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="810" width="420" height="80" as="geometry" /></mxCell><mxCell id="escaneo-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-18" target="escaneo-26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-28" value="&lt;b&gt;8. ResultadoMarca + AvisosMarca&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;verde ✓ nombre y nivel (1,5 s, sonido agudo, vibración corta)&lt;br&gt;ámbar «Ya estaba registrado a las 10:02»&lt;br&gt;rojo con el motivo (se queda hasta la siguiente)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="810" width="400" height="100" as="geometry" /></mxCell><mxCell id="escaneo-29" value="&lt;b&gt;9. Contador y últimas marcas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;total del servidor (suma lo de todos los equipos)&lt;br&gt;últimas 5 con «Deshacer» → DELETE + olvidar()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="810" width="380" height="100" as="geometry" /></mxCell><mxCell id="escaneo-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-26" target="escaneo-28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="850" /></Array></mxGeometry></mxCell><mxCell id="escaneo-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-28" target="escaneo-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-32" value="error 4xx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="escaneo-10" target="escaneo-28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="escaneo-33" value="&lt;b&gt;Dos equipos a la vez&lt;/b&gt;&lt;br&gt;Un celular con cámara y una laptop con lector pueden marcar la misma reunión: la PK y el ON CONFLICT impiden duplicados y cada respuesta trae el total real." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1460" y="560" width="480" height="95" as="geometry" /></mxCell><mxCell id="escaneo-34" value="&lt;b&gt;Modo Manual&lt;/b&gt;&lt;br&gt;Cultos y eventos: búsqueda por nombre (300 ms) con «Marcar» / «Presente ✓». Grupos: interruptor por integrante que guarda al instante y se revierte si falla; «Marcar a todos»." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="60" y="960" width="400" height="110" as="geometry" /></mxCell><mxCell id="escaneo-35" value="&lt;b&gt;Logs sin datos personales&lt;/b&gt;&lt;br&gt;El servicio registra en INFO solo ids (reunión, miembro, medio); nunca el nombre ni el código." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1460" y="810" width="480" height="80" as="geometry" /></mxCell><mxCell id="escaneo-36" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1460" y="920" width="230" height="220" as="geometry" /></mxCell><mxCell id="escaneo-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1472" y="954" width="28" height="20" as="geometry" /></mxCell><mxCell id="escaneo-38" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1508" y="950" width="175" height="28" as="geometry" /></mxCell><mxCell id="escaneo-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1472" y="984" width="28" height="20" as="geometry" /></mxCell><mxCell id="escaneo-40" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1508" y="980" width="175" height="28" as="geometry" /></mxCell><mxCell id="escaneo-41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1472" y="1014" width="28" height="20" as="geometry" /></mxCell><mxCell id="escaneo-42" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1508" y="1010" width="175" height="28" as="geometry" /></mxCell><mxCell id="escaneo-43" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1472" y="1044" width="28" height="20" as="geometry" /></mxCell><mxCell id="escaneo-44" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1508" y="1040" width="175" height="28" as="geometry" /></mxCell><mxCell id="escaneo-45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1472" y="1074" width="28" height="20" as="geometry" /></mxCell><mxCell id="escaneo-46" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1508" y="1070" width="175" height="28" as="geometry" /></mxCell><mxCell id="escaneo-47" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1472" y="1104" width="28" height="20" as="geometry" /></mxCell><mxCell id="escaneo-48" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1508" y="1100" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="apertura" name="3. Apertura de reuniones del día"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="apertura-1" value="&lt;b&gt;Reuniones del día: se arman solas y se abren al tocarlas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="apertura-2" value="Nadie «crea» el culto del domingo: «Hoy» combina los horarios fijos, los eventos y los grupos del día, y la reunión se crea la primera vez que alguien toma asistencia." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="apertura-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="780" height="900" as="geometry" /></mxCell><mxCell id="apertura-4" value="iglesia-api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="840" y="110" width="1030" height="900" as="geometry" /></mxCell><mxCell id="apertura-5" value="&lt;b&gt;1. AsistenciaInicio carga «Hoy»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GET /api/reuniones/hoy (solo quien marca)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="160" width="360" height="70" as="geometry" /></mxCell><mxCell id="apertura-6" value="&lt;b&gt;2. ReunionService.hoy()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fecha de hoy (Clock del servidor) · diaSemana&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="880" y="160" width="420" height="70" as="geometry" /></mxCell><mxCell id="apertura-7" value="&lt;b&gt;Cultos activos de ese día&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;culto_programado (si el perfil marca en toda la iglesia)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="880" y="270" width="320" height="70" as="geometry" /></mxCell><mxCell id="apertura-8" value="&lt;b&gt;Eventos de hoy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reunion tipo EVENTO con fecha = hoy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1220" y="270" width="300" height="70" as="geometry" /></mxCell><mxCell id="apertura-9" value="&lt;b&gt;Grupos del día (AgendaGrupos)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;grupo.dia_reunion = hoy · líder: solo los suyos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1540" y="270" width="300" height="70" as="geometry" /></mxCell><mxCell id="apertura-10" value="&lt;b&gt;3. ReunionHoyResponse[] ordenadas por hora&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;id = null si aún no se abrió; si ya existe, su id y total&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="880" y="390" width="420" height="70" as="geometry" /></mxCell><mxCell id="apertura-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-5" target="apertura-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-6" target="apertura-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-6" target="apertura-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-6" target="apertura-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-7" target="apertura-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-16" value="&lt;b&gt;4. TarjetaReunionHoy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;toda la tarjeta es «Tomar asistencia»&lt;br&gt;muestra «128 presentes» si ya se abrió&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="390" width="360" height="80" as="geometry" /></mxCell><mxCell id="apertura-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-10" target="apertura-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-18" value="&lt;b&gt;5. ¿Tiene id?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sí → navega a /asistencia/reuniones/:id&lt;br&gt;no → abrir&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="520" width="360" height="70" as="geometry" /></mxCell><mxCell id="apertura-19" value="&lt;b&gt;6. POST /api/reuniones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ cultoProgramadoId | grupoId, fecha: hoy }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="630" width="360" height="70" as="geometry" /></mxCell><mxCell id="apertura-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-16" target="apertura-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-18" target="apertura-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-22" value="&lt;b&gt;7. ReunionService.abrir&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;copia nombre y hora del culto o grupo&lt;br&gt;INSERT … ON CONFLICT (iglesia, culto|grupo, fecha) DO NOTHING&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="880" y="630" width="480" height="80" as="geometry" /></mxCell><mxCell id="apertura-23" value="&lt;b&gt;201 Created / 200 OK&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;creada ahora / ya la había abierto otro equipo:&lt;br&gt;en ambos casos devuelve la misma reunión&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1400" y="630" width="420" height="80" as="geometry" /></mxCell><mxCell id="apertura-24" value="&lt;b&gt;reunion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ux_reunion_culto_fecha · ux_reunion_grupo_fecha&lt;br&gt;(índices únicos parciales)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1400" y="760" width="420" height="85" as="geometry" /></mxCell><mxCell id="apertura-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-19" target="apertura-22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-22" target="apertura-23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apertura-27" value="&lt;b&gt;8. Navega a tomar asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Router → /asistencia/reuniones/:id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="760" width="360" height="70" as="geometry" /></mxCell><mxCell id="apertura-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="apertura-23" target="apertura-27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1610" y="900" /><mxPoint x="600" y="900" /><mxPoint x="600" y="795" /></Array></mxGeometry></mxCell><mxCell id="apertura-29" value="&lt;b&gt;Otra fecha&lt;/b&gt;&lt;br&gt;«Tomar asistencia de otra fecha» usa el mismo POST con una fecha pasada (nunca futura). Ofrece cultos (si marca en toda la iglesia), grupos visibles y los grupos de hoy." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="450" y="520" width="340" height="120" as="geometry" /></mxCell><mxCell id="apertura-30" value="&lt;b&gt;Eventos&lt;/b&gt;&lt;br&gt;«Crear evento» (asistencia.configurar) crea una reunión por día, hasta 7. Un evento sin asistentes se puede eliminar desde su detalle." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="450" y="660" width="340" height="90" as="geometry" /></mxCell><mxCell id="apertura-31" value="&lt;b&gt;Un líder&lt;/b&gt;&lt;br&gt;Abrir un culto o un grupo ajeno devuelve 404, igual que verlo: no se revela que existe." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="880" y="760" width="480" height="70" as="geometry" /></mxCell><mxCell id="apertura-32" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1400" y="880" width="230" height="190" as="geometry" /></mxCell><mxCell id="apertura-33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1412" y="914" width="28" height="20" as="geometry" /></mxCell><mxCell id="apertura-34" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1448" y="910" width="175" height="28" as="geometry" /></mxCell><mxCell id="apertura-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1412" y="944" width="28" height="20" as="geometry" /></mxCell><mxCell id="apertura-36" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1448" y="940" width="175" height="28" as="geometry" /></mxCell><mxCell id="apertura-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1412" y="974" width="28" height="20" as="geometry" /></mxCell><mxCell id="apertura-38" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1448" y="970" width="175" height="28" as="geometry" /></mxCell><mxCell id="apertura-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1412" y="1004" width="28" height="20" as="geometry" /></mxCell><mxCell id="apertura-40" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1448" y="1000" width="175" height="28" as="geometry" /></mxCell><mxCell id="apertura-41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1412" y="1034" width="28" height="20" as="geometry" /></mxCell><mxCell id="apertura-42" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1448" y="1030" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="fotocheck" name="4. Fotocheck y código QR"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="fotocheck-1" value="&lt;b&gt;Fotocheck y código QR: generar, compartir, imprimir y regenerar&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="fotocheck-2" value="El backend solo guarda y entrega el código; el QR y la imagen se generan en el navegador." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="fotocheck-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="900" height="900" as="geometry" /></mxCell><mxCell id="fotocheck-4" value="iglesia-api · miembros/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="960" y="110" width="910" height="900" as="geometry" /></mxCell><mxCell id="fotocheck-5" value="&lt;b&gt;1. Ficha › CodigoAsistenciaMiembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GET /api/miembros/{id}/codigo-asistencia (miembros.ver)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="160" width="400" height="70" as="geometry" /></mxCell><mxCell id="fotocheck-6" value="&lt;b&gt;2. AsistenciaMiembroService.codigo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;si no tiene código, lo genera y guarda&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="160" width="420" height="70" as="geometry" /></mxCell><mxCell id="fotocheck-7" value="&lt;b&gt;GeneradorCodigoAsistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;12 caracteres en base 32 de Crockford (sin I, L, O ni U)&lt;br&gt;SecureRandom · MiembrosParaAsistencia reintenta (máx. 5) si choca con el índice único&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1460" y="160" width="380" height="80" as="geometry" /></mxCell><mxCell id="fotocheck-8" value="&lt;b&gt;miembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;codigo_asistencia VARCHAR(16)&lt;br&gt;ux (iglesia_id, codigo_asistencia)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1460" y="290" width="380" height="85" as="geometry" /></mxCell><mxCell id="fotocheck-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-5" target="fotocheck-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-6" target="fotocheck-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-7" target="fotocheck-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-12" value="&lt;b&gt;CodigoAsistenciaResponse&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ codigo: &quot;7K2QM9XDR4TB&quot;, contenidoQr: &quot;ASIS:7K2QM9XDR4TB&quot; }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="290" width="420" height="70" as="geometry" /></mxCell><mxCell id="fotocheck-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-6" target="fotocheck-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-14" value="&lt;b&gt;3. FotocheckComponent (shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CR80 horizontal · logo y nombre comercial con tipografía de marca&lt;br&gt;nombre, nivel · QR ≥ 25 mm · código «7K2Q M9XD R4TB»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="290" width="400" height="90" as="geometry" /></mxCell><mxCell id="fotocheck-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-12" target="fotocheck-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-16" value="&lt;b&gt;generarQr (qrcode)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;negro sobre blanco aunque haya modo oscuro&lt;br&gt;margen de 4 módulos · 600 px&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="290" width="400" height="90" as="geometry" /></mxCell><mxCell id="fotocheck-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-14" target="fotocheck-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-18" value="&lt;b&gt;Descargar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;crearImagenFotocheck → PNG 1011 × 638 (300 ppp)&lt;br&gt;fotocheck-nombres-apellidos.png&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="440" width="270" height="80" as="geometry" /></mxCell><mxCell id="fotocheck-19" value="&lt;b&gt;Compartir&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;navigator.share con el archivo (celulares)&lt;br&gt;si no se puede, solo «Descargar»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="345" y="440" width="270" height="80" as="geometry" /></mxCell><mxCell id="fotocheck-20" value="&lt;b&gt;Imprimir&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;abre /imprimir/fotochecks?ids=… en otra pestaña&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="630" y="440" width="270" height="80" as="geometry" /></mxCell><mxCell id="fotocheck-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-14" target="fotocheck-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-14" target="fotocheck-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-14" target="fotocheck-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-24" value="&lt;b&gt;4. Regenerar código&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembros.editar · confirmación «El fotocheck y la imagen&lt;br&gt;actuales dejarán de funcionar» · POST …/codigo-asistencia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="580" width="400" height="90" as="geometry" /></mxCell><mxCell id="fotocheck-25" value="&lt;b&gt;Nuevo código&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;el anterior deja de existir: escanearlo da&lt;br&gt;«Código no encontrado en esta iglesia»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="580" width="420" height="80" as="geometry" /></mxCell><mxCell id="fotocheck-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-24" target="fotocheck-25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-27" value="&lt;b&gt;5. Listado › «Imprimir fotochecks (45)»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;con los filtros actuales · deshabilitado sobre 500&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="720" width="400" height="70" as="geometry" /></mxCell><mxCell id="fotocheck-28" value="&lt;b&gt;GET /api/miembros/fotochecks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MiembroService.fotochecks(filtro): mismo criterio del listado&lt;br&gt;genera los códigos que falten · 400 si son más de 500&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1000" y="720" width="480" height="80" as="geometry" /></mxCell><mxCell id="fotocheck-29" value="&lt;b&gt;ImprimirFotochecksComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hojas A4 · 10 por hoja (2 × 5) · líneas de corte&lt;br&gt;«Imprimir» → window.print() (también «Guardar como PDF»)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="500" y="820" width="400" height="85" as="geometry" /></mxCell><mxCell id="fotocheck-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-27" target="fotocheck-28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fotocheck-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="fotocheck-28" target="fotocheck-29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1144" y="862" /></Array></mxGeometry></mxCell><mxCell id="fotocheck-32" value="&lt;b&gt;¿Por qué un código y no el id?&lt;/b&gt;&lt;br&gt;El id es secuencial y adivinable; el código es aleatorio, único por iglesia y regenerable si se pierde o se comparte un fotocheck. El prefijo &lt;code&gt;ASIS:&lt;/code&gt; evita marcar con cualquier otro QR." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1460" y="400" width="380" height="130" as="geometry" /></mxCell><mxCell id="fotocheck-33" value="&lt;b&gt;Sin librería de PDF&lt;/b&gt;&lt;br&gt;La impresión usa la del navegador y las variantes &lt;code&gt;print:&lt;/code&gt; de Tailwind: no hay CSS propio ni dependencias extra." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1500" y="830" width="340" height="90" as="geometry" /></mxCell><mxCell id="fotocheck-34" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="60" y="860" width="230" height="190" as="geometry" /></mxCell><mxCell id="fotocheck-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="72" y="894" width="28" height="20" as="geometry" /></mxCell><mxCell id="fotocheck-36" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="108" y="890" width="175" height="28" as="geometry" /></mxCell><mxCell id="fotocheck-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="72" y="924" width="28" height="20" as="geometry" /></mxCell><mxCell id="fotocheck-38" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="108" y="920" width="175" height="28" as="geometry" /></mxCell><mxCell id="fotocheck-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="72" y="954" width="28" height="20" as="geometry" /></mxCell><mxCell id="fotocheck-40" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="108" y="950" width="175" height="28" as="geometry" /></mxCell><mxCell id="fotocheck-41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="72" y="984" width="28" height="20" as="geometry" /></mxCell><mxCell id="fotocheck-42" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="108" y="980" width="175" height="28" as="geometry" /></mxCell><mxCell id="fotocheck-43" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="72" y="1014" width="28" height="20" as="geometry" /></mxCell><mxCell id="fotocheck-44" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="108" y="1010" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="seguimiento" name="5. Seguimiento de asistencia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="seguimiento-1" value="&lt;b&gt;Seguimiento de asistencia: quién está faltando y cómo evoluciona&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="seguimiento-2" value="Las ocasiones de cada persona se arman en una sola consulta (CTE) y las alertas se calculan al leer, con las reglas de la iglesia. Nada se guarda: siempre refleja la última marca." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="seguimiento-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="760" height="1260" as="geometry" /></mxCell><mxCell id="seguimiento-4" value="Contrato HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="820" y="110" width="380" height="1260" as="geometry" /></mxCell><mxCell id="seguimiento-5" value="iglesia-api · asistencia/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1230" y="110" width="940" height="1260" as="geometry" /></mxCell><mxCell id="seguimiento-6" value="&lt;b&gt;Ficha › AsistenciaMiembroComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;IndicadoresAsistencia (%, tendencia, faltas, última vez)&lt;br&gt;EtiquetasAlerta · SemanasAsistencia (12 celdas)&lt;br&gt;«Ver seguimiento»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="360" height="90" as="geometry" /></mxCell><mxCell id="seguimiento-7" value="&lt;b&gt;/miembros/:id/asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SeguimientoAsistenciaMiembroComponent&lt;br&gt;GraficoEvolucion (barras apiladas asistió/faltó)&lt;br&gt;TablaOcasiones (servidor) · filtro Todas/Asistió/Faltó&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="270" width="360" height="90" as="geometry" /></mxCell><mxCell id="seguimiento-8" value="&lt;b&gt;Detalle del grupo › AsistenciaGrupoComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GraficoEvolucion (línea: % de integrantes)&lt;br&gt;TablaSeguimiento local, ordenada por riesgo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="400" width="360" height="80" as="geometry" /></mxCell><mxCell id="seguimiento-9" value="&lt;b&gt;/asistencia/seguimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SeguimientoAsistenciaComponent (p-tabs)&lt;br&gt;«Personas»: FiltrosSeguimiento + TablaSeguimiento (servidor)&lt;br&gt;«Servicios» (asistencia.ver): ServiciosSeguimiento&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="520" width="360" height="90" as="geometry" /></mxCell><mxCell id="seguimiento-10" value="&lt;b&gt;Horarios de culto › FormularioReglas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;faltas seguidas 2–10 · caída 10–80 pts · nuevo 30–180 días&lt;br&gt;formulario reactivo tipado, mensajes junto al campo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="650" width="360" height="80" as="geometry" /></mxCell><mxCell id="seguimiento-11" value="&lt;b&gt;SeguimientoService (fachada HTTP)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ocasiones · lista · conteos · delGrupo · servicios&lt;br&gt;reglas · guardarReglas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="440" y="400" width="330" height="80" as="geometry" /></mxCell><mxCell id="seguimiento-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-7" target="seguimiento-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-8" target="seguimiento-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-9" target="seguimiento-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-10" target="seguimiento-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-16" value="Ver seguimiento" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-6" target="seguimiento-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-17" value="clic en la fila" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-9" target="seguimiento-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="38" y="565" /><mxPoint x="38" y="315" /></Array></mxGeometry></mxCell><mxCell id="seguimiento-18" value="&lt;b&gt;GET /api/miembros/{id}/asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;resumen ampliado de la ficha&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="150" width="340" height="70" as="geometry" /></mxCell><mxCell id="seguimiento-19" value="&lt;b&gt;GET /api/miembros/{id}/asistencia/ocasiones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;desde · hasta · estado · page · size&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="240" width="340" height="70" as="geometry" /></mxCell><mxCell id="seguimiento-20" value="&lt;b&gt;GET /api/grupos/{id}/seguimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;12 semanas + integrantes por riesgo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="400" width="340" height="70" as="geometry" /></mxCell><mxCell id="seguimiento-21" value="&lt;b&gt;GET /api/seguimiento-asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;alerta · grupoId · q · todos · page · size&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="520" width="340" height="70" as="geometry" /></mxCell><mxCell id="seguimiento-22" value="&lt;b&gt;GET /api/seguimiento-asistencia/conteos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cantidades para los filtros&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="610" width="340" height="70" as="geometry" /></mxCell><mxCell id="seguimiento-23" value="&lt;b&gt;GET /api/seguimiento-asistencia/servicios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cultos, días de culto y grupos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="700" width="340" height="70" as="geometry" /></mxCell><mxCell id="seguimiento-24" value="&lt;b&gt;GET · PUT /api/configuracion-seguimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reglas de la iglesia · 400 fuera de límites&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="790" width="340" height="70" as="geometry" /></mxCell><mxCell id="seguimiento-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-6" target="seguimiento-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-11" target="seguimiento-21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-27" value="&lt;b&gt;AsistenciaMiembroController · SeguimientoAsistenciaController · ConfiguracionSeguimientoController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;solo HTTP: @Valid, permisos (@PreAuthorize) y delegar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1260" y="150" width="880" height="60" as="geometry" /></mxCell><mxCell id="seguimiento-28" value="&lt;b&gt;SeguimientoAsistenciaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;delMiembro · ocasiones · lista · conteos · delGrupo · servicios&lt;br&gt;enriquece nombres con MiembrosParaAsistencia y AgendaGrupos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1260" y="250" width="430" height="80" as="geometry" /></mxCell><mxCell id="seguimiento-29" value="&lt;b&gt;AmbitoAsistencia.paraSeguimiento()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;asistencia.ver → toda la iglesia&lt;br&gt;asistencia.grupo → su red · otro → 404&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1720" y="250" width="420" height="80" as="geometry" /></mxCell><mxCell id="seguimiento-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-27" target="seguimiento-28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-28" target="seguimiento-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-21" target="seguimiento-27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="555" /><mxPoint x="1215" y="180" /></Array></mxGeometry></mxCell><mxCell id="seguimiento-33" value="&lt;b&gt;SeguimientoRepository (nativa, CTE)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;red (recursiva) → personas → dias_culto ∪ reuniones del grupo&lt;br&gt;→ ocasiones × asistencia → semanas (16)&lt;br&gt;iglesia_id filtrado en cada paso, también el recursivo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1260" y="370" width="430" height="100" as="geometry" /></mxCell><mxCell id="seguimiento-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-28" target="seguimiento-33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-35" value="&lt;b&gt;IndicadoresMiembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ultimas4 · ultimas8 · semanas5a12 · semanas9a16&lt;br&gt;faltasSeguidas · ultimaAsistencia · diasAsistidos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1720" y="370" width="420" height="100" as="geometry" /></mxCell><mxCell id="seguimiento-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-33" target="seguimiento-35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-37" value="&lt;b&gt;TipoAlerta (enum Strategy)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;FALTAS_SEGUIDAS ≥ N&lt;br&gt;NUEVO_SIN_VOLVER: nuevo o ≤ D días, ingresó hace ≥ 14,&lt;br&gt;≤ 2 días asistidos, no vino en 14 días&lt;br&gt;ASISTENCIA_EN_CAIDA: antes ≥ 50 % y baja ≥ P pts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1720" y="510" width="420" height="120" as="geometry" /></mxCell><mxCell id="seguimiento-38" value="&lt;b&gt;MiembroEvaluado.POR_RIESGO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;gravedad (orden del enum) → faltas seguidas ↓&lt;br&gt;→ porcentaje ↑ (sin datos al final) → id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1720" y="670" width="420" height="80" as="geometry" /></mxCell><mxCell id="seguimiento-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-35" target="seguimiento-37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-37" target="seguimiento-38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-41" value="&lt;b&gt;ConfiguracionSeguimientoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reglas(): fila de la iglesia o valores por defecto (3 · 30 · 90)&lt;br&gt;guardar(): log INFO con iglesiaId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1260" y="510" width="430" height="80" as="geometry" /></mxCell><mxCell id="seguimiento-42" value="ReglasSeguimiento" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-41" target="seguimiento-37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-43" value="&lt;b&gt;PageImpl en memoria&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;filtra alerta/grupo/nombre, ordena por riesgo y pagina&lt;br&gt;sobre el resultado de UNA consulta&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1260" y="630" width="430" height="80" as="geometry" /></mxCell><mxCell id="seguimiento-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="seguimiento-38" target="seguimiento-43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seguimiento-45" value="&lt;b&gt;reunion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tipo · fecha · grupo_id&lt;br&gt;ix_reunion_tipo_fecha (V10)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1260" y="790" width="200" height="90" as="geometry" /></mxCell><mxCell id="seguimiento-46" value="&lt;b&gt;asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reunion_id · miembro_id&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1480" y="790" width="200" height="90" as="geometry" /></mxCell><mxCell id="seguimiento-47" value="&lt;b&gt;miembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lider_id · grupo_id · fecha_ingreso&lt;br&gt;condicion · activo&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1700" y="790" width="200" height="90" as="geometry" /></mxCell><mxCell id="seguimiento-48" value="&lt;b&gt;configuracion_seguimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;faltas_seguidas · puntos_caida&lt;br&gt;dias_nuevo (V10, RLS)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1920" y="790" width="220" height="90" as="geometry" /></mxCell><mxCell id="seguimiento-49" value="&lt;b&gt;Qué cuenta como ocasión&lt;/b&gt;&lt;br&gt;• Todas las reuniones de culto de una fecha = &lt;b&gt;un día de culto&lt;/b&gt; (ir a uno de los dos servicios del domingo es asistir ese domingo).&lt;br&gt;• Cada reunión de su grupo &lt;b&gt;actual&lt;/b&gt; = una ocasión.&lt;br&gt;• Eventos: nunca son falta; si fue, aparece como EXTRA.&lt;br&gt;• Solo desde su fecha de ingreso (o registro) y mientras esté activo.&lt;br&gt;• Hoy: solo cuenta si ya asistió (la reunión en curso no es falta).&lt;br&gt;• Semanas de lunes a domingo; se analizan 16 y se muestran 12." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="780" width="720" height="170" as="geometry" /></mxCell><mxCell id="seguimiento-50" value="&lt;b&gt;¿Por qué calcular y no guardar las alertas?&lt;/b&gt;&lt;br&gt;Siempre están al día con la última marca y no hacen falta tareas programadas. Si el volumen crece, se pueden materializar sin cambiar la API." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="980" width="350" height="110" as="geometry" /></mxCell><mxCell id="seguimiento-51" value="&lt;b&gt;Lista para el líder&lt;/b&gt;&lt;br&gt;Con asistencia.grupo la misma pantalla muestra solo su red (CTE recursiva desde su miembroId del JWT): es su lista de a quién llamar." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="420" y="980" width="350" height="110" as="geometry" /></mxCell><mxCell id="seguimiento-52" value="&lt;b&gt;Servicios&lt;/b&gt;&lt;br&gt;La tabla resume las semanas cerradas: la actual va por la mitad y bajaría el promedio. La variación compara la semana pasada con el promedio de las anteriores (en puntos para los porcentajes)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="840" y="900" width="340" height="140" as="geometry" /></mxCell><mxCell id="seguimiento-53" value="&lt;b&gt;Grillas&lt;/b&gt;&lt;br&gt;Lista y ocasiones: paginadas en el servidor. Integrantes del grupo: en el navegador. Todas con el paginador siempre visible y la configuración común." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1260" y="920" width="430" height="90" as="geometry" /></mxCell><mxCell id="seguimiento-54" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1920" y="920" width="230" height="190" as="geometry" /></mxCell><mxCell id="seguimiento-55" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1932" y="954" width="28" height="20" as="geometry" /></mxCell><mxCell id="seguimiento-56" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1968" y="950" width="175" height="28" as="geometry" /></mxCell><mxCell id="seguimiento-57" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1932" y="984" width="28" height="20" as="geometry" /></mxCell><mxCell id="seguimiento-58" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1968" y="980" width="175" height="28" as="geometry" /></mxCell><mxCell id="seguimiento-59" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1932" y="1014" width="28" height="20" as="geometry" /></mxCell><mxCell id="seguimiento-60" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1968" y="1010" width="175" height="28" as="geometry" /></mxCell><mxCell id="seguimiento-61" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1932" y="1044" width="28" height="20" as="geometry" /></mxCell><mxCell id="seguimiento-62" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1968" y="1040" width="175" height="28" as="geometry" /></mxCell><mxCell id="seguimiento-63" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1932" y="1074" width="28" height="20" as="geometry" /></mxCell><mxCell id="seguimiento-64" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1968" y="1070" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
