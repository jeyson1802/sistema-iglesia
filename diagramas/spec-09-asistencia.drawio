<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arquitectura" name="1. Arquitectura de la asistencia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arquitectura-1" value="&lt;b&gt;Arquitectura: asistencia a cultos, eventos y grupos&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-2" value="Pantallas y componentes del frontend, servicios REST que consumen, clases de iglesia-api que los atienden y tablas que leen o escriben." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-3" value="iglesia-web · features/asistencia (+ miembros y grupos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="820" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-4" value="Contrato HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="880" y="110" width="360" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-5" value="iglesia-api · paquete asistencia/ (+ miembros y grupos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1270" y="110" width="900" height="1360" as="geometry" /></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;Rutas (/asistencia, hijas de AppLayout)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&#x27;&#x27; → inicio (registrar | grupo | ver)&lt;br&gt;reuniones/:id → tomar asistencia (carga diferida: qr-scanner)&lt;br&gt;reuniones/:id/detalle · configuracion (asistencia.configurar)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="520" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-7" value="&lt;b&gt;Menú&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Iglesia › Asistencia (pi-check-square)&lt;br&gt;Administración › Horarios de culto (pi-clock)&lt;br&gt;permisoGuard(...permisos): basta uno&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="590" y="150" width="240" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-8" value="&lt;b&gt;AsistenciaInicioComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Hoy»: TarjetaReunionHoy por reunión&lt;br&gt;Historial: FiltrosReuniones + TablaReuniones (servidor)&lt;br&gt;FormularioEvento · AbrirOtraFecha&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="260" width="380" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-9" value="&lt;b&gt;TomarAsistenciaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;modos Cámara · Lector · Manual&lt;br&gt;contador · ResultadoMarca · UltimasMarcas&lt;br&gt;ListaIntegrantes (grupos) · AyudaEquipos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="260" width="380" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-10" value="&lt;b&gt;DetalleReunionComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;total · TablaAsistentes (servidor, búsqueda)&lt;br&gt;eliminar evento vacío&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="380" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;ConfiguracionAsistenciaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;TablaCultos (local) · FormularioCulto&lt;br&gt;día L M M J V S D · hora&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="380" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-12" value="&lt;b&gt;EscanerCamara → CamaraQr&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;adaptador de qr-scanner (worker, BarcodeDetector)&lt;br&gt;cámara trasera · cambiar · linterna&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="480" width="380" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-13" value="&lt;b&gt;ProcesadorCodigos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ASIS:… válido · ignora el mismo código 3 s&lt;br&gt;olvidar() tras «Deshacer»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="570" width="380" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-14" value="&lt;b&gt;AvisosMarca · PantallaEncendida · EstadoConexion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;WebAudio + vibrate · Wake Lock · online/offline&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="650" width="380" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-9" target="arquitectura-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-12" target="arquitectura-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-13" target="arquitectura-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-18" value="&lt;b&gt;Ficha del miembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CodigoAsistenciaMiembro: fotocheck + Descargar · Compartir · Imprimir · Regenerar&lt;br&gt;AsistenciaMiembro: %, tendencia, alertas, 12 semanas · «Ver seguimiento»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="750" width="520" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-19" value="&lt;b&gt;ImprimirFotochecksComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/imprimir/fotochecks (fuera del layout)&lt;br&gt;A4 · 10 por hoja · print:&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="590" y="750" width="240" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-20" value="&lt;b&gt;Detalle del grupo · AsistenciaGrupo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;últimas 8 reuniones en barras&lt;br&gt;«Tomar asistencia de hoy» / «de otra fecha»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="850" width="520" height="65" as="geometry" /></mxCell><mxCell id="arquitectura-21" value="&lt;b&gt;Fotocheck (shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CR80 85,6 × 54 mm · QR negro sobre blanco&lt;br&gt;generarQr (qrcode) · crearImagenFotocheck (PNG 300 ppp)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="590" y="850" width="240" height="65" as="geometry" /></mxCell><mxCell id="arquitectura-22" value="&lt;b&gt;ReunionesService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hoy · abrir · crearEvento · eliminarEvento&lt;br&gt;historial · ultimasDeGrupo · obtener&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="950" width="380" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-23" value="&lt;b&gt;AsistenciasService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;marcarPorCodigo · marcarMiembro · quitar&lt;br&gt;asistentes · integrantes · buscarMiembros · resumenMiembro&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="950" width="380" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-24" value="&lt;b&gt;CultosProgramadosService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · crear · actualizar · cambiarEstado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="1030" width="380" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-25" value="&lt;b&gt;MiembrosService (miembros)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;codigoAsistencia · regenerar · fotochecks(filtro)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="450" y="1030" width="380" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-26" value="&lt;b&gt;Contenedor / presentacional&lt;/b&gt;&lt;br&gt;Las páginas orquestan y llaman a los servicios; los componentes de la pantalla de escaneo solo reciben datos y emiten eventos. La cámara va detrás de &lt;code&gt;CamaraQr&lt;/code&gt; para poder reemplazarla en las pruebas." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="1110" width="380" height="120" as="geometry" /></mxCell><mxCell id="arquitectura-27" value="&lt;b&gt;Sin colores fijos salvo el resultado&lt;/b&gt;&lt;br&gt;La franja verde / ámbar / roja usa colores fuertes para leerse de lejos, siempre con ícono y texto y anunciada con &lt;code&gt;aria-live&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="450" y="1110" width="380" height="120" as="geometry" /></mxCell><mxCell id="arquitectura-28" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="50" y="1260" width="230" height="220" as="geometry" /></mxCell><mxCell id="arquitectura-29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="62" y="1294" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-30" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1290" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1" ><mxGeometry x="62" y="1324" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-32" value="Rutas y guards" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1320" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="62" y="1354" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-34" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1350" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="62" y="1384" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-36" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1380" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="62" y="1414" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-38" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1410" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="62" y="1444" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-40" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="98" y="1440" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-41" value="&lt;b&gt;GET · POST · PUT · PATCH /api/cultos-programados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;asistencia.configurar (listar también registrar)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="150" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-42" value="&lt;b&gt;GET /api/reuniones/hoy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cultos del día · eventos de hoy · grupos del día&lt;br&gt;según el ámbito (líder: sus grupos)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="255" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-43" value="&lt;b&gt;POST /api/reuniones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;201 creada · 200 ya existía (idempotente)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="360" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-44" value="&lt;b&gt;POST /api/reuniones/eventos · DELETE /{id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;una reunión por día (máx. 7) · borrar solo sin asistentes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="465" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-45" value="&lt;b&gt;GET /api/reuniones?desde&amp;hasta&amp;tipo&amp;grupoId&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Page&amp;lt;ReunionResponse&amp;gt; · asistencia.ver o grupo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="570" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-46" value="&lt;b&gt;POST /api/reuniones/{id}/asistencias/codigo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MarcaResponse: nuevo o yaRegistrado + total&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="675" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-47" value="&lt;b&gt;POST · DELETE /api/reuniones/{id}/asistencias&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;marcar a mano · quitar (Deshacer)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="780" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-48" value="&lt;b&gt;GET /{id}/asistentes · integrantes · miembros?q&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;paginado · grupo · búsqueda sin miembros.ver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="885" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-49" value="&lt;b&gt;GET /api/miembros/{id}/asistencia · codigo-asistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;resumen 8 semanas · código (POST regenera)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="990" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-50" value="&lt;b&gt;GET /api/miembros/fotochecks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;mismos filtros del listado · tope 500&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="895" y="1095" width="330" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-51" value="&lt;b&gt;CultoProgramadoController · Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre único por iglesia · no se borra: se desactiva&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="150" width="420" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-52" value="&lt;b&gt;ReunionController → ReunionService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hoy · abrir (INSERT … ON CONFLICT DO NOTHING) · crearEvento&lt;br&gt;historial (EspecificacionesReunion) · obtener&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="290" width="420" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-53" value="&lt;b&gt;AsistenciaController → AsistenciaService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;marcarPorCodigo · marcarMiembro · quitar&lt;br&gt;asistentes · integrantes · buscarMiembros&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="650" width="420" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-54" value="&lt;b&gt;AsistenciaMiembroController → AsistenciaMiembroService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;resumen (porcentaje en la base) · código · regenerar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="960" width="420" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-55" value="&lt;b&gt;MiembroController.fotochecks → MiembroService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;criterio(filtro) compartido con el listado&lt;br&gt;genera los códigos que falten&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1290" y="1100" width="420" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-56" value="&lt;b&gt;AmbitoAsistencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;quién puede marcar o ver cada reunión&lt;br&gt;líder: solo sus grupos · fuera de ámbito → 404&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1740" y="470" width="400" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-57" value="&lt;b&gt;AgendaGrupos (grupos)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;grupos que se reúnen un día de la semana&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1740" y="290" width="400" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-58" value="&lt;b&gt;MiembrosParaAsistencia · GeneradorCodigoAsistencia (miembros)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;buscar por código · 12 caracteres sin ambiguos&lt;br&gt;(base 32 de Crockford: sin I, L, O ni U) · único por iglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1740" y="800" width="400" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-41" target="arquitectura-51"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-42" target="arquitectura-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-43" target="arquitectura-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-44" target="arquitectura-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeCo