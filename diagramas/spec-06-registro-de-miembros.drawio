#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-48" target="arquitectura-78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-49" target="arquitectura-79"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="arquitectura-62" target="arquitectura-75"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-84" value="&lt;b&gt;nivel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;orden · activo&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1600" y="790" width="150" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-85" value="&lt;b&gt;grupo · configuracion_iglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lider_id · anfitrion_id&lt;br&gt;nombre singular/plural&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1580" y="880" width="180" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-86" value="&lt;b&gt;ubigeo_*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;departamento · provincia · distrito&lt;br&gt;(global, sin iglesia_id)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1580" y="985" width="180" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-77" target="arquitectura-84"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-78" target="arquitectura-85"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-79" target="arquitectura-86"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-90" value="&lt;b&gt;Dependencia invertida&lt;/b&gt;&lt;br&gt;miembros define la interfaz &lt;code&gt;ConsultaGrupos&lt;/code&gt; y grupos la implementa; grupos usa &lt;code&gt;ReferenciasMiembro&lt;/code&gt;. Miembro guarda &lt;code&gt;grupoId&lt;/code&gt; (Long) y Grupo &lt;code&gt;liderId&lt;/code&gt;: ningún paquete importa entidades del otro." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1230" y="1080" width="520" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-91" value="&lt;b&gt;Aislamiento&lt;/b&gt;&lt;br&gt;nivel, miembro, grupo y configuracion_iglesia llevan &lt;code&gt;iglesia_id&lt;/code&gt;: &lt;code&gt;@TenantId&lt;/code&gt; + RLS. Las FK compuestas &lt;code&gt;(iglesia_id, id)&lt;/code&gt; impiden referenciar filas de otra iglesia. Las CTE filtran &lt;code&gt;iglesia_id&lt;/code&gt; también en el paso recursivo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1790" y="150" width="310" height="150" as="geometry" /></mxCell><mxCell id="arquitectura-92" value="&lt;b&gt;Ubigeo común&lt;/b&gt;&lt;br&gt;Catálogo INEI (25 departamentos, 196 provincias, 1892 distritos) en V4. No lleva &lt;code&gt;iglesia_id&lt;/code&gt;: es igual para todas las iglesias y solo se lee." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1790" y="320" width="310" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-93" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1790" y="460" width="230" height="250" as="geometry" /></mxCell><mxCell id="arquitectura-94" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1802" y="494" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-95" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1838" y="490" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-96" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1" ><mxGeometry x="1802" y="524" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-97" value="Rutas y guards" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1838" y="520" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-98" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1802" y="554" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-99" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1838" y="550" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-100" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1802" y="584" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-101" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1838" y="580" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-102" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1802" y="614" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-103" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1838" y="610" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-104" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1802" y="644" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-105" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1838" y="640" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-106" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1802" y="674" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-107" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1838" y="670" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="alta" name="2. Alta de un miembro con aviso de duplicados"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="alta-1" value="&lt;b&gt;Alta de un miembro&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="alta-2" value="Solo nombres y apellidos son obligatorios. Antes de crear se avisa si ya existe alguien igual; el usuario decide." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="alta-3" value="&lt;b&gt;1. FormularioMiembroComponent emite GuardarMiembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Guardar» se habilita con nombres y apellidos válidos&lt;br&gt;textos vacíos → null · fecha o edad (excluyentes)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="130" width="420" height="80" as="geometry" /></mxCell><mxCell id="alta-4" value="&lt;b&gt;2. GET /api/miembros/posibles-duplicados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;?nombres=Juan&amp;apellidos=Pérez (miembros.crear)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="250" width="420" height="65" as="geometry" /></mxCell><mxCell id="alta-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="alta-3" target="alta-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-6" value="&lt;b&gt;MiembroService.posiblesDuplicados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;filtro por largo en SQL + comparación en Java&lt;br&gt;(Textos.mismoTexto: sin mayúsculas, tildes ni espacios sobrantes)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="530" y="245" width="400" height="75" as="geometry" /></mxCell><mxCell id="alta-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-4" target="alta-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-8" value="&lt;b&gt;Hay coincidencias → p-confirmdialog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Ya existe alguien con los mismos nombres y apellidos: «Juan Pérez»…&lt;br&gt;¿Registrar de todas formas?» · Cancelar no crea nada&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="530" y="360" width="400" height="75" as="geometry" /></mxCell><mxCell id="alta-9" value="[ … ]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-4" target="alta-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="376" y="397" /></Array></mxGeometry></mxCell><mxCell id="alta-10" value="&lt;b&gt;3. POST /api/miembros&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sin coincidencias, o tras confirmar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="470" width="420" height="60" as="geometry" /></mxCell><mxCell id="alta-11" value="[ ]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-4" target="alta-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-12" value="Registrar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-8" target="alta-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="500" /></Array></mxGeometry></mxCell><mxCell id="alta-13" value="&lt;b&gt;MiembroService.crear&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Bean Validation (400) · fecha y edad excluyentes&lt;br&gt;UbigeoService.validarDistrito · NivelService.asignable&lt;br&gt;ReferenciasMiembro.validarAsignable (líder, invitador, registrador)&lt;br&gt;ConsultaGrupos (grupo activo) · PoliticaJerarquia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="530" y="460" width="420" height="105" as="geometry" /></mxCell><mxCell id="alta-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-10" target="alta-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-15" value="&lt;b&gt;miembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;INSERT · iglesia_id lo pone Hibernate&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1010" y="470" width="200" height="85" as="geometry" /></mxCell><mxCell id="alta-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-13" target="alta-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-17" value="&lt;b&gt;400 / 409 con errores por campo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ errores: { liderId: «…» } } → mensaje junto al campo&lt;br&gt;sin campo → mensaje sobre el formulario&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="530" y="600" width="420" height="70" as="geometry" /></mxCell><mxCell id="alta-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-10" target="alta-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="376" y="635" /></Array></mxGeometry></mxCell><mxCell id="alta-19" value="&lt;b&gt;4. 201 + Location → navegar a /miembros/{id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;replaceUrl · estado { registrado: true }&lt;br&gt;la ficha nueva muestra el toast «Miembro registrado»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="720" width="420" height="80" as="geometry" /></mxCell><mxCell id="alta-20" value="201" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="alta-10" target="alta-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-21" value="&lt;b&gt;5. La ficha guardada&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ProgresoFichaComponent: % y datos que faltan&lt;br&gt;CadenaLiderazgoComponent · «Dar acceso al sistema»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="840" width="420" height="80" as="geometry" /></mxCell><mxCell id="alta-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="alta-19" target="alta-21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="alta-23" value="&lt;b&gt;¿Por qué se compara en Java?&lt;/b&gt;&lt;br&gt;&lt;code&gt;lower()&lt;/code&gt;/&lt;code&gt;upper()&lt;/code&gt; de PostgreSQL dependen de la configuración regional de la base: «PÉREZ» y «pérez» podían no coincidir. La consulta trae candidatos con el mismo largo y la comparación final la hace &lt;code&gt;Textos&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1010" y="130" width="400" height="130" as="geometry" /></mxCell><mxCell id="alta-24" value="&lt;b&gt;El aviso no bloquea&lt;/b&gt;&lt;br&gt;Una familia puede tener dos personas con el mismo nombre. Por eso es una confirmación y no un 409. Si la comprobación falla, el alta sigue." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1010" y="290" width="400" height="100" as="geometry" /></mxCell><mxCell id="alta-25" value="&lt;b&gt;Log sin datos personales&lt;/b&gt;&lt;br&gt;INFO «Miembro registrado id={} por usuarioId={}»: nunca nombres, teléfonos ni correos." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1010" y="600" width="400" height="75" as="geometry" /></mxCell><mxCell id="alta-26" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1450" y="130" width="230" height="220" as="geometry" /></mxCell><mxCell id="alta-27" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1462" y="164" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-28" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="160" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1462" y="194" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-30" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="190" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1462" y="224" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-32" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="220" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1462" y="254" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-34" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="250" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1462" y="284" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-36" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="280" width="175" height="28" as="geometry" /></mxCell><mxCell id="alta-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1462" y="314" width="28" height="20" as="geometry" /></mxCell><mxCell id="alta-38" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1498" y="310" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="jerarquia" name="3. Jerarquía: líder, ciclos y pastor principal"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="jerarquia-1" value="&lt;b&gt;Jerarquía de liderazgo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="jerarquia-2" value="Cada miembro tiene a lo sumo un líder; el pastor principal es el único sin líder. Nadie puede quedar como líder de su propio líder." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="jerarquia-3" value="Asignar o cambiar el líder (PUT /api/miembros/{id})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="120" width="820" height="520" as="geometry" /></mxCell><mxCell id="jerarquia-4" value="&lt;b&gt;1. El selector de líder excluye al propio miembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;app-selector-miembro [excluirId]=&quot;miembro.id&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="165" width="380" height="65" as="geometry" /></mxCell><mxCell id="jerarquia-5" value="&lt;b&gt;2. ReferenciasMiembro.validarAsignable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;mismo id → 400 · inexistente u otra iglesia → 409&lt;br&gt;inactivo → 409 (los ya asignados se conservan)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="260" width="380" height="75" as="geometry" /></mxCell><mxCell id="jerarquia-6" value="&lt;b&gt;3. PoliticaJerarquia: ¿el líder está en la red del miembro?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MiembroRepository.esDeLaRed(miembroId, liderId)&lt;br&gt;CTE recursiva desde el miembro hacia abajo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="365" width="380" height="80" as="geometry" /></mxCell><mxCell id="jerarquia-7" value="&lt;b&gt;4. Sin ciclo → se guarda lider_id&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;toda la red del miembro se mueve con él (no se toca a nadie más)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="475" width="380" height="65" as="geometry" /></mxCell><mxCell id="jerarquia-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="jerarquia-4" target="jerarquia-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="jerarquia-5" target="jerarquia-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="jerarquia-6" target="jerarquia-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-11" value="&lt;b&gt;409 «… forma parte de su red»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;errores.liderId → mensaje junto al selector de líder&lt;br&gt;no cambia nada (la transacción no escribe)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="490" y="375" width="340" height="70" as="geometry" /></mxCell><mxCell id="jerarquia-12" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="jerarquia-6" target="jerarquia-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-13" value="&lt;b&gt;El pastor principal no tiene líder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;liderId informado para el pastor → 409&lt;br&gt;en el formulario el selector queda deshabilitado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="490" y="475" width="340" height="70" as="geometry" /></mxCell><mxCell id="jerarquia-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="jerarquia-7" target="jerarquia-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-15" value="&lt;b&gt;Ejemplo de ciclo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Pastor → Ana → Luis → Rosa&lt;br&gt;Asignar a Rosa como líder de Ana: Rosa está en la red de Ana → 409&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="490" y="165" width="340" height="80" as="geometry" /></mxCell><mxCell id="jerarquia-16" value="Designar pastor principal (PUT /api/miembros/{id}/pastor-principal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="900" y="120" width="800" height="520" as="geometry" /></mxCell><mxCell id="jerarquia-17" value="&lt;b&gt;1. MiembroFichaComponent.designarPastor()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MiembrosService.pastorPrincipal()&lt;br&gt;GET /api/miembros?sort=pastorPrincipal,desc&amp;size=1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="930" y="165" width="400" height="75" as="geometry" /></mxCell><mxCell id="jerarquia-18" value="&lt;b&gt;2. p-confirmdialog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Ana reemplazará a «Pedro» como pastor principal.&lt;br&gt;Dejará de tener líder (hoy es Luis). ¿Continuar?»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="930" y="270" width="400" height="80" as="geometry" /></mxCell><mxCell id="jerarquia-19" value="&lt;b&gt;3. MiembroService.designarPastorPrincipal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;inactivo → 409&lt;br&gt;quita la marca al anterior (flush) · marca al nuevo&lt;br&gt;y le quita el líder&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="930" y="380" width="400" height="85" as="geometry" /></mxCell><mxCell id="jerarquia-20" value="&lt;b&gt;4. Respuesta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;la ficha muestra «Pastor principal» y oculta la cadena&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="930" y="500" width="400" height="65" as="geometry" /></mxCell><mxCell id="jerarquia-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="jerarquia-17" target="jerarquia-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-22" value="Designar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="jerarquia-18" target="jerarquia-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="jerarquia-19" target="jerarquia-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-24" value="&lt;b&gt;miembro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ux_miembro_pastor_principal&lt;br&gt;(único por iglesia, parcial)&lt;br&gt;CHECK: pastor ⇒ lider_id NULL&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1380" y="380" width="280" height="100" as="geometry" /></mxCell><mxCell id="jerarquia-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="jerarquia-19" target="jerarquia-24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-26" value="&lt;b&gt;La base respalda la regla&lt;/b&gt;&lt;br&gt;Si dos administradores designan a la vez, el índice único parcial rechaza el segundo: el servicio responde 409 «Otro usuario designó al pastor principal al mismo tiempo»." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1380" y="165" width="290" height="140" as="geometry" /></mxCell><mxCell id="jerarquia-27" value="Desactivar (PATCH /api/miembros/{id}/estado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="670" width="1660" height="300" as="geometry" /></mxCell><mxCell id="jerarquia-28" value="&lt;b&gt;PoliticaJerarquia.validarDesactivacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;es el pastor principal → 409&lt;br&gt;lidera miembros activos (countByLiderIdAndActivoTrue) → 409&lt;br&gt;lidera un grupo activo (ConsultaGrupos) → 409&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="720" width="460" height="95" as="geometry" /></mxCell><mxCell id="jerarquia-29" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pide confirmación · el 409 se muestra sobre la ficha&lt;br&gt;reactivar no pide confirmación&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="590" y="720" width="400" height="80" as="geometry" /></mxCell><mxCell id="jerarquia-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="jerarquia-29" target="jerarquia-28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jerarquia-31" value="&lt;b&gt;¿Por qué no se reasigna automáticamente?&lt;/b&gt;&lt;br&gt;Mover la red de alguien es una decisión pastoral. Se pide reasignar primero a sus liderados (o el grupo) y luego desactivar." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1050" y="720" width="420" height="95" as="geometry" /></mxCell><mxCell id="jerarquia-32" value="&lt;b&gt;Nivel ≠ líder&lt;/b&gt;&lt;br&gt;El nivel indica el rango (configurable); el líder, de quién depende. Son independientes, igual que el grupo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="70" y="850" width="460" height="80" as="geometry" /></mxCell><mxCell id="jerarquia-33" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1500" y="840" width="230" height="220" as="geometry" /></mxCell><mxCell id="jerarquia-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1512" y="874" width="28" height="20" as="geometry" /></mxCell><mxCell id="jerarquia-35" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="870" width="175" height="28" as="geometry" /></mxCell><mxCell id="jerarquia-36" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1512" y="904" width="28" height="20" as="geometry" /></mxCell><mxCell id="jerarquia-37" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="900" width="175" height="28" as="geometry" /></mxCell><mxCell id="jerarquia-38" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1512" y="934" width="28" height="20" as="geometry" /></mxCell><mxCell id="jerarquia-39" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="930" width="175" height="28" as="geometry" /></mxCell><mxCell id="jerarquia-40" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1512" y="964" width="28" height="20" as="geometry" /></mxCell><mxCell id="jerarquia-41" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="960" width="175" height="28" as="geometry" /></mxCell><mxCell id="jerarquia-42" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1512" y="994" width="28" height="20" as="geometry" /></mxCell><mxCell id="jerarquia-43" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="990" width="175" height="28" as="geometry" /></mxCell><mxCell id="jerarquia-44" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1512" y="1024" width="28" height="20" as="geometry" /></mxCell><mxCell id="jerarquia-45" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1548" y="1020" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ambito" name="4. Ámbito del líder: red y cadena con CTE"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ambito-1" value="&lt;b&gt;Qué ve un líder&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="ambito-2" value="AmbitoMiembros se calcula desde el token (roles y miembro_id), nunca desde parámetros del cliente." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="ambito-3" value="&lt;b&gt;JWT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;roles · permisos · iglesia_id · miembro_id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="130" width="300" height="60" as="geometry" /></mxCell><mxCell id="ambito-4" value="&lt;b&gt;UsuarioActual&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;rolesBase() · miembroId() · iglesia (IglesiaActual)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="230" width="300" height="65" as="geometry" /></mxCell><mxCell id="ambito-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-3" target="ambito-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-6" value="&lt;b&gt;AmbitoMiembros (MiembroService)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ADMIN_IGLESIA o sistema dentro de una iglesia → completo&lt;br&gt;LIDER con miembro_id → soloDe(red ∪ cadena ∪ él mismo)&lt;br&gt;otro caso con miembros.ver → ninguno&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="340" width="420" height="95" as="geometry" /></mxCell><mxCell id="ambito-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-4" target="ambito-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-8" value="&lt;b&gt;idsDeLaRed(iglesiaId, miembroId)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;WITH RECURSIVE red AS (&lt;br&gt;  SELECT id FROM miembro WHERE iglesia_id = :i AND lider_id = :m&lt;br&gt;  UNION SELECT h.id FROM miembro h JOIN red r ON h.lider_id = r.id&lt;br&gt;  WHERE h.iglesia_id = :i ) …&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="520" y="300" width="520" height="105" as="geometry" /></mxCell><mxCell id="ambito-9" value="&lt;b&gt;idsDeLaCadena(iglesiaId, miembroId)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;WITH RECURSIVE cadena AS ( … hacia arriba por lider_id …&lt;br&gt;  WHERE iglesia_id = :i ) CYCLE id SET ciclo USING ruta&lt;br&gt;ordenada del líder directo al pastor&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="520" y="430" width="520" height="95" as="geometry" /></mxCell><mxCell id="ambito-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-6" target="ambito-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-6" target="ambito-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-12" value="Efecto en los endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="580" width="1000" height="330" as="geometry" /></mxCell><mxCell id="ambito-13" value="&lt;b&gt;GET /api/miembros&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Specification + id IN (ámbito): solo su red, sus superiores y él&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="625" width="440" height="60" as="geometry" /></mxCell><mxCell id="ambito-14" value="&lt;b&gt;GET /api/miembros/{id} · /cadena&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fuera del ámbito → 404 (no revela que existe)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="540" y="625" width="470" height="60" as="geometry" /></mxCell><mxCell id="ambito-15" value="&lt;b&gt;GET /api/miembros/opciones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;mismas restricciones: solo ofrece a quien puede ver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="710" width="440" height="60" as="geometry" /></mxCell><mxCell id="ambito-16" value="&lt;b&gt;POST · PUT · PATCH&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;exigen miembros.crear/editar/desactivar → el LIDER recibe 403&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="540" y="710" width="470" height="60" as="geometry" /></mxCell><mxCell id="ambito-17" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sin «Nuevo miembro» · fichas en solo lectura · sin acciones&lt;br&gt;menú: solo «Miembros»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="800" width="940" height="70" as="geometry" /></mxCell><mxCell id="ambito-18" value="&lt;b&gt;Ejemplo&lt;/b&gt;&lt;br&gt;Pastor → Ana → &lt;b&gt;Luis&lt;/b&gt; → Rosa → Tito&lt;br&gt;Luis (LIDER) ve: Luis, Rosa, Tito (red) y Ana, Pastor (cadena). No ve a los hermanos de Rosa que dependen de Ana." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1090" y="130" width="400" height="110" as="geometry" /></mxCell><mxCell id="ambito-19" value="&lt;b&gt;Dos barreras más&lt;/b&gt;&lt;br&gt;Además del filtro por &lt;code&gt;iglesia_id&lt;/code&gt; en las CTE, Hibernate (@TenantId) y la RLS de PostgreSQL impiden leer otra iglesia aunque una consulta olvidara el filtro." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1090" y="270" width="400" height="110" as="geometry" /></mxCell><mxCell id="ambito-20" value="&lt;b&gt;Nada en memoria&lt;/b&gt;&lt;br&gt;La red se resuelve en una sola consulta recursiva; no hay recorridos en Java ni consultas en bucle (CLAUDE.md)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1090" y="410" width="400" height="90" as="geometry" /></mxCell><mxCell id="ambito-21" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1090" y="560" width="230" height="250" as="geometry" /></mxCell><mxCell id="ambito-22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1102" y="594" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-23" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1138" y="590" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1102" y="624" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-25" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1138" y="620" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-26" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1102" y="654" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-27" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1138" y="650" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1102" y="684" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-29" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1138" y="680" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1102" y="714" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-31" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1138" y="710" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1102" y="744" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-33" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1138" y="740" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1102" y="774" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-35" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1138" y="770" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="acceso" name="5. Dar acceso al sistema entre los dos backends"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="acceso-1" value="&lt;b&gt;Dar acceso al sistema desde la ficha&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="acceso-2" value="El usuario vive en iglesia-seguridad y el miembro en iglesia-api; se vinculan por miembro_id, sin compartir bases." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="acceso-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="40" y="120" width="520" height="760" as="geometry" /></mxCell><mxCell id="acceso-4" value="iglesia-seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="600" y="120" width="560" height="760" as="geometry" /></mxCell><mxCell id="acceso-5" value="iglesia-api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1200" y="120" width="500" height="420" as="geometry" /></mxCell><mxCell id="acceso-6" value="&lt;b&gt;1. Al abrir la ficha (con usuarios.ver)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;UsuariosService.usuarioDeMiembro(id)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="170" width="450" height="65" as="geometry" /></mxCell><mxCell id="acceso-7" value="&lt;b&gt;2. ¿Tiene usuario?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sí → etiqueta «Acceso: correo» · no → botón «Dar acceso al sistema»&lt;br&gt;(solo con usuarios.administrar y miembro activo)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="270" width="450" height="80" as="geometry" /></mxCell><mxCell id="acceso-8" value="&lt;b&gt;3. Abrir el diálogo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GET /api/roles → roles base activos LIDER y MIEMBRO&lt;br&gt;(sin ids fijos)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="390" width="450" height="75" as="geometry" /></mxCell><mxCell id="acceso-9" value="&lt;b&gt;4. DarAccesoComponent emite&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;correo (precargado con el de la ficha) · contraseña temporal (8–72) · rol&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="500" width="450" height="75" as="geometry" /></mxCell><mxCell id="acceso-10" value="&lt;b&gt;5. Éxito&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;la ficha muestra «Acceso: correo» y el botón desaparece&lt;br&gt;toast: deberá cambiar la contraseña al iniciar sesión&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="70" y="720" width="450" height="80" as="geometry" /></mxCell><mxCell id="acceso-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="acceso-6" target="acceso-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-12" value="no tiene" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="acceso-7" target="acceso-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="acceso-8" target="acceso-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-14" value="&lt;b&gt;GET /api/usuarios?miembroId={id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;EspecificacionesUsuario.deMiembro · página vacía si no tiene&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="630" y="165" width="500" height="70" as="geometry" /></mxCell><mxCell id="acceso-15" value="&lt;b&gt;POST /api/usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ correo, contrasena, iglesiaId (de la sesión), miembroId, rolIds }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="630" y="500" width="500" height="70" as="geometry" /></mxCell><mxCell id="acceso-16" value="&lt;b&gt;UsuarioService.crear&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;roles con requiereMiembro exigen miembroId&lt;br&gt;miembro_id único por iglesia → 409 · correo único → 409&lt;br&gt;BCrypt · debe_cambiar_contrasena = true&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="630" y="600" width="500" height="90" as="geometry" /></mxCell><mxCell id="acceso-17" value="&lt;b&gt;usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;miembro_id · UNIQUE (iglesia_id, miembro_id)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="880" y="720" width="250" height="80" as="geometry" /></mxCell><mxCell id="acceso-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="acceso-6" target="acceso-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="acceso-9" target="acceso-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="acceso-15" target="acceso-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="acceso-16" target="acceso-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-22" value="201" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="acceso-16" target="acceso-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="672" /><mxPoint x="600" y="760" /></Array></mxGeometry></mxCell><mxCell id="acceso-23" value="&lt;b&gt;409 / 400&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;se muestra dentro del diálogo, que sigue abierto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="630" y="790" width="300" height="65" as="geometry" /></mxCell><mxCell id="acceso-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="acceso-16" target="acceso-23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-25" value="&lt;b&gt;Al iniciar sesión&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;el token del nuevo usuario trae &lt;code&gt;miembro_id&lt;/code&gt;&lt;br&gt;y, con rol Líder, el permiso miembros.ver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="630" y="290" width="500" height="70" as="geometry" /></mxCell><mxCell id="acceso-26" value="&lt;b&gt;UsuarioActual.miembroId()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AmbitoMiembros: su red y su cadena (página 4)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1230" y="290" width="440" height="70" as="geometry" /></mxCell><mxCell id="acceso-27" value="JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="acceso-25" target="acceso-26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceso-28" value="&lt;b&gt;Sin transacción entre backends&lt;/b&gt;&lt;br&gt;Crear el usuario es una sola llamada a iglesia-seguridad: el miembro ya existe en iglesia-api y no cambia. Si falla, no queda nada a medias." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1230" y="400" width="440" height="110" as="geometry" /></mxCell><mxCell id="acceso-29" value="&lt;b&gt;Fuera de alcance&lt;/b&gt;&lt;br&gt;Vincular un usuario que ya existe, o desvincularlo, desde /usuarios (spec futura). El portal del miembro (módulo 6) usará este mismo vínculo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1230" y="580" width="440" height="110" as="geometry" /></mxCell><mxCell id="acceso-30" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1230" y="720" width="230" height="220" as="geometry" /></mxCell><mxCell id="acceso-31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1242" y="754" width="28" height="20" as="geometry" /></mxCell><mxCell id="acceso-32" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1278" y="750" width="175" height="28" as="geometry" /></mxCell><mxCell id="acceso-33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1242" y="784" width="28" height="20" as="geometry" /></mxCell><mxCell id="acceso-34" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1278" y="780" width="175" height="28" as="geometry" /></mxCell><mxCell id="acceso-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1242" y="814" width="28" height="20" as="geometry" /></mxCell><mxCell id="acceso-36" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1278" y="810" width="175" height="28" as="geometry" /></mxCell><mxCell id="acceso-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1242" y="844" width="28" height="20" as="geometry" /></mxCell><mxCell id="acceso-38" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1278" y="840" width="175" height="28" as="geometry" /></mxCell><mxCell id="acceso-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1242" y="874" width="28" height="20" as="geometry" /></mxCell><mxCell id="acceso-40" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1278" y="870" width="175" height="28" as="geometry" /></mxCell><mxCell id="acceso-41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1242" y="904" width="28" height="20" as="geometry" /></mxCell><mxCell id="acceso-42" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1278" y="900" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
