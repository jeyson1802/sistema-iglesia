<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arquitectura" name="1. Arquitectura del registro de miembros"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arquitectura-1" value="&lt;b&gt;Arquitectura: miembros, niveles, grupos y ubigeo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-2" value="Componentes del frontend, servicios REST que consumen, clases de iglesia-api que los atienden y tablas que leen o escriben." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="760" height="1310" as="geometry" /></mxCell><mxCell id="arquitectura-4" value="Contrato HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="820" y="110" width="340" height="1310" as="geometry" /></mxCell><mxCell id="arquitectura-5" value="iglesia-api (paquetes por contexto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1190" y="110" width="930" height="1310" as="geometry" /></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;app.routes.ts · &lt;modulo&gt;.routes.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/miembros, /niveles, /grupos → &lt;code&gt;iglesiaFijadaGuard&lt;/code&gt;&lt;br&gt;&#x27;&#x27; y &#x27;:id&#x27; → miembros.ver · &#x27;nuevo&#x27; → miembros.crear&lt;br&gt;/niveles → niveles.administrar · /grupos → grupos.ver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="420" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-7" value="&lt;b&gt;AppMenu · construirMenu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Iglesia › Miembros · «&amp;lt;plural&amp;gt;» (pi-sitemap)&lt;br&gt;Administración › Niveles (pi-sort-amount-up)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="490" y="150" width="280" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-8" value="&lt;b&gt;ConfiguracionIglesiaService (core)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombresGrupos (signal) · se carga al haber iglesia&lt;br&gt;menú, títulos y etiquetas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="490" y="260" width="280" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-9" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-7" target="arquitectura-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-10" value="&lt;b&gt;MiembrosListaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tabla paginada en el servidor · filtros&lt;br&gt;«Nuevo miembro» solo con miembros.crear&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="270" width="300" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;FiltrosMiembrosComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre (300 ms) · condición · nivel&lt;br&gt;grupo · líder · estado (activos)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="365" width="220" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-12" value="&lt;b&gt;TablaMiembrosComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;enlace a la ficha · «Pastor principal»&lt;br&gt;esqueleto · vacío · inactivos atenuados&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="285" y="365" width="230" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-10" target="arquitectura-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-10" target="arquitectura-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-15" value="&lt;b&gt;MiembroFichaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/miembros/nuevo y /miembros/:id&lt;br&gt;aviso de duplicados · solo lectura sin miembros.editar&lt;br&gt;desactivar · pastor principal · dar acceso&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="470" width="380" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-16" value="&lt;b&gt;FormularioMiembroComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;5 secciones · solo nombres y apellidos obligatorios&lt;br&gt;fecha ⟷ edad aproximada excluyentes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="580" width="300" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-17" value="&lt;b&gt;ProgresoFichaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;% completo y datos que faltan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="365" y="580" width="200" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-18" value="&lt;b&gt;CadenaLiderazgoComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;del líder directo al pastor&lt;br&gt;«Lidera a N»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="580" y="580" width="190" height="55" as="geometry" /></mxCell><mxCell id="arquitectura-19" value="&lt;b&gt;DarAccesoComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;correo · temporal · Líder/Miembro&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="580" y="470" width="190" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-15" target="arquitectura-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-15" target="arquitectura-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-15" target="arquitectura-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-15" target="arquitectura-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-24" value="&lt;b&gt;app-selector-miembro (shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;p-autoComplete · excluirId · valor { id, nombre }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="680" width="300" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-25" value="&lt;b&gt;app-selector-ubigeo (shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;3 p-select en cascada · valor: código de distrito&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="370" y="680" width="300" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-16" target="arquitectura-24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-16" target="arquitectura-25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-28" value="&lt;b&gt;NivelesListaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tabla ordenada · subir/bajar · renombrar&lt;br&gt;desactivar (confirma)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="790" width="300" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-29" value="&lt;b&gt;GruposListaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tabla · diálogo de grupo (líder, anfitrión, día,&lt;br&gt;hora, ubigeo) · «Cómo se llaman»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="370" y="790" width="400" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-30" value="&lt;b&gt;MiembrosService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · obtener · cadena · posiblesDuplicados&lt;br&gt;pastorPrincipal · crear · actualizar · estado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="920" width="340" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-31" value="&lt;b&gt;OpcionesMiembroService · UbigeoService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;opciones de miembro · ubigeo en caché&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="410" y="920" width="360" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-32" value="&lt;b&gt;NivelesService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · crear · renombrar · ordenar · estado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="1020" width="340" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-33" value="&lt;b&gt;GruposService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · crear · actualizar · estado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="410" y="1020" width="360" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-34" value="&lt;b&gt;UsuariosService (features/usuarios)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;crearParaMiembro · usuarioDeMiembro → iglesia-seguridad&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="1110" width="400" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-10" target="arquitectura-30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="305" /><mxPoint x="40" y="941" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-15" target="arquitectura-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="530" /><mxPoint x="35" y="1140" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-24" target="arquitectura-31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="900" /><mxPoint x="482" y="900" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-28" target="arquitectura-32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="880" /><mxPoint x="395" y="880" /><mxPoint x="395" y="1000" /><mxPoint x="220" y="1000" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-29" target="arquitectura-33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="880" /><mxPoint x="780" y="880" /><mxPoint x="780" y="1000" /><mxPoint x="590" y="1000" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-40" value="&lt;b&gt;Sin dependencias circulares&lt;/b&gt;&lt;br&gt;shared/ no conoce features: los selectores tienen su propio servicio. miembros usa los servicios de niveles, grupos, roles y usuarios (como ya hacía usuarios con roles)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="1200" width="360" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-41" value="&lt;b&gt;Errores por campo&lt;/b&gt;&lt;br&gt;Un 409/400 con &lt;code&gt;errores: { liderId: … }&lt;/code&gt; se muestra junto al campo (&lt;code&gt;app-mensaje-error-servidor&lt;/code&gt;); sin campo, arriba del formulario. Los 5xx los avisa el toast global." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="430" y="1200" width="340" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-42" value="&lt;b&gt;GET /api/miembros&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;q · condicion · nivelId · grupoId · liderId · activo&lt;br&gt;paginado · filtrado por ámbito&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="150" width="300" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-43" value="&lt;b&gt;GET /api/miembros/{id}[/cadena]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;200 | 404 (fuera del ámbito)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="270" width="300" height="85" as="geometry" /></mxCell><mxCell id="arquitectura-44" value="&lt;b&gt;GET /api/miembros/opciones · /posibles-duplicados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hasta 20 activos · mismos nombres y apellidos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" par