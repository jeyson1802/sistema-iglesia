        <mxCell id="c24" value="Authorization: Bearer &lt;jwt nuevo&gt;  (×2)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
