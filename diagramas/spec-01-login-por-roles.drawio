.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="316" as="sourcePoint"/><mxPoint x="810" y="316" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="POST /refresh → GET /usuarios/me" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="366" as="sourcePoint"/><mxPoint x="1140" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="rota token_refresco · SELECT usuario" style="html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="416" as="sourcePoint"/><mxPoint x="1470" y="416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="token nuevo + usuario" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="466" as="sourcePoint"/><mxPoint x="810" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="perfil = sessionStorage si el usuario&lt;br&gt;aún tiene ese rol (si no, se descarta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="670.0" y="500" width="280" height="44" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;② Cerrar sesión (menú de usuario de la topbar)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="564" width="1540" height="30" as="geometry"/></mxCell><mxCell id="c18" value="«Cerrar sesión»" style="html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="630" as="sourcePoint"/><mxPoint x="480" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="cerrarSesion()" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="680" as="sourcePoint"/><mxPoint x="810" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="limpia token, usuario y perfil&lt;br&gt;(antes de llamar al backend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="680.0" y="714" width="260" height="44" as="geometry"/></mxCell><mxCell id="c21" value="POST /api/auth/logout + Cookie" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="794" as="sourcePoint"/><mxPoint x="1140" y="794" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="UPDATE token_refresco.revocado_en" style="html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="844" as="sourcePoint"/><mxPoint x="1470" y="844" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="204 + Set-Cookie Max-Age=0" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="894" as="sourcePoint"/><mxPoint x="810" y="894" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="/auth/login  (replaceUrl: «atrás» no vuelve)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="944" as="sourcePoint"/><mxPoint x="150" y="944" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;③ Cambiar contraseña (/cuenta/contrasena)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="978" width="1540" height="30" as="geometry"/></mxCell><mxCell id="c26" value="actual · nueva · confirmación (validadas en el FormGroup)" style="html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1044" as="sourcePoint"/><mxPoint x="480" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="cambiarContrasena()" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="1094" as="sourcePoint"/><mxPoint x="810" y="1094" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="PUT /api/usuarios/me/contrasena (Bearer)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="1144" as="sourcePoint"/><mxPoint x="1140" y="1144" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="compara BCrypt · UPDATE usuario.hash_contrasena" style="html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1194" as="sourcePoint"/><mxPoint x="1470" y="1194" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="UPDATE token_refresco (revoca TODAS las sesiones)" style="html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1244" as="sourcePoint"/><mxPoint x="1470" y="1244" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="204  (o 400 con detail: «La contraseña actual no es correcta»)" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1294" as="sourcePoint"/><mxPoint x="810" y="1294" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="cerrarSesion() local" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="1344" as="sourcePoint"/><mxPoint x="480" y="1344" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="/auth/login?motivo=contrasena-cambiada&lt;br&gt;«Contraseña actualizada. Inicia sesión de nuevo.»" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="1410" as="sourcePoint"/><mxPoint x="150" y="1410" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>