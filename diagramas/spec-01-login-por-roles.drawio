<mxfile host="app.diagrams.net"><diagram id="arquitectura" name="1. Arquitectura"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Spec 01 · Login por roles con perfil activo — vista de componentes&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Quién llama a quién: pantallas de Angular → fachada de sesión → endpoints REST de iglesia-seguridad → clases de Spring → tablas de PostgreSQL. iglesia-api solo valida el JWT." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1700" height="40" as="geometry"/></mxCell><mxCell id="c5" value="iglesia-web (Angular 21 · zoneless · signals)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;opacity=60;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="1040" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Pantallas&lt;/b&gt; (cada una: .ts + .html + .spec.ts)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="520" height="20" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;LoginComponent&lt;/b&gt;&lt;br&gt;/auth/login · invitadoGuard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="250" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SeleccionarPerfilComponent&lt;/b&gt;&lt;br&gt;/auth/seleccionar-perfil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="250" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;AccesoDenegadoComponent&lt;/b&gt;&lt;br&gt;/auth/acceso-denegado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;CambiarContrasenaComponent&lt;/b&gt;&lt;br&gt;/cuenta/contrasena" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Inicio*Component&lt;/b&gt; (4)&lt;br&gt;/sistema · /administracion&lt;br&gt;/mi-red · /mi-perfil · perfilGuard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="250" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Layout de Sakai&lt;/b&gt;&lt;br&gt;AppTopbar (menú de usuario)&lt;br&gt;AppMenu (filtrado por perfil)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="296" width="250" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Núcleo&lt;/b&gt; (core/auth · core/interceptors)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="520" height="20" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;auth.guards.ts&lt;/b&gt;&lt;br&gt;autenticadoGuard · invitadoGuard&lt;br&gt;perfilSeleccionadoGuard&lt;br&gt;perfilGuard(...roles) · inicioRedirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="415" width="250" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;SesionService&lt;/b&gt; (fachada)&lt;br&gt;signals: token · usuario · perfil&lt;br&gt;iniciarSesion · restaurar · refrescar&lt;br&gt;seleccionarPerfil · cerrarSesion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="415" width="250" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;authInterceptor&lt;/b&gt;&lt;br&gt;agrega Bearer solo a apiUrl/seguridadUrl&lt;br&gt;401 → 1 refresco compartido&lt;br&gt;→ reintenta una vez" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="545" width="250" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;AuthApiService&lt;/b&gt; (HttpClient)&lt;br&gt;login · refrescar · cerrarSesion&lt;br&gt;obtenerUsuarioActual · cambiarContrasena&lt;br&gt;withCredentials en /auth/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="545" width="250" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;sessionStorage&lt;/b&gt;&lt;br&gt;solo iglesia.perfilActivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="675" width="250" height="56" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Cookie del navegador&lt;/b&gt;&lt;br&gt;iglesia_refresco (HttpOnly)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="250" height="56" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Compartidos&lt;/b&gt; (shared/components)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="520" height="20" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;LogoIglesiaComponent&lt;/b&gt;&lt;br&gt;identidad neutra (spec 02: la iglesia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="785" width="250" height="44" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;MensajeErrorCampoComponent&lt;/b&gt;&lt;br&gt;errores de validación por campo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="785" width="250" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;TarjetaAccesoComponent&lt;/b&gt;&lt;br&gt;marco de las pantallas de acceso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="250" height="44" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;BienvenidaPerfilComponent&lt;/b&gt;&lt;br&gt;encabezado de los inicios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="840" width="250" height="44" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Constantes de navegación&lt;/b&gt; (core/auth/models)&lt;br&gt;ROLES (orden = jerarquía) · ETIQUETA_ROL · ICONO_ROL · RUTA_INICIO_POR_ROL · RUTAS_AUTH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="905" width="520" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Reglas de la sesión&lt;/b&gt;&lt;br&gt;• El token de acceso vive &lt;b&gt;solo en memoria&lt;/b&gt; (signal).&lt;br&gt;• El de refresco lo guarda y envía el &lt;b&gt;navegador&lt;/b&gt; (JS no lo ve).&lt;br&gt;• Al recargar (F5): provideAppInitializer → restaurar().&lt;br&gt;• El perfil activo limita la &lt;b&gt;navegación&lt;/b&gt;; el backend autoriza con todos los roles del JWT." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="520" height="140" as="geometry"/></mxCell><mxCell id="c27" value="iglesia-seguridad (Spring Boot · puerto 8081)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;opacity=60;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="600" height="1040" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Controladores REST&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="135" width="560" height="20" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;AuthController&lt;/b&gt; /api/auth&lt;br&gt;POST /login → 200 + Set-Cookie&lt;br&gt;POST /refresh → lee cookie, rota&lt;br&gt;POST /logout → 204, borra cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="270" height="120" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;UsuarioController&lt;/b&gt; /api/usuarios&lt;br&gt;GET /me&lt;br&gt;PUT /me/contrasena&lt;br&gt;(CRUD de administración: fuera de esta spec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="160" width="270" height="120" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;CookieRefresco&lt;/b&gt;&lt;br&gt;HttpOnly · Secure · SameSite=Strict&lt;br&gt;Path=/api/auth · Max-Age=7d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="270" height="64" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;ManejadorErroresAuth&lt;/b&gt;&lt;br&gt;token inválido → 401 + borra cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="270" height="64" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;JwksController&lt;/b&gt;&lt;br&gt;GET /oauth2/jwks (clave pública)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="384" width="270" height="50" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Servicios&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="470" width="560" height="20" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;AuthService&lt;/b&gt;&lt;br&gt;AuthenticationManager (BCrypt)&lt;br&gt;emite SesionEmitida&lt;br&gt;(acceso + refresco)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="495" width="270" height="90" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;UsuarioService&lt;/b&gt;&lt;br&gt;obtenerActual()&lt;br&gt;cambiarContrasena() → revocarTodos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="495" width="270" height="90" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;GeneradorTokenAcceso&lt;/b&gt;&lt;br&gt;JWT RS256 · 15 min&lt;br&gt;claims: roles, iglesia_id, miembro_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="615" width="270" height="64" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;TokenRefrescoService&lt;/b&gt;&lt;br&gt;emitir · consumir (rota)&lt;br&gt;revocar · revocarTodos&lt;br&gt;reutilización ⇒ revoca todo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="615" width="270" height="90" as="geometry"/></mxCell><mxCell id="c39" value="PostgreSQL · iglesia_seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;opacity=60;dashed=1;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="470" height="760" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;🗄 usuario&lt;/b&gt;&lt;hr&gt;id PK&lt;br&gt;correo UNIQUE&lt;br&gt;hash_contrasena (BCrypt)&lt;br&gt;iglesia_id · miembro_id&lt;br&gt;activo · version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="150" width="250" height="115" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;🗄 usuario_rol&lt;/b&gt;&lt;hr&gt;usuario_id FK&lt;br&gt;rol (ADMIN_SISTEMA, ADMIN_IGLESIA,&lt;br&gt;     LIDER, MIEMBRO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="320" width="250" height="81" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;🗄 token_refresco&lt;/b&gt;&lt;hr&gt;id PK · usuario_id FK&lt;br&gt;hash_token (SHA-256, nunca el valor)&lt;br&gt;emitido_en · expira_en&lt;br&gt;revocado_en (NULL = vigente)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="455" width="250" height="98" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Operaciones por tabla&lt;/b&gt;&lt;br&gt;&lt;b&gt;login&lt;/b&gt;: SELECT usuario + usuario_rol · INSERT token_refresco&lt;br&gt;&lt;b&gt;refresh&lt;/b&gt;: SELECT token por hash · UPDATE revocado_en · INSERT nuevo&lt;br&gt;&lt;b&gt;reutilización&lt;/b&gt;: UPDATE todos los vigentes del usuario&lt;br&gt;&lt;b&gt;logout&lt;/b&gt;: UPDATE revocado_en&lt;br&gt;&lt;b&gt;/me&lt;/b&gt;: SELECT usuario + usuario_rol&lt;br&gt;&lt;b&gt;cambiar contraseña&lt;/b&gt;: UPDATE usuario.hash_contrasena · UPDATE todos los token_refresco" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="640" width="410" height="190" as="geometry"/></mxCell><mxCell id="c44" value="iglesia-api (Spring Boot · puerto 8080) — Resource Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;opacity=60;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="1170" width="600" height="150" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Valida el JWT&lt;/b&gt; con la clave pública (JWKS) · emisor · audiencia «iglesia-api»&lt;br&gt;roles → ROLE_* · iglesia_id del claim (nunca del cliente)&lt;br&gt;En esta spec no se agregan endpoints de negocio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="1210" width="560" height="90" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="600" height="24" as="geometry"/></mxCell><mxCell id="c47" value="Frontend: pantallas" style="rounded=1;whiteSpace=wrap;html=1