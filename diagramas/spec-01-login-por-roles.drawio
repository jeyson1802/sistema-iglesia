" as="geometry"/></mxCell><mxCell id="c19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Tabla de rutas protegidas&lt;/b&gt;&lt;br&gt;/sistema → ADMIN_SISTEMA&lt;br&gt;/administracion → ADMIN_IGLESIA&lt;br&gt;/mi-red → LIDER&lt;br&gt;/mi-perfil → MIEMBRO&lt;br&gt;/miembros → ADMIN_IGLESIA · /cuenta/contrasena → cualquier perfil&lt;br&gt;Demos de Sakai: solo si !environment.production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="850" width="520" height="160" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;El menú lateral sigue la misma regla&lt;/b&gt;&lt;br&gt;AppMenu calcula su modelo con computed(perfilActivo):&lt;br&gt;• «Inicio» apunta a la ruta del perfil.&lt;br&gt;• Cada entrada declara sus roles («Miembros» → ADMIN_IGLESIA).&lt;br&gt;• Los grupos vacíos se ocultan; las demos solo en desarrollo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="560" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="refresco" name="4. Refresco silencioso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c30" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="164" as="sourcePoint"/><mxPoint x="150" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="164" as="sourcePoint"/><mxPoint x="440" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="164" as="sourcePoint"/><mxPoint x="730" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="164" as="sourcePoint"/><mxPoint x="1020" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="164" as="sourcePoint"/><mxPoint x="1310" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="164" as="sourcePoint"/><mxPoint x="1600" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;Flujo 3 · El token de acceso vence: refresco silencioso y reintento&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="El usuario no se entera: el interceptor detecta el 401, pide un token nuevo una sola vez (aunque fallen varias peticiones a la vez) y repite la petición." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c5" value="Pantalla&lt;br&gt;(cualquier petición)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c6" value="authInterceptor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c7" value="SesionService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c8" value="iglesia-api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c9" value="iglesia-seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c10" value="PostgreSQL&lt;br&gt;token_refresco" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1490" y="100" width="220" height="64" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;① La petición falla por token vencido&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c12" value="GET /api/...  (2 peticiones a la vez)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="266" as="sourcePoint"/><mxPoint x="440" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="Authorization: Bearer &lt;jwt vencido&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="316" as="sourcePoint"/><mxPoint x="1020" y="316" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="401 Unauthorized  (×2)" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="366" as="sourcePoint"/><mxPoint x="440" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;② Un único refresco compartido&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c16" value="refrescar()  (×2)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="466" as="sourcePoint"/><mxPoint x="730" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="refrescoEnCurso ??= ... shareReplay&lt;br&gt;→ ambas esperan la MISMA petición" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="590.0" y="500" width="280" height="44" as="geometry"/></mxCell><mxCell id="c18" value="POST /api/auth/refresh  (sin cuerpo, Cookie automática)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="580" as="sourcePoint"/><mxPoint x="1310" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="SELECT por hash_token · ¿vigente y no revocado?" style="html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="630" as="sourcePoint"/><mxPoint x="1600" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="UPDATE revocado_en (el usado) · INSERT el nuevo" style="html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="680" as="sourcePoint"/><mxPoint x="1600" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="200 { tokenAcceso nuevo } + Set-Cookie rotada" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="730" as="sourcePoint"/><mxPoint x="730" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="token nuevo (a las 2 peticiones)" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="780" as="sourcePoint"/><mxPoint x="440" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;③ Reintento (una sola vez)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="814" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c24" value="Authorization: Bearer &lt;jwt nuevo&gt;  (×2)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="880" as="sourcePoint"/><mxPoint x="1020" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="respuesta normal" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="930" as="sourcePoint"/><mxPoint x="150" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;④ Si el refresco falla (cookie vencida, revocada o ausente)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="964" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c27" value="401 + Set-Cookie Max-Age=0" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="1030" as="sourcePoint"/><mxPoint x="730" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="Solo la primera petición cierra la sesión (las demás ya la encuentran cerrada):&lt;br&gt;cerrarSesion() → POST /logout → navigate('/auth/login?motivo=sesion-expirada')&lt;br&gt;→ «Tu sesión expiró. Inicia sesión de nuevo.»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="1064" width="510" height="66" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;¿Por qué un solo refresco?&lt;/b&gt; Con rotación, usar dos veces el mismo token&lt;br&gt;se interpreta como robo y se revocan &lt;b&gt;todas&lt;/b&gt; las sesiones del usuario." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="910" y="1150" width="800" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="otros" name="5. Recargar, salir y contraseña"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c34" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="164" as="sourcePoint"/><mxPoint x="150" y="1454" as="targetPoint"/></mxGeometry></mxCell><mxCell 