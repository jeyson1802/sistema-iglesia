</mxGeometry></mxCell><mxCell id="c27" value="200 UsuarioResponse" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="1060" as="sourcePoint"/><mxPoint x="1020" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="UsuarioActual (roles ordenados por jerarquía)" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="1110" as="sourcePoint"/><mxPoint x="730" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;1 rol&lt;/b&gt; → perfil seleccionado solo y guardado en sessionStorage.&lt;br&gt;&lt;b&gt;Varios roles&lt;/b&gt; → perfil = null (el usuario elige)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="1144" width="510" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;③ Navegar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1"><mxGeometry x="40" y="1214" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c31" value="rutaInicio()" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1280" as="sourcePoint"/><mxPoint x="730" y="1280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="/mi-perfil · /mi-red · /administracion · /sistema&lt;br&gt;o /auth/seleccionar-perfil" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1346" as="sourcePoint"/><mxPoint x="440" y="1346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="router.navigateByUrl(...)" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1396" as="sourcePoint"/><mxPoint x="150" y="1396" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Errores&lt;/b&gt;: 401 → «Correo o contraseña incorrectos».&lt;br&gt;Otro → «No se pudo iniciar sesión. Intenta de nuevo.»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="510" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="navegacion" name="3. Navegación y guards"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Flujo 2 · Cómo decide el router a dónde puede ir cada usuario&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Los guards leen los signals de SesionService. Devuelven true (pasa) o un UrlTree (redirige). El perfil activo controla la navegación; el backend autoriza siempre con el JWT." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;El usuario pide una URL&lt;/b&gt;&lt;br&gt;(enlace, menú, F5 o escrita a mano)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="260" height="50" as="geometry"/></mxCell><mxCell id="c6" value="¿Es /auth/login?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;rhombus;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="240" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;invitadoGuard&lt;/b&gt;&lt;br&gt;¿hay sesión? → redirige a rutaInicio()&lt;br&gt;sin sesión → muestra el login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="195" width="300" height="80" as="geometry"/></mxCell><mxCell id="c8" value="autenticadoGuard&lt;br&gt;¿hay sesión?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;rhombus;" vertex="1" parent="1"><mxGeometry x="650" y="320" width="240" height="90" as="geometry"/></mxCell><mxCell id="c9" value="→ &lt;b&gt;/auth/login&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="335" width="260" height="60" as="geometry"/></mxCell><mxCell id="c10" value="perfilSeleccionadoGuard&lt;br&gt;¿hay perfil activo?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;rhombus;" vertex="1" parent="1"><mxGeometry x="650" y="450" width="240" height="90" as="geometry"/></mxCell><mxCell id="c11" value="→ &lt;b&gt;/auth/seleccionar-perfil&lt;/b&gt;&lt;br&gt;(una tarjeta por rol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="465" width="260" height="60" as="geometry"/></mxCell><mxCell id="c12" value="¿Es la raíz «/»?" style="rounded=1;whiteSpa