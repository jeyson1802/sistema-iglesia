          </mxGeometry>
        </mxCell>
        <mxCell id="c25" value="respuesta normal" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="930" as="sourcePoint" />
            <mxPoint x="150" y="930" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;④ Si el refresco falla (cookie vencida, revocada o ausente)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;fontSize=14;opacity=85;" vertex="1" parent="1">
          <mxGeometry x="40" y="964" width="1670" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="401 + Set-Cookie Max-Age=0" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1310" y="1030" as="sourcePoint" />
            <mxPoint x="730" y="1030" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c28" value="Solo la primera petición cierra la sesión (las demás ya la encuentran cerrada):&lt;br&gt;cerrarSesion() → POST /logout → navigate(&#39;/auth/login?motivo=sesion-expirada&#39;)&lt;br&gt;→ «Tu sesión expiró. Inicia sesión de nuevo.»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="1064" width="510" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;¿Por qué un solo refresco?&lt;/b&gt; Con rotación, usar dos veces el mismo token&lt;br&gt;se interpreta como robo y se revocan &lt;b&gt;todas&lt;/b&gt; las sesiones del usuario." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="910" y="1150" width="800" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
