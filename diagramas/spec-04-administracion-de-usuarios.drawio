Space=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="360" height="470" as="geometry" /></mxCell><mxCell id="crear-4" value="iglesia-seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="420" y="110" width="420" height="1060" as="geometry" /></mxCell><mxCell id="crear-5" value="PostgreSQL iglesia_seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="870" y="110" width="260" height="1060" as="geometry" /></mxCell><mxCell id="crear-6" value="Usuario nuevo · iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1160" y="110" width="380" height="1060" as="geometry" /></mxCell><mxCell id="crear-7" value="&lt;b&gt;1. «Nuevo usuario»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;FormularioUsuarioComponent valida correo,&lt;br&gt;contraseña temporal (8–72) y al menos un rol&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="300" height="70" as="geometry" /></mxCell><mxCell id="crear-8" value="&lt;b&gt;2. UsuariosService.crear&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;POST /api/usuarios&lt;br&gt;{ correo, contrasena, iglesiaId (sesión), miembroId: null, rolIds }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="260" width="300" height="70" as="geometry" /></mxCell><mxCell id="crear-9" value="&lt;b&gt;3. UsuarioService.crear&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;política · rolesAsignables · correo único (409)&lt;br&gt;&lt;code&gt;Usuario.nuevo(..., contrasenaTemporal = true)&lt;/code&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="460" y="260" width="340" height="80" as="geometry" /></mxCell><mxCell id="crear-10" value="&lt;b&gt;usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;INSERT&lt;br&gt;debe_cambiar_contrasena = TRUE&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="900" y="260" width="200" height="90" as="geometry" /></mxCell><mxCell id="crear-11" value="&lt;b&gt;4. 201 → toast «Usuario creado»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;la tabla recarga la página actual&lt;br&gt;y muestra «Debe cambiar contraseña»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="400" width="300" height="70" as="geometry" /></mxCell><mxCell id="crear-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="crear-7" target="crear-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="crear-8" target="crear-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="crear-9" target="crear-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-15" value="201 UsuarioResponse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="crear-9" target="crear-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-16" value="&lt;b&gt;5. Login con la contraseña temporal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;POST /api/auth/login&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1190" y="600" width="300" height="70" as="geometry" /></mxCell><mxCell id="crear-17" value="&lt;b&gt;6. GeneradorTokenAcceso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;JWT con claim &lt;code&gt;cambio_contrasena: true&lt;/code&gt;&lt;br&gt;(sale de usuario.debe_cambiar_contrasena)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="460" y="600" width="340" height="80" as="geometry" /></mxCell><mxCell id="crear-18" value="&lt;b&gt;7. GET /api/usuarios/me&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;permitido aunque el cambio esté pendiente&lt;br&gt;SesionService.debeCambiarContrasena = true&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1190" y="710" width="300" height="70" as="geometry" /></mxCell><mxCell id="crear-19" value="&lt;b&gt;8. contrasenaVigenteGuard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;canActivateChild del layout: cualquier ruta&lt;br&gt;→ /cuenta/contrasena con aviso «Tu contraseña es temporal»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1190" y="820" width="320" height="80" as="geometry" /></mxCell><mxCell id="crear-20" value="&lt;b&gt;9. PUT /api/usuarios/me/contrasena&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;contraseña actual + nueva&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1190" y="940" width="300" height="70" as="geometry" /></mxCell><mxCell id="crear-21" value="&lt;b&gt;10. UsuarioService.cambiarContrasena&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;code&gt;usuario.cambiarContrasena(hash)&lt;/code&gt; → bandera en FALSE&lt;br&gt;revocarTodos(usuarioId)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="460" y="940" width="340" height="80" as="geometry" /></mxCell><mxCell id="crear-22" value="&lt;b&gt;usuario / token_refresco&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;debe_cambiar_contrasena = FALSE&lt;br&gt;tokens revocados&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="900" y="800" width="200" height="90" as="geometry" /></mxCell><mxCell id="crear-23" value="&lt;b&gt;11. Vuelve al login&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;entra con la contraseña nueva: el JWT trae&lt;br&gt;&lt;code&gt;cambio_contrasena: false&lt;/code&gt; y llega a su inicio&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1190" y="1060" width="320" height="80" as="geometry" /></mxCell><mxCell id="crear-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="crear-16" target="crear-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-25" value="tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="crear-17" target="crear-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="crear-18" target="crear-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="crear-19" target="crear-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" parent="1" edge="1" source="crear-20" target="crear-21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="crear-21" target="crear-22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-30" value="204" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="crear-21" target="crear-23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="crear-31" value="&lt;b&gt;¿Por qué temporal?&lt;/b&gt;&lt;br&gt;Antes el administrador conocía para siempre la contraseña del usuario. Ahora solo conoce una contraseña que el usuario debe reemplazar en su primer inicio de sesión." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="620" width="320" height="110" as="geometry" /></mxCell><mxCell id="crear-32" value="&lt;b&gt;Defensa en profundidad&lt;/b&gt;&lt;br&gt;El guard del frontend solo guía la navegación. Quien de verdad bloquea son los filtros de los dos backends: con el claim en &lt;code&gt;true&lt;/code&gt;, cualquier otro endpoint responde 403 (ver página 4)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="760" width="320" height="120" as="geometry" /></mxCell><mxCell id="crear-33" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1560" y="110" width="230" height="220" as="geometry" /></mxCell><mxCell id="crear-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1572" y="144" width="28" height="20" as="geometry" /></mxCell><mxCell id="crear-35" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="140" width="175" height="28" as="geometry" /></mxCell><mxCell id="crear-36" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1" ><mxGeometry x="1572" y="174" width="28" height="20" as="geometry" /></mxCell><mxCell id="crear-37" value="Rutas y guards" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="170" width="175" height="28" as="geometry" /></mxCell><mxCell id="crear-38" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1572" y="204" width="28" height="20" as="geometry" /></mxCell><mxCell id="crear-39" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="200" width="175" height="28" as="geometry" /></mxCell><mxCell id="crear-40" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1572" y="234" width="28" height="20" as="geometry" /></mxCell><mxCell id="crear-41" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="230" width="175" height="28" as="geometry" /></mxCell><mxCell id="crear-42" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1572" y="264" width="28" height="20" as="geometry" /></mxCell><mxCell id="crear-43" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="260" width="175" height="28" as="geometry" /></mxCell><mxCell id="crear-44" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1572" y="294" width="28" height="20" as="geometry" /></mxCell><mxCell id="crear-45" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="290" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="restablecer" name="3. Restablecer contraseña"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="restablecer-1" value="&lt;b&gt;Flujo: restablecer la contraseña de otro usuario&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="restablecer-2" value="El administrador fija una contraseña temporal; el usuario pierde sus sesiones y debe cambiarla en su próximo inicio de sesión." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="restablecer-3" value="Administrador · iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="380" height="760" as="geometry" /></mxCell><mxCell id="restablecer-4" value="iglesia-seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="440" y="110" width="480" height="760" as="geometry" /></mxCell><mxCell id="restablecer-5" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="950" y="110" width="260" height="760" as="geometry" /></mxCell><mxCell id="restablecer-6" value="&lt;b&gt;1. Botón «Restablecer contraseña»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;solo con usuarios.administrar y nunca en la fila propia («Tú»)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="330" height="70" as="geometry" /></mxCell><mxCell id="restablecer-7" value="&lt;b&gt;2. RestablecerContrasenaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;contraseña temporal de 8 a 72 caracteres&lt;br&gt;texto: deberá cambiarla y se cerrarán sus sesiones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="260" width="330" height="80" as="geometry" /></mxCell><mxCell id="restablecer-8" value="&lt;b&gt;3. UsuariosService.restablecerContrasena&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PUT /api/usuarios/{id}/contrasena&lt;br&gt;{ contrasenaTemporal }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="380" width="330" height="70" as="geometry" /></mxCell><mxCell id="restablecer-9" value="&lt;b&gt;4. UsuarioController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;@PreAuthorize(usuarios.administrar) · @Valid&lt;br&gt;RestablecerContrasenaRequest (@Size 8–72)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="380" width="420" height="70" as="geometry" /></mxCell><mxCell id="restablecer-10" value="&lt;b&gt;5. UsuarioService.restablecerContrasena&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sobre uno mismo → 400 «use Cambiar contraseña»&lt;br&gt;buscarAdministrable: otra iglesia → 404&lt;br&gt;&lt;code&gt;usuario.restablecerContrasena(hash)&lt;/code&gt; → bandera TRUE&lt;br&gt;tokensRefresco.revocarTodos(id)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="490" width="420" height="110" as="geometry" /></mxCell><mxCell id="restablecer-11" value="&lt;b&gt;6. Log INFO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Contraseña restablecida usuarioId={} por usuarioId={};&lt;br&gt;sesiones revocadas» (sin correo ni contraseña)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="640" width="420" height="70" as="geometry" /></mxCell><mxCell id="restablecer-12" value="&lt;b&gt;usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hash nuevo&lt;br&gt;debe_cambiar_contrasena = TRUE&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="980" y="480" width="200" height="90" as="geometry" /></mxCell><mxCell id="restablecer-13" value="&lt;b&gt;token_refresco&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;revocado = TRUE&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="980" y="600" width="200" height="80" as="geometry" /></mxCell><mxCell id="restablecer-14" value="&lt;b&gt;7. 204 → toast «Contraseña restablecida»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;la fila se marca «Debe cambiar contraseña»&lt;br&gt;sin recargar la página&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="520" width="330" height="80" as="geometry" /></mxCell><mxCell id="restablecer-15" value="&lt;b&gt;400 / 404 → mensaje dentro del diálogo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;el diálogo sigue abierto; un 5xx lo avisa el toast global&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="650" width="330" height="70" as="geometry" /></mxCell><mxCell id="restablecer-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="restablecer-6" target="restablecer-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="restablecer-7" target="restablecer-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="restablecer-8" target="restablecer-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="restablecer-9" target="restablecer-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="restablecer-10" target="restablecer-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="restablecer-10" target="restablecer-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="restablecer-10" target="restablecer-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-23" value="204" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="restablecer-10" target="restablecer-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-24" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="restablecer-10" target="restablecer-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="restablecer-25" value="&lt;b&gt;¿Por qué revocar los tokens de refresco?&lt;/b&gt;&lt;br&gt;Sin revocarlos, el usuario podría seguir renovando un JWT emitido con la contraseña anterior. Es el mismo criterio que cuando el usuario cambia su propia contraseña." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1240" y="150" width="330" height="120" as="geometry" /></mxCell><mxCell id="restablecer-26" value="&lt;b&gt;Después&lt;/b&gt;&lt;br&gt;El próximo login del usuario sigue el mismo camino que un usuario nuevo (página 2, pasos 5 a 11): JWT con &lt;code&gt;cambio_contrasena: true&lt;/code&gt; → cambio obligatorio." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1240" y="300" width="330" height="100" as="geometry" /></mxCell><mxCell id="restablecer-27" value="&lt;b&gt;Fuera de alcance&lt;/b&gt;&lt;br&gt;Un administrador no restablece su propia contraseña desde aquí: para eso está «Cambiar contraseña», que pide la actual." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1240" y="430" width="330" height="90" as="geometry" /></mxCell><mxCell id="restablecer-28" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1240" y="560" width="230" height="220" as="geometry" /></mxCell><mxCell id="restablecer-29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1252" y="594" width="28" height="20" as="geometry" /></mxCell><mxCell id="restablecer-30" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1288" y="590" width="175" height="28" as="geometry" /></mxCell><mxCell id="restablecer-31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1252" y="624" width="28" height="20" as="geometry" /></mxCell><mxCell id="restablecer-32" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1288" y="620" width="175" height="28" as="geometry" /></mxCell><mxCell id="restablecer-33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1252" y="654" width="28" height="20" as="geometry" /></mxCell><mxCell id="restablecer-34" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1288" y="650" width="175" height="28" as="geometry" /></mxCell><mxCell id="restablecer-35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1252" y="684" width="28" height="20" as="geometry" /></mxCell><mxCell id="restablecer-36" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1288" y="680" width="175" height="28" as="geometry" /></mxCell><mxCell id="restablecer-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1252" y="714" width="28" height="20" as="geometry" /></mxCell><mxCell id="restablecer-38" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1288" y="710" width="175" height="28" as="geometry" /></mxCell><mxCell id="restablecer-39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1252" y="744" width="28" height="20" as="geometry" /></mxCell><mxCell id="restablecer-40" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1288" y="740" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="cambio" name="4. Dónde se aplica cambio_contrasena"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="cambio-1" value="&lt;b&gt;Dónde se aplica cambio_contrasena&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="cambio-2" value="Una sola bandera en la base de seguridad viaja como claim del JWT y se hace cumplir en los dos backends y en la navegación del frontend." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="cambio-3" value="&lt;b&gt;usuario.debe_cambiar_contrasena&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;TRUE al crear y al restablecer&lt;br&gt;FALSE al cambiarla el propio usuario&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="640" y="120" width="300" height="100" as="geometry" /></mxCell><mxCell id="cambio-4" value="&lt;b&gt;GeneradorTokenAcceso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;code&gt;.claim(&quot;cambio_contrasena&quot;, usuario.isDebeCambiarContrasena())&lt;/code&gt;&lt;br&gt;en login y en refresh&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="615" y="260" width="350" height="70" as="geometry" /></mxCell><mxCell id="cambio-5" value="&lt;b&gt;JWT de acceso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ sub, iglesia_id, permisos, ..., &lt;b&gt;cambio_contrasena&lt;/b&gt; }&lt;br&gt;ClaimsJwt.CAMBIO_CONTRASENA en cada backend&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="615" y="380" width="350" height="70" as="geometry" /></mxCell><mxCell id="cambio-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="cambio-3" target="cambio-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="cambio-4" target="cambio-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-8" value="iglesia-seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="500" width="520" height="450" as="geometry" /></mxCell><mxCell id="cambio-9" value="&lt;b&gt;FiltroCambioContrasenaPendiente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;después de la autenticación por token&lt;br&gt;claim en true y ruta no permitida → 403&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="550" width="460" height="70" as="geometry" /></mxCell><mxCell id="cambio-10" value="&lt;b&gt;RutasCambioContrasena.PERMITIDAS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GET /api/usuarios/me&lt;br&gt;PUT /api/usuarios/me/contrasena&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="650" width="460" height="70" as="geometry" /></mxCell><mxCell id="cambio-11" value="&lt;b&gt;403 ProblemDetail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CambioContrasenaPendienteException → AccessDeniedProblemDetail&lt;br&gt;con traceId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="760" width="460" height="60" as="geometry" /></mxCell><mxCell id="cambio-12" value="excepciones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1" source="cambio-9" target="cambio-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-13" value="cualquier otra ruta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="cambio-10" target="cambio-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-14" value="iglesia-api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="580" y="500" width="420" height="450" as="geometry" /></mxCell><mxCell id="cambio-15" value="&lt;b&gt;FiltroCambioContrasenaPendiente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;después de FiltroContextoUsuario&lt;br&gt;&lt;b&gt;sin rutas permitidas&lt;/b&gt;: todo endpoint protegido → 403&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="610" y="550" width="360" height="80" as="geometry" /></mxCell><mxCell id="cambio-16" value="&lt;b&gt;403 ProblemDetail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CambioContrasenaPendienteException&lt;br&gt;ManejadorGlobalErrores · traceId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="610" y="680" width="360" height="60" as="geometry" /></mxCell><mxCell id="cambio-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="cambio-15" target="cambio-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-18" value="iglesia-api no tiene nada que hacer mientras el cambio está pendiente: el cambio se hace en iglesia-seguridad." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="610" y="780" width="360" height="70" as="geometry" /></mxCell><mxCell id="cambio-19" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1030" y="500" width="480" height="450" as="geometry" /></mxCell><mxCell id="cambio-20" value="&lt;b&gt;SesionService.debeCambiarContrasena&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;computed desde GET /api/usuarios/me&lt;br&gt;(UsuarioActual.debeCambiarContrasena)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1060" y="550" width="420" height="70" as="geometry" /></mxCell><mxCell id="cambio-21" value="&lt;b&gt;contrasenaVigenteGuard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;canActivateChild del layout&lt;br&gt;toda ruta ≠ /cuenta/contrasena → redirige allí&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1060" y="650" width="420" height="70" as="geometry" /></mxCell><mxCell id="cambio-22" value="&lt;b&gt;CambiarContrasenaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;p-message warn «Tu contraseña es temporal. Cámbiala para continuar.»&lt;br&gt;al terminar → login&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1060" y="760" width="420" height="70" as="geometry" /></mxCell><mxCell id="cambio-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="cambio-20" target="cambio-21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="cambio-21" target="cambio-22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-25" value="Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="cambio-5" target="cambio-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-26" value="Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="cambio-5" target="cambio-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-27" value="GET /me" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="cambio-5" target="cambio-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cambio-28" value="&lt;b&gt;Regla por defecto cerrada&lt;/b&gt;&lt;br&gt;Los filtros bloquean todo menos lo permitido: un endpoint nuevo queda protegido sin acordarse de la regla en cada @PreAuthorize. Si el claim falta, se trata como false." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1040" y="120" width="380" height="110" as="geometry" /></mxCell><mxCell id="cambio-29" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1560" y="500" width="230" height="250" as="geometry" /></mxCell><mxCell id="cambio-30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1572" y="534" width="28" height="20" as="geometry" /></mxCell><mxCell id="cambio-31" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="530" width="175" height="28" as="geometry" /></mxCell><mxCell id="cambio-32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1" ><mxGeometry x="1572" y="564" width="28" height="20" as="geometry" /></mxCell><mxCell id="cambio-33" value="Rutas y guards" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="560" width="175" height="28" as="geometry" /></mxCell><mxCell id="cambio-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1572" y="594" width="28" height="20" as="geometry" /></mxCell><mxCell id="cambio-35" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="590" width="175" height="28" as="geometry" /></mxCell><mxCell id="cambio-36" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1572" y="624" width="28" height="20" as="geometry" /></mxCell><mxCell id="cambio-37" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="620" width="175" height="28" as="geometry" /></mxCell><mxCell id="cambio-38" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1572" y="654" width="28" height="20" as="geometry" /></mxCell><mxCell id="cambio-39" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="650" width="175" height="28" as="geometry" /></mxCell><mxCell id="cambio-40" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1572" y="684" width="28" height="20" as="geometry" /></mxCell><mxCell id="cambio-41" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="680" width="175" height="28" as="geometry" /></mxCell><mxCell id="cambio-42" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1572" y="714" width="28" height="20" as="geometry" /></mxCell><mxCell id="cambio-43" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1608" y="710" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="garantia" name="5. Garantía de administrador"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="garantia-1" value="&lt;b&gt;Garantía de administrador de la iglesia&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="garantia-2" value="Ninguna operación puede dejar a la iglesia sin al menos un usuario activo con usuarios.administrar a través de un rol activo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="garantia-3" value="&lt;b&gt;Camino 1 · UsuarioService.actualizar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PUT /api/usuarios/{id}&lt;br&gt;desactivar al usuario o quitarle el rol administrador&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="150" width="400" height="70" as="geometry" /></mxCell><mxCell id="garantia-4" value="&lt;b&gt;Camino 2 · RolService.actualizar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PUT /api/roles/{id}&lt;br&gt;quitar &lt;code&gt;usuarios.administrar&lt;/code&gt; a un rol personalizado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="260" width="400" height="70" as="geometry" /></mxCell><mxCell id="garantia-5" value="&lt;b&gt;Camino 3 · RolService.cambiarEstado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PATCH /api/roles/{id}/estado&lt;br&gt;desactivar el rol que da la administración&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="40" y="370" width="400" height="70" as="geometry" /></mxCell><mxCell id="garantia-6" value="&lt;b&gt;GarantiaAdministradorIglesia.verificarQueQuedaAdministrador(iglesiaId)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;@Transactional(propagation = MANDATORY): corre dentro de la transacción del cambio&lt;br&gt;se llama siempre, aunque la iglesia ya tuviera 0 administradores&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="560" y="250" width="520" height="90" as="geometry" /></mxCell><mxCell id="garantia-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="garantia-3" target="garantia-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="garantia-4" target="garantia-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="garantia-5" target="garantia-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-10" value="después de aplicar el cambio" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" parent="1" vertex="1" ><mxGeometry x="468" y="196" width="90" height="44" as="geometry" /></mxCell><mxCell id="garantia-11" value="&lt;b&gt;1. roles.flush()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;manda a la base los cambios pendientes de la transacción&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="600" y="400" width="440" height="60" as="geometry" /></mxCell><mxCell id="garantia-12" value="&lt;b&gt;2. pg_advisory_xact_lock(iglesiaId)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;serializa las verificaciones de la misma iglesia&lt;br&gt;hasta el commit o rollback&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="600" y="490" width="440" height="70" as="geometry" /></mxCell><mxCell id="garantia-13" value="&lt;b&gt;3. contarAdministradoresActivos(iglesiaId, usuarios.administrar)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;count(DISTINCT u.id) · usuario activo · rol activo · permiso&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="600" y="590" width="440" height="70" as="geometry" /></mxCell><mxCell id="garantia-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="garantia-6" target="garantia-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="garantia-11" target="garantia-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="garantia-12" target="garantia-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-17" value="&lt;b&gt;&amp;gt; 0 → sigue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;commit · revocar sesiones si aplica · log INFO · 200&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="600" y="720" width="200" height="70" as="geometry" /></mxCell><mxCell id="garantia-18" value="&lt;b&gt;= 0 → 409 ConflictoException&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«La iglesia debe conservar al menos un usuario activo que pueda administrar usuarios»&lt;br&gt;rollback: nada cambia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="830" y="720" width="250" height="100" as="geometry" /></mxCell><mxCell id="garantia-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="garantia-13" target="garantia-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="garantia-13" target="garantia-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-21" value="&lt;b&gt;usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;activo · iglesia_id&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1180" y="420" width="160" height="80" as="geometry" /></mxCell><mxCell id="garantia-22" value="&lt;b&gt;usuario_rol&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;usuario_id · rol_id&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1360" y="420" width="160" height="80" as="geometry" /></mxCell><mxCell id="garantia-23" value="&lt;b&gt;rol&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;activo&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1180" y="530" width="160" height="80" as="geometry" /></mxCell><mxCell id="garantia-24" value="lee (SQL nativo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" parent="1" edge="1" source="garantia-13" target="garantia-23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="garantia-25" value="&lt;b&gt;rol_permiso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;permiso_codigo = &#x27;usuarios.administrar&#x27;&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1360" y="530" width="200" height="80" as="geometry" /></mxCell><mxCell id="garantia-26" value="&lt;b&gt;¿Por qué el bloqueo va antes del conteo?&lt;/b&gt;&lt;br&gt;Con READ COMMITTED, cada sentencia ve lo confirmado al empezar. Si el conteo esperara el bloqueo dentro de la misma sentencia, no vería lo que la otra transacción acaba de confirmar. Por eso el bloqueo es una sentencia aparte y el conteo se hace después." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1180" y="650" width="380" height="140" as="geometry" /></mxCell><mxCell id="garantia-27" value="&lt;b&gt;Concurrencia&lt;/b&gt;&lt;br&gt;Dos administradores se desactivan entre sí a la vez: el segundo espera el bloqueo, cuenta 0 y recibe 409. Queda exactamente uno (prueba con 2 hilos en GarantiaAdministradorIglesiaIntegrationTest)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="40" y="500" width="400" height="110" as="geometry" /></mxCell><mxCell id="garantia-28" value="&lt;b&gt;En el frontend&lt;/b&gt;&lt;br&gt;El 409 se muestra tal cual: dentro del diálogo de /usuarios (la fila sigue «Activo») o en /roles, dentro del diálogo o en el mensaje al desactivar." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="40" y="640" width="400" height="90" as="geometry" /></mxCell><mxCell id="garantia-29" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="40" y="770" width="230" height="160" as="geometry" /></mxCell><mxCell id="garantia-30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="52" y="804" width="28" height="20" as="geometry" /></mxCell><mxCell id="garantia-31" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="88" y="800" width="175" height="28" as="geometry" /></mxCell><mxCell id="garantia-32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="52" y="834" width="28" height="20" as="geometry" /></mxCell><mxCell id="garantia-33" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="88" y="830" width="175" height="28" as="geometry" /></mxCell><mxCell id="garantia-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="52" y="864" width="28" height="20" as="geometry" /></mxCell><mxCell id="garantia-35" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="88" y="860" width="175" height="28" as="geometry" /></mxCell><mxCell id="garantia-36" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="52" y="894" width="28" height="20" as="geometry" /></mxCell><mxCell id="garantia-37" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="88" y="890" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
