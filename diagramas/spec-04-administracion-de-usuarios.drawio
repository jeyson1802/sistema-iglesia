<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arquitectura" name="1. Arquitectura de /usuarios"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arquitectura-1" value="&lt;b&gt;Arquitectura: administración de usuarios (/usuarios)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-2" value="Componentes del frontend, endpoints REST, clases del backend y tablas que leen o escriben." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-3" value="iglesia-web · features/usuarios/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="680" height="1000" as="geometry" /></mxCell><mxCell id="arquitectura-4" value="Contrato HTTP (iglesia-seguridad)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="740" y="110" width="330" height="1000" as="geometry" /></mxCell><mxCell id="arquitectura-5" value="iglesia-seguridad · contextos usuario/ y rol/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1100" y="110" width="560" height="1000" as="geometry" /></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;usuarios.routes.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;code&gt;permisoGuard(&#x27;usuarios.ver&#x27;)&lt;/code&gt;&lt;br&gt;ruta /usuarios, hija de AppLayout&lt;br&gt;menú «Administración › Usuarios» (pi-users)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="150" y="150" width="360" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-7" value="&lt;b&gt;UsuariosListaComponent (contenedor)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;signals: usuarios, página, filtro, roles, cargando, errores&lt;br&gt;«Nuevo usuario» y acciones solo con &lt;code&gt;usuarios.administrar&lt;/code&gt;&lt;br&gt;una petición nueva cancela la anterior · toast de éxito&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="120" y="260" width="420" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="arquitectura-6" target="arquitectura-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-9" value="&lt;b&gt;FiltrosUsuariosComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;correo (espera 300 ms) · estado · rol&lt;br&gt;emite FiltroUsuarios → vuelve a la página 0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="400" width="270" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-10" value="&lt;b&gt;TablaUsuariosComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;p-table lazy · 10 por página&lt;br&gt;skeleton · vacío · fila propia «Tú» sin acciones&lt;br&gt;«Debe cambiar contraseña»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="345" y="400" width="270" height="80" as="geometry" /></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;FormularioUsuarioComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;p-dialog crear / editar · correo editable&lt;br&gt;roles ofrecidos y bloqueados (requiereMiembro)&lt;br&gt;confirma si cambia el correo o se desactiva&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="520" width="270" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-12" value="&lt;b&gt;RestablecerContrasenaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;p-dialog · p-password new-password&lt;br&gt;avisa que deberá cambiarla y que se cierran sus sesiones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="345" y="520" width="270" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-13" value="inputs / outputs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-7" target="arquitectura-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-14" value="inputs / outputs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-7" target="arquitectura-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-7" target="arquitectura-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="305" /><mxPoint x="45" y="565" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-7" target="arquitectura-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="305" /><mxPoint x="630" y="565" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-17" value="&lt;b&gt;UsuariosService (fachada HTTP)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar(filtro, página) · crear · actualizar(id, cambios, miembroIdActual)&lt;br&gt;restablecerContrasena(id, temporal)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="680" width="420" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-18" value="&lt;b&gt;usuario-admin.mapper.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;aUsuarioAdmin · aPaginaUsuarios&lt;br&gt;Page&amp;lt;T&amp;gt; = { content, page }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="495" y="760" width="160" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-19" value="&lt;b&gt;RolesService (features/roles)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar() → RolAcceso con requiereMiembro&lt;br&gt;solo si hay roles.ver o usuarios.administrar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="860" width="420" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-7" target="arquitectura-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="246" y="380" /><mxPoint x="338" y="380" /><mxPoint x="338" y="500" /><mxPoint x="338" y="640" /><mxPoint x="270" y="640" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-17" target="arquitectura-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-22" value="&lt;b&gt;Sin duplicar reglas&lt;/b&gt;&lt;br&gt;El frontend no deduce qué roles exigen miembro: usa &lt;code&gt;requiereMiembro&lt;/code&gt; de &lt;code&gt;GET /api/roles&lt;/code&gt;. La iglesia del usuario nuevo sale de la sesión; el backend igual la valida." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="60" y="960" width="300" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-23" value="&lt;b&gt;Paginación en el servidor&lt;/b&gt;&lt;br&gt;La tabla no pide la primera página al iniciarse (&lt;code&gt;lazyLoadOnInit=false&lt;/code&gt;): la pide el contenedor. Filtros y páginas llegan como query &lt;code&gt;page, size=10, sort=correo,asc&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="375" y="960" width="300" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-24" value="&lt;b&gt;GET /api/usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;usuarios.ver → 200 (Page)&lt;br&gt;?correo &amp;amp; activo &amp;amp; rolId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="760" y="180" width="290" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-25" value="&lt;b&gt;POST /api/usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;usuarios.administrar → 201 | 400 | 403 | 409&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="760" y="270" width="290" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-26" value="&lt;b&gt;PUT /api/usuarios/{id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;usuarios.administrar → 200 | 400 | 404 | 409&lt;br&gt;correo editable · 409 «sin administrador»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="760" y="360" width="290" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-27" value="&lt;b&gt;PUT /api/usuarios/{id}/contrasena&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;usuarios.administrar → 204 | 400 | 404&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="760" y="460" width="290" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-28" value="&lt;b&gt;GET /api/roles&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;roles.ver o usuarios.administrar → 200&lt;br&gt;RolResponse + requiereMiembro&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="760" y="860" width="290" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-17" target="arquitectura-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="715" /><mxPoint x="690" y="210" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-17" target="arquitectura-25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="715" /><mxPoint x="690" y="300" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-17" target="arquitectura-26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="715" /><mxPoint x="690" y="395" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-17" target="arquitectura-27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="715" /><mxPoint x="690" y="490" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-33" value="HttpClient + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-19" target="arquitectura-28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-34" value="&lt;b&gt;UsuarioController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/api/usuarios&lt;br&gt;@PreAuthorize(Permisos.*) · @Valid · OpenAPI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1120" y