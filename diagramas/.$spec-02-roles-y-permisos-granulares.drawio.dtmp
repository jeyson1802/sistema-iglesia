le=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="roles-32" target="roles-41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="roles-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="roles-32" target="roles-42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="roles-45" value="&lt;b&gt;rol · rol_permiso · usuario_rol&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1320" y="860" width="260" height="50" as="geometry"/></mxCell><mxCell id="roles-46" value="&lt;b&gt;permiso&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1630" y="860" width="270" height="50" as="geometry"/></mxCell><mxCell id="roles-47" value="lee / escribe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="roles-41" target="roles-45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="roles-48" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="roles-42" target="roles-46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="roles-49" value="&lt;b&gt;Formulario:&lt;/b&gt; solo se habilitan los permisos del rol base elegido; al cambiarlo, los que ya no aplican se desmarcan y deshabilitan. Sin nombre o sin permisos, «Guardar» queda deshabilitado y el mensaje aparece junto al campo. Los 400/409 muestran el &lt;code&gt;detail&lt;/code&gt; del ProblemDetail dentro del diálogo; los 5xx los avisa el toast global." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="30" y="1040" width="600" height="170" as="geometry"/></mxCell><mxCell id="roles-50" value="&lt;b&gt;Aislamiento entre iglesias:&lt;/b&gt; un rol personalizado de otra iglesia responde &lt;b&gt;404&lt;/b&gt; (no 403) para no revelar que existe, y no aparece en el listado. La iglesia siempre sale del JWT. &lt;code&gt;ADMIN_SISTEMA&lt;/code&gt; solo ve los roles base y no puede crear roles (no tiene iglesia ni &lt;code&gt;roles.administrar&lt;/code&gt;)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="670" y="1040" width="600" height="170" as="geometry"/></mxCell><mxCell id="roles-51" value="&lt;b&gt;Desactivar ≠ borrar:&lt;/b&gt; el rol se conserva con sus asignaciones. Si es el único rol activo de algún usuario, responde &lt;b&gt;409&lt;/b&gt; y el frontend muestra el mensaje dejando el rol activo. Reactivar no pide confirmación (no es destructivo)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="1310" y="1040" width="620" height="170" as="geometry"/></mxCell><mxCell id="roles-52" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="30" y="1240" width="300" height="22" as="geometry"/></mxCell><mxCell id="roles-53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="30" y="1266" width="26" height="20" as="geometry"/></mxCell><mxCell id="roles-54" value="Frontend iglesia-web (componentes y servicios)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="64" y="1266" width="300" height="22" as="geometry"/></mxCell><mxCell id="roles-55" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="30" y="1294" width="26" height="20" as="geometry"/></mxCell><mxCell id="roles-56" value="Navegación por permisos (guards y menú)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="64" y="1294" width="300" height="22" as="geometry"/></mxCell><mxCell id="roles-57" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="30" y="1322" width="26" height="20" as="geometry"/></mxCell><mxCell id="roles-58" value="Endpoint REST" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="64" y="1322" width="300" height="22" as="geometry"/></mxCell><mxCell id="roles-59" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="30" y="1350" width="26" height="20" as="geometry"/></mxCell><mxCell id="roles-60" value="Backend iglesia-seguridad (clases Java)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="64" y="1350" width="300" height="22" as="geometry"/></mxCell><mxCell id="roles-61" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="30" y="1378" width="26" height="20" as="geometry"/></mxCell><mxCell id="roles-62" value="Tabla PostgreSQL / dato persistido" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="64" y="1378" width="300" height="22" as="geometry"/></mxCell><mxCell id="roles-63" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="30" y="1406" width="26" height="20" as="geometry"/></mxCell><mxCell id="roles-64" value="Regla de negocio o error HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="64" y="1406" width="300" height="22" as="geometry"/></mxCell><mxCell id="roles-65" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="30" y="1434" width="26" height="20" as="geometry"/></mxCell><mxCell id="roles-66" value="Nota / decisión" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="64" y="1434" width="300" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>