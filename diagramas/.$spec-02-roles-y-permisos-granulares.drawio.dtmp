<mxfile host="app.diagrams.net"><diagram id="conceptos" name="1. Conceptos: nivel, rol y permiso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="conceptos-1" value="&lt;b&gt;Conceptos: nivel, rol de acceso y permiso&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="10" width="1520" height="40" as="geometry"/></mxCell><mxCell id="conceptos-2" value="Tres ideas distintas que antes se mezclaban en el enum de 4 roles. Esta spec separa el rol de acceso del permiso; el nivel sigue en iglesia-api." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1"><mxGeometry x="40" y="50" width="1520" height="40" as="geometry"/></mxCell><mxCell id="conceptos-3" value="&lt;b&gt;Nivel&lt;/b&gt; (rango eclesiástico)&lt;br&gt;&lt;br&gt;Pastor, diácono, líder… Lo define cada iglesia.&lt;br&gt;&lt;i&gt;Vive en iglesia-api&lt;/i&gt; y &lt;b&gt;no&lt;/b&gt; da acceso a nada.&lt;br&gt;No cambia en esta spec." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="470" height="150" as="geometry"/></mxCell><mxCell id="conceptos-4" value="&lt;b&gt;Rol de acceso&lt;/b&gt; (perfil)&lt;br&gt;&lt;br&gt;Qué permisos tiene el usuario y con qué &lt;b&gt;ámbito&lt;/b&gt;.&lt;br&gt;4 roles &lt;b&gt;base&lt;/b&gt; fijos + roles &lt;b&gt;personalizados&lt;/b&gt; por iglesia.&lt;br&gt;&lt;i&gt;Vive en iglesia-seguridad.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="560" y="110" width="470" height="150" as="geometry"/></mxCell><mxCell id="conceptos-5" value="&lt;b&gt;Permiso&lt;/b&gt;&lt;br&gt;&lt;br&gt;Una acción concreta: &lt;code&gt;&amp;lt;modulo&amp;gt;.&amp;lt;accion&amp;gt;&lt;/code&gt;&lt;br&gt;(&lt;code&gt;miembros.ver&lt;/code&gt;, &lt;code&gt;roles.administrar&lt;/code&gt;…)&lt;br&gt;Catálogo &lt;b&gt;fijo&lt;/b&gt;: solo se agrega por migración Flyway." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1080" y="110" width="470" height="150" as="geometry"/></mxCell><mxCell id="conceptos-6" value="&lt;b&gt;Roles base (globales, de solo lectura) y su ámbito&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="290" width="800" height="26" as="geometry"/></mxCell><mxCell id="conceptos-7" value="&lt;b&gt;Administrador del sistema&lt;/b&gt;&lt;br&gt;&lt;code&gt;ADMIN_SISTEMA&lt;/code&gt;&lt;br&gt;Ámbito: &lt;b&gt;SISTEMA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;usuarios.ver · usuarios.administrar · roles.ver&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;No heredable&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="330" width="350" height="120" as="geometry"/></mxCell><mxCell id="conceptos-8" value="&lt;b&gt;Administrador de iglesia&lt;/b&gt;&lt;br&gt;&lt;code&gt;ADMIN_IGLESIA&lt;/code&gt;&lt;br&gt;Ámbito: &lt;b&gt;IGLESIA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;los 8 permisos&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;Heredable&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="420" y="330" width="350" height="120" as="geometry"/></mxCell><mxCell id="conceptos-9" value="&lt;b&gt;Líder&lt;/b&gt;&lt;br&gt;&lt;code&gt;LIDER&lt;/code&gt;&lt;br&gt;Ámbito: &lt;b&gt;RED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(ninguno por ahora)&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;Heredable · requiere miembro&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="800" y="330" width="350" height="120" as="geometry"/></mxCell><mxCell id="conceptos-10" value="&lt;b&gt;Miembro&lt;/b&gt;&lt;br&gt;&lt;code&gt;MIEMBRO&lt;/code&gt;&lt;br&gt;Ámbito: &lt;b&gt;PROPIO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(ninguno por ahora)&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;Heredable · requiere miembro&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1180" y="330" width="350" height="120" as="geometry"/></mxCell><mxCell id="conceptos-11" value="&lt;b&gt;«Secretaría»&lt;/b&gt; (personalizado, iglesia 1)&lt;br&gt;hereda de &lt;b&gt;Administrador de iglesia&lt;/b&gt;&lt;br&gt;permisos: &lt;code&gt;miembros.ver&lt;/code&gt;, &lt;code&gt;miembros.crear&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;dashed=1;" parent="1" vertex="1"><mxGeometry x="260" y="540" width="360" height="110" as="geometry"/></mxCell><mxCell id="conceptos-12" value="hereda de" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1" source="conceptos-11" target="conceptos-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="conceptos-13" value="&lt;b&gt;Regla del subconjunto&lt;/b&gt;&lt;br&gt;Los permisos de un rol personalizado deben ser un subconjunto de los de su rol base. Si no: &lt;b&gt;400&lt;/b&gt; con la lista de permisos sobrantes (&lt;code&gt;PoliticaRoles&lt;/code&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="660" y="540" width="420" height="110" as="geometry"/></mxCell><mxCell id="conceptos-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1" source="conceptos-13" target="conceptos-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="conceptos-15" value="&lt;b&gt;Cómo se usa cada cosa&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="690" width="800" height="26" as="geometry"/></mxCell><mxCell id="conceptos-16" value="&lt;b&gt;Perfil activo (frontend)&lt;/b&gt;&lt;br&gt;Uno de los roles activos del usuario, elegido en el selector.&lt;br&gt;El &lt;b&gt;menú&lt;/b&gt; y los &lt;b&gt;guards&lt;/b&gt; usan solo &lt;i&gt;sus&lt;/i&gt; permisos.&lt;br&gt;El &lt;b&gt;rol base&lt;/b&gt; decide la página de inicio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="730" width="480" height="120" as="geometry"/></mxCell><mxCell id="conceptos-17" value="&lt;b&gt;JWT&lt;/b&gt;&lt;br&gt;&lt;code&gt;roles&lt;/code&gt;: roles base distintos de los roles activos&lt;br&gt;&lt;code&gt;permisos&lt;/code&gt;: unión ordenada de todos los roles activos&lt;br&gt;Los endpoints autorizan con &lt;code&gt;hasAuthority(permiso)&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="560" y="730" width="480" height="120" as="geometry"/></mxCell><mxCell id="conceptos-18" value="&lt;b&gt;Ámbito&lt;/b&gt; (SISTEMA, IGLESIA, RED, PROPIO)&lt;br&gt;No se guarda: se deriva del rol base (&lt;code&gt;RolBase.ambito()&lt;/code&gt;).&lt;br&gt;Evita permisos como &lt;code&gt;miembros.ver_red&lt;/code&gt; o &lt;code&gt;miembros.ver_todos&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1080" y="730" width="470" height="120" as="geometry"/></mxCell><mxCell id="conceptos-19" value="&lt;b&gt;Decisión:&lt;/b&gt; el perfil limita la &lt;b&gt;navegación&lt;/b&gt;; el backend autoriza con &lt;b&gt;todos&lt;/b&gt; los permisos del token (mismo criterio que la SPEC 01). Así un usuario con «Secretaría» y «Miembro» no ve «Miembros» mientras navega como Miembro, pero cambiar de perfil no exige un token nuevo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="40" y="880" width="740" height="130" as="geometry"/></mxCell><mxCell id="conceptos-20" value="&lt;b&gt;Decisión:&lt;/b&gt; los 4 roles actuales pasan a ser roles &lt;b&gt;base&lt;/b&gt; globales e inmutables (PUT/PATCH → 403). No se rompen &lt;code&gt;RUTA_INICIO_POR_ROL&lt;/code&gt;, el selector de perfil ni las reglas de &lt;code&gt;ADMIN_SISTEMA&lt;/code&gt;, y una iglesia no puede quitarse a sí misma el acceso a la administración." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="810" y="880" width="740" height="130" as="geometry"/></mxCell><mxCell id="conceptos-21" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="1040" width="300" height="22" as="geometry"/></mxCell><mxCell id="conceptos-22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1066" width="26" height="20" as="geometry"/></mxCell><mxCell id="conceptos-23" value="Frontend iglesia-web (componentes y servicios)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="74" y="1066" width="300" height="22" as="geometry"/></mxCell><mxCell id="conceptos-24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1094" width="26" height="20" as="geometry"/></mxCell><mxCell id="conceptos-25" value="Endpoint REST" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="74" y="1094" width="300" height="22" as="geometry"/></mxCell><mxCell id="conceptos-26" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1122" width="26" height="20" as="geometry"/></mxCell><mxCell id="conceptos-27" value="Backend iglesia-seguridad (clases Java)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="74" y="1122" width="300" height="22" as="geometry"/></mxCell><mxCell id="conceptos-28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1150" width="26" height="20" as="geometry"/></mxCell><mxCell id="conceptos-29" value="Backend iglesia-api" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="74" y="1150" width="300" height="22" as="geometry"/></mxCell><mxCell id="conceptos-30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1178" width="26" height="20" as="geometry"/></mxCell><mxCell id="conceptos-31" value="Tabla PostgreSQL / dato persistido" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="74" y="1178" width="300" height="22" as="geometry"/></mxCell><mxCell id="conceptos-32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1206" width="26" height="20" as="geometry"/></mxCell><mxCell id="conceptos-33" value="Regla de negocio o error HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="74" y="1206" width="300" height="22" as="geometry"/></mxCell><mxCell id="conceptos-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1234" width="26" height="20" as="geometry"/></mxCell><mxCell id="conceptos-35" value="Nota / decisión" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="74" y="1234" width="300" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="modelo" name="2. Modelo de datos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="modelo-1" value="&lt;b&gt;Modelo de datos (iglesia_seguridad · migración V2__roles_y_permisos.sql)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="10" width="1520" height="40" as="geometry"/></mxCell><mxCell id="modelo-2" value="permiso y rol_permiso son nuevas; rol reemplaza al CHECK de texto; usuario_rol pasa de una columna rol (texto) a rol_id (FK)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1"><mxGeometry x="40" y="50" width="1520" height="40" as="geometry"/></mxCell><mxCell id="modelo-3" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#d6b656;color:#ffffff;padding:4px 6px;font-weight:bold;text-align:left&quot;&gt;permiso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;🔑 codigo VARCHAR(60)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;modulo VARCHAR(40)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;descripcion VARCHAR(200)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;orden INT&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacing=0;overflow=fill;" parent="1" vertex="1"><mxGeometry x="60" y="120" width="330" height="116" as="geometry"/></mxCell><mxCell id="modelo-4" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#d6b656;color:#ffffff;padding:4px 6px;font-weight:bold;text-align:left&quot;&gt;rol_permiso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;🔑🔗 rol_id → rol.id (ON DELETE CASCADE)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;🔑🔗 permiso_codigo → permiso.codigo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacing=0;overflow=fill;" parent="1" vertex="1"><mxGeometry x="470" y="120" width="330" height="72" as="geometry"/></mxCell><mxCell id="modelo-5" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#d6b656;color:#ffffff;padding:4px 6px;font-weight:bold;text-align:left&quot;&gt;rol&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;🔑 id BIGINT IDENTITY&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;iglesia_id BIGINT (NULL = base)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;codigo VARCHAR(30) UNIQUE (solo base)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;nombre VARCHAR(60)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;🔗 rol_base_id → rol.id (solo personalizado)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;activo BOOLEAN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;creado_en / actualizado_en&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;version BIGINT (bloqueo optimista)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacing=0;overflow=fill;" parent="1" vertex="1"><mxGeometry x="880" y="120" width="380" height="204" as="geometry"/></mxCell><mxCell id="modelo-6" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#d6b656;color:#ffffff;padding:4px 6px;font-weight:bold;text-align:left&quot;&gt;usuario_rol&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;🔑🔗 usuario_id → usuario.id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;🔑🔗 rol_id → rol.id  (antes: rol TEXT)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacing=0;overflow=fill;" parent="1" vertex="1"><mxGeometry x="470" y="470" width="330" height="72" as="geometry"/></mxCell><mxCell id="modelo-7" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#d6b656;color:#ffffff;padding:4px 6px;font-weight:bold;text-align:left&quot;&gt;usuario (V1, sin cambios)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;🔑 id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;correo UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;hash_contrasena&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;iglesia_id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;miembro_id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;activo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px;text-align:left&quot;&gt;version&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacing=0;overflow=fill;" parent="1" vertex="1"><mxGeometry x="60" y="470" width="330" height="182" as="geometry"/></mxCell><mxCell id="modelo-8" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="modelo-4" target="modelo-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="modelo-9" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="modelo-4" target="modelo-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="modelo-10" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="modelo-6" target="modelo-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="modelo-11" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="modelo-6" target="modelo-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="modelo-12" value="&lt;b&gt;ck_rol_base_o_personalizado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;base: iglesia_id NULL, codigo, sin rol_base_id&lt;br&gt;personalizado: iglesia_id, sin codigo, con rol_base_id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1320" y="120" width="250" height="150" as="geometry"/></mxCell><mxCell id="modelo-13" value="&lt;b&gt;uk_rol_iglesia_nombre&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;UNIQUE (iglesia_id, lower(nombre))&lt;br&gt;solo personalizados → 409 si se repite&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1320" y="290" width="250" height="110" as="geometry"/></mxCell><mxCell id="modelo-14" value="&lt;b&gt;Semilla (Flyway)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="880" y="690" width="680" height="24" as="geometry"/></mxCell><mxCell id="modelo-15" value="&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;codigo&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;nombre&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;permisos&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;ADMIN_SISTEMA&lt;/td&gt;&lt;td&gt;Administrador del sistema&lt;/td&gt;&lt;td&gt;usuarios.ver, usuarios.administrar, roles.ver&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;ADMIN_IGLESIA&lt;/td&gt;&lt;td&gt;Administrador de iglesia&lt;/td&gt;&lt;td&gt;los 8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;LIDER&lt;/td&gt;&lt;td&gt;Líder&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;MIEMBRO&lt;/td&gt;&lt;td&gt;Miembro&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="880" y="720" width="690" height="150" as="geometry"/></mxCell><mxCell id="modelo-16" value="&lt;b&gt;Migración sin pérdida:&lt;/b&gt; se agrega &lt;code&gt;usuario_rol.rol_id&lt;/code&gt;, se llena con el rol base cuyo &lt;code&gt;codigo&lt;/code&gt; coincide con el texto anterior y luego se marca &lt;code&gt;NOT NULL&lt;/code&gt;. Si alguna fila no encontrara su rol, la migración falla y se revierte entera. Verificado con el MCP: las 7 asignaciones previas se conservaron." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="60" y="700" width="740" height="130" as="geometry"/></mxCell><mxCell id="modelo-17" value="&lt;b&gt;Sin dependencia circular:&lt;/b&gt; el contexto &lt;code&gt;rol&lt;/code&gt; cuenta usuarios por rol con SQL nativo sobre &lt;code&gt;usuario_rol&lt;/code&gt; (&lt;code&gt;RolRepository.contarUsuarios&lt;/code&gt;) en lugar de depender del contexto &lt;code&gt;usuario&lt;/code&gt;, que ya depende de &lt;code&gt;rol&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="60" y="850" width="740" height="100" as="geometry"/></mxCell><mxCell id="modelo-18" value="&lt;b&gt;Por qué catálogo fijo:&lt;/b&gt; cada permiso corresponde a código real (un &lt;code&gt;hasAuthority&lt;/code&gt;, un guard, una opción de menú). Por eso &lt;code&gt;permiso&lt;/code&gt; no tiene endpoints de escritura y la entidad JPA es &lt;code&gt;@Immutable&lt;/code&gt;. &lt;br&gt;&lt;b&gt;Roles desactivados, no borrados:&lt;/b&gt; desactivar un rol que deje a algún usuario sin roles activos responde 409." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="60" y="970" width="740" height="130" as="geometry"/></mxCell><mxCell id="modelo-19" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="880" y="920" width="300" height="22" as="geometry"/></mxCell><mxCell id="modelo-20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="880" y="946" width="26" height="20" as="geometry"/></mxCell><mxCell id="modelo-21" value="Tabla PostgreSQL / dato persistido" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="914" y="946" width="300" height="22" as="geometry"/></mxCell><mxCell id="modelo-22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="880" y="974" width="26" height="20" as="geometry"/></mxCell><mxCell id="modelo-23" value="Regla de negocio o error HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="914" y="974" width="300" height="22" as="geometry"/></mxCell><mxCell id="modelo-24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="880" y="1002" width="26" height="20" as="geometry"/></mxCell><mxCell id="modelo-25" value="Nota / decisión" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="914" y="1002" width="300" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="login" name="3. Del login al menú"><mxGraphModel dx="1360" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="login-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" value="&lt;b&gt;Flujo: del login al JWT y de /me al menú&lt;/b&gt;" vertex="1"><mxGeometry height="40" width="1640" x="40" y="10" as="geometry"/></mxCell><mxCell id="login-2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" value="Cómo los roles y permisos de la base terminan en el token, en los perfiles del frontend y en la autorización de iglesia-api. Los números indican el orden." vertex="1"><mxGeometry height="40" width="1640" x="40" y="50" as="geometry"/></mxCell><mxCell id="login-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" value="iglesia-web" vertex="1"><mxGeometry height="1000" width="520" x="30" y="100" as="geometry"/></mxCell><mxCell id="login-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" value="iglesia-seguridad (puerto 8081)" vertex="1"><mxGeometry height="1000" width="530" x="590" y="100" as="geometry"/></mxCell><mxCell id="login-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" value="iglesia-api (puerto 8080)" vertex="1"><mxGeometry height="1000" width="530" x="1160" y="100" as="geometry"/></mxCell><mxCell id="login-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;SesionService&lt;/b&gt;&lt;br&gt;(fachada de sesión)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tokenAcceso (solo memoria)&lt;br&gt;&lt;br&gt;perfilActivo: Signal&amp;lt;Perfil&amp;gt;&lt;br&gt;permisosActivos&lt;br&gt;tienePermiso(p)&lt;br&gt;&lt;br&gt;seleccionarPerfil(id)&lt;br&gt;&lt;br&gt;rutaInicio() →&lt;br&gt;RUTA_INICIO_POR_ROL[rolBase]&lt;br&gt;&lt;br&gt;sessionStorage: solo el &lt;b&gt;id&lt;/b&gt; del perfil&lt;/span&gt;" vertex="1"><mxGeometry height="610" width="220" x="300" y="150" as="geometry"/></mxCell><mxCell id="login-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;LoginComponent&lt;/b&gt;" vertex="1"><mxGeometry height="60" width="200" x="60" y="150" as="geometry"/></mxCell><mxCell id="login-8" edge="1" parent="1" source="login-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.049;entryDx=0;entryDy=0;" target="login-6" value="iniciarSesion()"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;SeleccionarPerfilComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;una tarjeta por Perfil&lt;br&gt;(«Secretaría» · Administrador de iglesia)&lt;/span&gt;" vertex="1"><mxGeometry height="90" width="200" x="60" y="260" as="geometry"/></mxCell><mxCell id="login-10" edge="1" parent="1" source="login-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.254;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="login-9" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;AppTopbar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre del perfil activo («Secretaría»)&lt;/span&gt;" vertex="1"><mxGeometry height="90" width="200" x="60" y="380" as="geometry"/></mxCell><mxCell id="login-12" edge="1" parent="1" source="login-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.451;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="login-11" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;app.menu.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;construirMenu(perfil)&lt;br&gt;entrada.permiso ∈ permisos del perfil&lt;/span&gt;" vertex="1"><mxGeometry height="90" width="200" x="60" y="500" as="geometry"/></mxCell><mxCell id="login-14" edge="1" parent="1" source="login-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.648;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="login-13" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;auth.guards.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;rolBaseGuard(...roles) → inicio&lt;br&gt;permisoGuard(p) → /miembros, /roles&lt;/span&gt;" vertex="1"><mxGeometry height="90" width="200" x="60" y="620" as="geometry"/></mxCell><mxCell id="login-16" edge="1" parent="1" source="login-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.844;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="login-15" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="/auth/acceso-denegado" vertex="1"><mxGeometry height="50" width="200" x="60" y="750" as="geometry"/></mxCell><mxCell id="login-18" edge="1" parent="1" source="login-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="login-17" value="sin permiso"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;POST /api/auth/login&lt;/b&gt;" vertex="1"><mxGeometry height="50" width="300" x="620" y="150" as="geometry"/></mxCell><mxCell id="login-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;AuthController → AuthService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;UsuarioRepository.findByCorreo&lt;br&gt;(@EntityGraph roles, permisos)&lt;/span&gt;" vertex="1"><mxGeometry height="70" width="300" x="620" y="230" as="geometry"/></mxCell><mxCell id="login-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=8;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;usuario&lt;br&gt;usuario_rol&lt;br&gt;rol · rol_permiso&lt;/b&gt;" vertex="1"><mxGeometry height="70" width="150" x="950" y="230" as="geometry"/></mxCell><mxCell id="login-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;GeneradorTokenAcceso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;roles = roles base distintos&lt;br&gt;de los roles &lt;b&gt;activos&lt;/b&gt;&lt;br&gt;permisos = unión ordenada&lt;br&gt;firma RS256&lt;/span&gt;" vertex="1"><mxGeometry height="110" width="300" x="620" y="330" as="geometry"/></mxCell><mxCell id="login-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;JWT&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size:11px&quot;&gt;roles: [&quot;ADMIN_IGLESIA&quot;, &quot;MIEMBRO&quot;]&lt;br&gt;permisos: [&quot;miembros.crear&quot;,&lt;br&gt;&quot;miembros.ver&quot;]&lt;/code&gt;" vertex="1"><mxGeometry height="90" width="300" x="620" y="470" as="geometry"/></mxCell><mxCell id="login-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;GET /api/usuarios/me&lt;/b&gt;" vertex="1"><mxGeometry height="50" width="300" x="620" y="600" as="geometry"/></mxCell><mxCell id="login-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;UsuarioController → UsuarioService&lt;br&gt;UsuarioMapper.aMiUsuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MiUsuarioResponse { perfiles: [{ id, nombre,&lt;br&gt;rolBase, permisos }] } · un perfil por rol &lt;b&gt;activo&lt;/b&gt;&lt;/span&gt;" vertex="1"><mxGeometry height="110" width="300" x="620" y="680" as="geometry"/></mxCell><mxCell id="login-26" edge="1" parent="1" source="login-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.041;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="login-19" value="1. credenciales"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-27" edge="1" parent="1" source="login-19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="login-20" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-28" edge="1" parent="1" source="login-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" target="login-21" value="lee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-29" edge="1" parent="1" source="login-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="login-22" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-30" edge="1" parent="1" source="login-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="login-23" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-31" edge="1" parent="1" source="login-23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.598;entryDx=0;entryDy=0;" target="login-6" value="2. tokenAcceso"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-32" edge="1" parent="1" source="login-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.779;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="login-24" value="3. cargar usuario"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-33" edge="1" parent="1" source="login-24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="login-25" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;usuario-actual.mapper.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;descarta permisos y roles base desconocidos · ordena por jerarquía del rol base y nombre&lt;/span&gt;" vertex="1"><mxGeometry height="90" width="220" x="300" y="790" as="geometry"/></mxCell><mxCell id="login-35" edge="1" parent="1" source="login-25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" target="login-34" value="4. perfiles"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-36" edge="1" parent="1" source="login-34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="login-6" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;auth.interceptor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Authorization: Bearer &amp;lt;JWT&amp;gt; en cada petición&lt;/span&gt;" vertex="1"><mxGeometry height="50" width="460" x="60" y="940" as="geometry"/></mxCell><mxCell id="login-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;JwtConfig&lt;/b&gt; (resource server de iglesia-seguridad)&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DelegatingJwtGrantedAuthoritiesConverter&lt;br&gt;UsuarioController / RolController: hasAuthority(Permisos.*)&lt;/span&gt;" vertex="1"><mxGeometry height="70" width="470" x="620" y="930" as="geometry"/></mxCell><mxCell id="login-39" edge="1" parent="1" source="login-37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="login-38" value="5. peticiones"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;ConvertidorAutoridadesJwt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;roles → &lt;code&gt;ROLE_ADMIN_IGLESIA&lt;/code&gt; · permisos → &lt;code&gt;miembros.ver&lt;/code&gt; (sin prefijo)&lt;br&gt;registrado en SeguridadHttpConfig&lt;/span&gt;" vertex="1"><mxGeometry height="70" width="470" x="1190" y="930" as="geometry"/></mxCell><mxCell id="login-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;@PreAuthorize(&quot;hasAuthority('miembros.ver')&quot;)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;endpoints de negocio (specs siguientes)&lt;/span&gt;" vertex="1"><mxGeometry height="80" width="470" x="1190" y="800" as="geometry"/></mxCell><mxCell id="login-42" edge="1" parent="1" source="login-37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="login-40" value="5. peticiones a iglesia-api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="1050"/><mxPoint x="1425" y="1050"/></Array></mxGeometry></mxCell><mxCell id="login-43" edge="1" parent="1" source="login-40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="login-41" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="login-44" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;Por qué ROLE_* además de los permisos:&lt;/b&gt; el rol base sigue en el token para el &lt;b&gt;ámbito&lt;/b&gt; (p. ej. un LIDER solo ve su red). Pero ningún endpoint autoriza por rol: siempre por permiso. Spring Security 7 agrega además la autoridad &lt;code&gt;FACTOR_BEARER&lt;/code&gt;, que las pruebas ignoran." vertex="1"><mxGeometry height="150" width="470" x="1190" y="150" as="geometry"/></mxCell><mxCell id="login-45" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;Cambios de rol:&lt;/b&gt; el token se calcula al iniciar sesión y al refrescar. Si un rol se desactiva, deja de aportar permisos y perfiles en el siguiente login o refresco (token de acceso de vida corta)." vertex="1"><mxGeometry height="120" width="470" x="1190" y="320" as="geometry"/></mxCell><mxCell id="login-46" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;Compatibilidad con la SPEC 01:&lt;/b&gt; un valor antiguo en &lt;code&gt;sessionStorage&lt;/code&gt; (&lt;code&gt;'ADMIN_IGLESIA'&lt;/code&gt;) no es un id válido y se descarta sin errores; con un solo perfil se selecciona solo. Con los 4 roles base, el comportamiento visible es el mismo de antes." vertex="1"><mxGeometry height="140" width="470" x="1190" y="460" as="geometry"/></mxCell><mxCell id="login-47" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;El perfil limita la navegación:&lt;/b&gt; el menú y los guards usan solo los permisos del perfil activo, no la unión. El backend autoriza con todos los permisos del token, así que cambiar de perfil no pide un token nuevo." vertex="1"><mxGeometry height="150" width="470" x="1190" y="620" as="geometry"/></mxCell><mxCell id="login-48" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" value="&lt;b&gt;Leyenda&lt;/b&gt;" vertex="1"><mxGeometry height="22" width="300" x="30" y="1170" as="geometry"/></mxCell><mxCell id="login-49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="" vertex="1"><mxGeometry height="20" width="26" x="30" y="1196" as="geometry"/></mxCell><mxCell id="login-50" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" value="Frontend iglesia-web (componentes y servicios)" vertex="1"><mxGeometry height="22" width="300" x="64" y="1196" as="geometry"/></mxCell><mxCell id="login-51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;" value="" vertex="1"><mxGeometry height="20" width="26" x="30" y="1224" as="geometry"/></mxCell><mxCell id="login-52" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" value="Navegación por permisos (guards y menú)" vertex="1"><mxGeometry height="22" width="300" x="64" y="1224" as="geometry"/></mxCell><mxCell id="login-53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;vertical