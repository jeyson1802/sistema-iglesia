=11;" parent="1" vertex="1" ><mxGeometry x="1210" y="1110" width="420" height="100" as="geometry" /></mxCell><mxCell id="arquitectura-72" value="&lt;b&gt;Logs sin datos sensibles&lt;/b&gt;&lt;br&gt;«Aporte registrado id=… por usuarioId=…»: nunca montos, nombres, peticiones ni observaciones." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1650" y="1110" width="450" height="100" as="geometry" /></mxCell><mxCell id="arquitectura-73" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1210" y="1225" width="230" height="220" as="geometry" /></mxCell><mxCell id="arquitectura-74" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1222" y="1259" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-75" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1258" y="1255" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-76" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1" ><mxGeometry x="1222" y="1289" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-77" value="Rutas y guards" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1258" y="1285" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-78" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1" ><mxGeometry x="1222" y="1319" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-79" value="Contrato HTTP (endpoint)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1258" y="1315" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-80" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1222" y="1349" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-81" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1258" y="1345" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-82" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1222" y="1379" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-83" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1258" y="1375" width="175" height="28" as="geometry" /></mxCell><mxCell id="arquitectura-84" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1222" y="1409" width="28" height="20" as="geometry" /></mxCell><mxCell id="arquitectura-85" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1258" y="1405" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="registro" name="2. Registro de un aporte"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="registro-1" value="&lt;b&gt;Registro rápido de un aporte y sus validaciones&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="registro-2" value="De la pila de sobres al final del culto a la fila en aporte: qué valida el formulario, qué valida el backend y qué responde en cada caso." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="registro-3" value="Formulario (FormularioAporteComponent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="560" height="1000" as="geometry" /></mxCell><mxCell id="registro-4" value="&lt;b&gt;1. Abrir «Registrar aporte»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fecha = hoy · última categoría y medio recordados&lt;br&gt;foco en el monto (inputmode decimal)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="160" width="500" height="75" as="geometry" /></mxCell><mxCell id="registro-5" value="&lt;b&gt;2. Elegir con un toque&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;categoría y medio en p-selectbutton&lt;br&gt;¿la categoría exige aportante? → aportante obligatorio&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="265" width="500" height="75" as="geometry" /></mxCell><mxCell id="registro-6" value="&lt;b&gt;3. Datos opcionales&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;n.º de operación solo si el medio no es efectivo&lt;br&gt;petición y observación en «Más datos (opcional)»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="370" width="500" height="75" as="geometry" /></mxCell><mxCell id="registro-7" value="&lt;b&gt;4. Validar en el formulario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;monto &amp;gt; 0 · fecha no futura · aportante si se exige&lt;br&gt;mensajes junto al campo diciendo cómo corregir&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="475" width="500" height="75" as="geometry" /></mxCell><mxCell id="registro-8" value="&lt;b&gt;5. «Guardar» o «Guardar y registrar otro»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Ctrl/⌘ + Enter = guardar y seguir · botones deshabilitados&lt;br&gt;mientras se procesa&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="580" width="500" height="75" as="geometry" /></mxCell><mxCell id="registro-9" value="&lt;b&gt;6. Respuesta 201&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;toast «S/ 50.00 de Juan Pérez» · recarga resumen y tabla&lt;br&gt;seguir: misma fecha, categoría y medio; contador de la tanda&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="890" width="500" height="80" as="geometry" /></mxCell><mxCell id="registro-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-4" target="registro-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-5" target="registro-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-6" target="registro-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-7" target="registro-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-14" value="&lt;b&gt;Respuesta 400 / 409&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;mensaje arriba del formulario&lt;br&gt;&lt;code&gt;errores.miembroId&lt;/code&gt; → junto al campo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="1000" width="500" height="70" as="geometry" /></mxCell><mxCell id="registro-15" value="POST /api/aportes · AporteService.crear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="620" y="110" width="1100" height="1000" as="geometry" /></mxCell><mxCell id="registro-16" value="&lt;b&gt;a. Bean Validation (@Valid)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;@PastOrPresent fecha · @Positive @Digits(10,2) monto&lt;br&gt;@Size en textos · medio del enum&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="650" y="160" width="420" height="75" as="geometry" /></mxCell><mxCell id="registro-17" value="&lt;b&gt;b. categorias.asignable(categoriaId, null)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;debe existir en la iglesia del token y estar activa&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="650" y="290" width="420" height="75" as="geometry" /></mxCell><mxCell id="registro-18" value="&lt;b&gt;c. validarAportante&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sin miembro y la categoría lo exige → 409 miembroId&lt;br&gt;con miembro: ReferenciasMiembro.validarAsignable (activo)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="650" y="420" width="420" height="80" as="geometry" /></mxCell><mxCell id="registro-19" value="&lt;b&gt;d. datos(solicitud)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;EFECTIVO → numeroOperacion = null&lt;br&gt;petición/observación: recortarOpcional (conserva saltos)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="650" y="555" width="420" height="75" as="geometry" /></mxCell><mxCell id="registro-20" value="&lt;b&gt;e. Aporte.nuevo(datos, categoría, usuarioId, ahora)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;registrado_por = usuarioId del token · registrado_en = Clock&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="650" y="685" width="420" height="75" as="geometry" /></mxCell><mxCell id="registro-21" value="&lt;b&gt;f. aportes.save · LOG.info sin datos personales&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Hibernate llena iglesia_id (@TenantId) · RLS lo verifica&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="650" y="815" width="420" height="75" as="geometry" /></mxCell><mxCell id="registro-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-16" target="registro-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-17" target="registro-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-18" target="registro-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-19" target="registro-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="registro-20" target="registro-21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-27" value="POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="registro-8" target="registro-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-28" value="201 + Location" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="registro-21" target="registro-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-29" value="&lt;b&gt;400 Datos inválidos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fecha futura · monto ≤ 0 · más de 2 decimales&lt;br&gt;ProblemDetail con errores por campo y traceId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1120" y="160" width="330" height="75" as="geometry" /></mxCell><mxCell id="registro-30" value="&lt;b&gt;409 categoriaId&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;no existe en la iglesia (otra iglesia = no existe)&lt;br&gt;o está desactivada&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1120" y="290" width="330" height="75" as="geometry" /></mxCell><mxCell id="registro-31" value="&lt;b&gt;409 miembroId&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Esta categoría exige indicar quién aporta»&lt;br&gt;o el miembro está inactivo / es de otra iglesia&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="1120" y="420" width="330" height="80" as="geometry" /></mxCell><mxCell id="registro-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="registro-16" target="registro-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="registro-17" target="registro-30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="registro-18" target="registro-31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="registro-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="registro-31" target="registro-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1285" y="1035" /></Array></mxGeometry></mxCell><mxCell id="registro-36" value="&lt;b&gt;aporte&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nueva fila: anulado = false · motivo NULL&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1120" y="815" width="300" height="80" as="geometry" /></mxCell><mxCell id="registro-37" value="&lt;b&gt;Corregir (PUT)&lt;/b&gt;&lt;br&gt;Mismas reglas, pero la categoría y el aportante que ya tenía se conservan aunque se hayan desactivado. Guarda modificado_por/en. Un aporte anulado no se corrige (409)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1120" y="560" width="330" height="115" as="geometry" /></mxCell><mxCell id="registro-38" value="&lt;b&gt;¿Por qué 409 y no 400 para el aportante?&lt;/b&gt;&lt;br&gt;El cuerpo es válido por sí solo; choca con el estado de la categoría elegida (regla de negocio). Igual que las referencias inactivas en miembros." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1120" y="690" width="330" height="110" as="geometry" /></mxCell><mxCell id="registro-39" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1480" y="160" width="230" height="190" as="geometry" /></mxCell><mxCell id="registro-40" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1492" y="194" width="28" height="20" as="geometry" /></mxCell><mxCell id="registro-41" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1528" y="190" width="175" height="28" as="geometry" /></mxCell><mxCell id="registro-42" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1492" y="224" width="28" height="20" as="geometry" /></mxCell><mxCell id="registro-43" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1528" y="220" width="175" height="28" as="geometry" /></mxCell><mxCell id="registro-44" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1492" y="254" width="28" height="20" as="geometry" /></mxCell><mxCell id="registro-45" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1528" y="250" width="175" height="28" as="geometry" /></mxCell><mxCell id="registro-46" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1492" y="284" width="28" height="20" as="geometry" /></mxCell><mxCell id="registro-47" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1528" y="280" width="175" height="28" as="geometry" /></mxCell><mxCell id="registro-48" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1492" y="314" width="28" height="20" as="geometry" /></mxCell><mxCell id="registro-49" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1528" y="310" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="configuracion" name="3. Moneda y categorías"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="configuracion-1" value="&lt;b&gt;Configuración: moneda, categorías y categorías por defecto&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="configuracion-2" value="Cada iglesia elige su moneda y sus conceptos de aporte. Toda iglesia nace con Diezmo y Ofrenda, ya sea por la migración o por el evento de alta." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="configuracion-3" value="Moneda (PUT /api/aportes/configuracion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="820" height="450" as="geometry" /></mxCell><mxCell id="configuracion-4" value="&lt;b&gt;1. ¿Está en MonedasAdmitidas?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PEN, USD, EUR, MXN, COP, CLP, ARS, BOB, BRL…&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="160" width="360" height="70" as="geometry" /></mxCell><mxCell id="configuracion-5" value="&lt;b&gt;2. ¿Es la misma que la actual?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sí → 200 sin cambios&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="260" width="360" height="65" as="geometry" /></mxCell><mxCell id="configuracion-6" value="&lt;b&gt;3. ¿Hay aportes vigentes?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;aportes.existsByAnuladoFalse()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="355" width="360" height="65" as="geometry" /></mxCell><mxCell id="configuracion-7" value="&lt;b&gt;4. Guardar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;configuracion_aportes (crea la fila si no existe)&lt;br&gt;LOG.info iglesiaId · usuarioId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="450" width="360" height="75" as="geometry" /></mxCell><mxCell id="configuracion-8" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="configuracion-4" target="configuracion-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="configuracion-5" target="configuracion-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="configuracion-6" target="configuracion-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-11" value="&lt;b&gt;400 moneda no admitida&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="170" width="240" height="50" as="geometry" /></mxCell><mxCell id="configuracion-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="configuracion-11" target="configuracion-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-13" value="&lt;b&gt;409 «Ya hay aportes registrados en PEN»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;los montos guardados cambiarían de significado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="355" width="340" height="65" as="geometry" /></mxCell><mxCell id="configuracion-14" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="configuracion-6" target="configuracion-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-15" value="&lt;b&gt;En la interfaz&lt;/b&gt;&lt;br&gt;&lt;code&gt;monedaEditable: false&lt;/code&gt; bloquea el selector y explica por qué. Tras registrar un aporte, &lt;code&gt;marcarConAportes()&lt;/code&gt; actualiza la señal sin recargar." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="470" y="450" width="340" height="90" as="geometry" /></mxCell><mxCell id="configuracion-16" value="Categorías (/api/categorias-aporte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="880" y="110" width="840" height="450" as="geometry" /></mxCell><mxCell id="configuracion-17" value="&lt;b&gt;Crear / editar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nombre normalizado y único (Textos.mismoTexto)&lt;br&gt;saveAndFlush: alta simultánea → 409, no 500&lt;br&gt;las nuevas van al final del orden&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="910" y="160" width="380" height="90" as="geometry" /></mxCell><mxCell id="configuracion-18" value="&lt;b&gt;Ordenar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PUT /orden con todos los ids, una vez cada uno&lt;br&gt;falta o se repite → 400&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="910" y="275" width="380" height="70" as="geometry" /></mxCell><mxCell id="configuracion-19" value="&lt;b&gt;Desactivar / reactivar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;siempre permitido · sus aportes se conservan&lt;br&gt;y siguen contando; no se ofrece para nuevos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="910" y="370" width="380" height="70" as="geometry" /></mxCell><mxCell id="configuracion-20" value="&lt;b&gt;categoria_aporte&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ux_categoria_aporte_nombre&lt;br&gt;(iglesia_id, lower(nombre))&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1340" y="260" width="340" height="100" as="geometry" /></mxCell><mxCell id="configuracion-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="configuracion-17" target="configuracion-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="configuracion-18" target="configuracion-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="configuracion-19" target="configuracion-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-24" value="&lt;b&gt;exige_aportante&lt;/b&gt;&lt;br&gt;Diezmo: sí (se identifica a quien diezma). Ofrenda: no (la del culto suele ser anónima). Cada iglesia lo ajusta por categoría." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1340" y="390" width="340" height="100" as="geometry" /></mxCell><mxCell id="configuracion-25" value="&lt;b&gt;¿Por qué no se borran?&lt;/b&gt;&lt;br&gt;Los aportes registrados las referencian: borrar rompería el historial. Se desactivan, como los niveles." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1340" y="160" width="340" height="85" as="geometry" /></mxCell><mxCell id="configuracion-26" value="Categorías por defecto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="590" width="1690" height="470" as="geometry" /></mxCell><mxCell id="configuracion-27" value="&lt;b&gt;V7__aportes.sql&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;INSERT Diezmo (orden 1, exige) y Ofrenda (orden 2)&lt;br&gt;para cada iglesia que ya existe&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="60" y="640" width="380" height="100" as="geometry" /></mxCell><mxCell id="configuracion-28" value="&lt;b&gt;1. POST /api/iglesias (ADMIN_SISTEMA)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;IglesiaService.crear → saveAndFlush&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="520" y="640" width="360" height="65" as="geometry" /></mxCell><mxCell id="configuracion-29" value="&lt;b&gt;2. publishEvent(new IglesiaCreada(id))&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iglesia/model: el contexto iglesia no conoce a aportes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="520" y="735" width="360" height="65" as="geometry" /></mxCell><mxCell id="configuracion-30" value="&lt;b&gt;3. CategoriasPorDefecto.alCrearIglesia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;@EventListener síncrono: misma transacción del alta&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="520" y="830" width="360" height="65" as="geometry" /></mxCell><mxCell id="configuracion-31" value="&lt;b&gt;4. JdbcTemplate en la misma conexión&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;set_config(&#x27;app.iglesia_id&#x27;, id, true)&lt;br&gt;INSERT Diezmo y Ofrenda · set_config(…, &#x27;&#x27;, true)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="520" y="925" width="360" height="80" as="geometry" /></mxCell><mxCell id="configuracion-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="configuracion-28" target="configuracion-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="configuracion-29" target="configuracion-30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="configuracion-30" target="configuracion-31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-35" value="&lt;b&gt;categoria_aporte&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;2 filas de la iglesia nueva&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="960" y="925" width="260" height="80" as="geometry" /></mxCell><mxCell id="configuracion-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="configuracion-31" target="configuracion-35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="configuracion-37" value="&lt;b&gt;¿Por qué fijar app.iglesia_id a mano?&lt;/b&gt;&lt;br&gt;El alta la hace el administrador del sistema sin iglesia en el token: la política RLS (USING, que también rige al insertar) rechazaría la fila. Se fija solo para estas dos inserciones y se vuelve a dejar vacío." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="960" y="640" width="360" height="130" as="geometry" /></mxCell><mxCell id="configuracion-38" value="&lt;b&gt;Si algo falla&lt;/b&gt;&lt;br&gt;Al ser síncrono y en la misma transacción, un error al crear las categorías deshace también el alta de la iglesia: nunca queda una iglesia sin categorías." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1350" y="640" width="340" height="130" as="geometry" /></mxCell><mxCell id="configuracion-39" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1380" y="820" width="230" height="160" as="geometry" /></mxCell><mxCell id="configuracion-40" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1392" y="854" width="28" height="20" as="geometry" /></mxCell><mxCell id="configuracion-41" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="850" width="175" height="28" as="geometry" /></mxCell><mxCell id="configuracion-42" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1392" y="884" width="28" height="20" as="geometry" /></mxCell><mxCell id="configuracion-43" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="880" width="175" height="28" as="geometry" /></mxCell><mxCell id="configuracion-44" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1392" y="914" width="28" height="20" as="geometry" /></mxCell><mxCell id="configuracion-45" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="910" width="175" height="28" as="geometry" /></mxCell><mxCell id="configuracion-46" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1392" y="944" width="28" height="20" as="geometry" /></mxCell><mxCell id="configuracion-47" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="940" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ambito" name="4. Ámbito, anulación y totales"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ambito-1" value="&lt;b&gt;Ámbito de lectura, anulación y cálculo de los totales&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="ambito-2" value="Quién ve qué aportes, cómo se anula sin perder el historial y cómo se calcula el resumen en la base." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="ambito-3" value="AmbitoAportes.actual() → AlcanceAportes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="820" height="480" as="geometry" /></mxCell><mxCell id="ambito-4" value="&lt;b&gt;Token (JWT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;roles base · miembro_id · permisos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="160" width="260" height="60" as="geometry" /></mxCell><mxCell id="ambito-5" value="&lt;b&gt;ADMIN_IGLESIA o ADMIN_SISTEMA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;completo(): toda la iglesia&lt;br&gt;el filtro miembroId se respeta&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="270" width="360" height="70" as="geometry" /></mxCell><mxCell id="ambito-6" value="&lt;b&gt;Otro rol con miembro_id (p. ej. LIDER)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;soloDe(miembroId): solo los suyos&lt;br&gt;el filtro miembroId se ignora&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="370" width="360" height="70" as="geometry" /></mxCell><mxCell id="ambito-7" value="&lt;b&gt;Sin miembro vinculado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ninguno(): listado vacío · totales en 0 · detalle 404&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="470" width="360" height="70" as="geometry" /></mxCell><mxCell id="ambito-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-4" target="ambito-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="190" /><mxPoint x="45" y="305" /></Array></mxGeometry></mxCell><mxCell id="ambito-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-4" target="ambito-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="190" /><mxPoint x="45" y="405" /></Array></mxGeometry></mxCell><mxCell id="ambito-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-4" target="ambito-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="190" /><mxPoint x="45" y="505" /></Array></mxGeometry></mxCell><mxCell id="ambito-11" value="&lt;b&gt;ConsultaAportes.criterio(filtro)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hasta &amp;lt; desde → 400 hasta&lt;br&gt;más de 366 días → 400 hasta&lt;br&gt;CriterioAportes con aportanteEfectivo()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="470" y="270" width="350" height="90" as="geometry" /></mxCell><mxCell id="ambito-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-5" target="ambito-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-6" target="ambito-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-7" target="ambito-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-15" value="&lt;b&gt;Detalle de un aporte ajeno&lt;/b&gt;&lt;br&gt;&lt;code&gt;obtener(id)&lt;/code&gt; filtra con &lt;code&gt;alcance.incluye(miembroId)&lt;/code&gt;: fuera del ámbito responde 404, igual que si no existiera (no revela que existe)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="470" y="390" width="350" height="100" as="geometry" /></mxCell><mxCell id="ambito-16" value="&lt;b&gt;Escribir no usa el ámbito&lt;/b&gt;&lt;br&gt;Registrar, corregir y anular exigen su permiso (403 sin él). El LIDER solo tiene aportes.ver." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="470" y="500" width="350" height="75" as="geometry" /></mxCell><mxCell id="ambito-17" value="Anulación (PATCH /{id}/anulacion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="880" y="110" width="840" height="480" as="geometry" /></mxCell><mxCell id="ambito-18" value="&lt;b&gt;1. buscar(id)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;otra iglesia → 404&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="910" y="160" width="360" height="60" as="geometry" /></mxCell><mxCell id="ambito-19" value="&lt;b&gt;2. ¿Ya está anulado?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sí → 409 «El aporte ya está anulado»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="910" y="250" width="360" height="60" as="geometry" /></mxCell><mxCell id="ambito-20" value="&lt;b&gt;3. aporte.anular(motivo, usuarioId, ahora)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;anulado = true · motivo normalizado&lt;br&gt;modificado_por / modificado_en&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="910" y="340" width="360" height="75" as="geometry" /></mxCell><mxCell id="ambito-21" value="&lt;b&gt;Efecto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;deja de contar en el resumen y en el bloqueo de moneda&lt;br&gt;el listado lo muestra solo con «Incluir anulados»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="910" y="450" width="360" height="70" as="geometry" /></mxCell><mxCell id="ambito-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-18" target="ambito-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-19" target="ambito-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-20" target="ambito-21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-25" value="&lt;b&gt;aporte&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CHECK (anulado = (motivo_anulacion IS NOT NULL))&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1320" y="340" width="360" height="90" as="geometry" /></mxCell><mxCell id="ambito-26" value="&lt;b&gt;Sin «desanular»&lt;/b&gt;&lt;br&gt;Si se anuló por error, se registra de nuevo: el historial queda íntegro y auditable. Nunca se borra una fila." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="1320" y="160" width="360" height="90" as="geometry" /></mxCell><mxCell id="ambito-27" value="Resumen (GET /api/aportes/resumen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="620" width="1690" height="480" as="geometry" /></mxCell><mxCell id="ambito-28" value="&lt;b&gt;1. Mismo criterio que el listado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ConsultaAportes: rango + filtros + ámbito&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="670" width="380" height="65" as="geometry" /></mxCell><mxCell id="ambito-29" value="&lt;b&gt;2. totalesPorCategoria · totalesPorMedio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;JPQL con GROUP BY · anulado = false&lt;br&gt;filtro nulo = sin restricción (parámetros enlazados)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="765" width="380" height="75" as="geometry" /></mxCell><mxCell id="ambito-30" value="&lt;b&gt;3. total del período anterior&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;misma duración, termina el día antes de desde&lt;br&gt;(oct 1–31 → ago 31–sep 30)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="870" width="380" height="75" as="geometry" /></mxCell><mxCell id="ambito-31" value="&lt;b&gt;4. ResumenAportesResponse&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;moneda · total · cantidad · totalPeriodoAnterior&lt;br&gt;porCategoria (en su orden) · porMedio&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="60" y="975" width="380" height="75" as="geometry" /></mxCell><mxCell id="ambito-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-28" target="ambito-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-29" target="ambito-30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-30" target="ambito-31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-35" value="&lt;b&gt;aporte&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ix_aporte_fecha (iglesia_id, fecha DESC)&lt;br&gt;ix_aporte_categoria · ix_aporte_miembro&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="500" y="765" width="340" height="100" as="geometry" /></mxCell><mxCell id="ambito-36" value="GROUP BY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-29" target="ambito-35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-37" value="&lt;b&gt;ResumenAportesComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;total · variación ▲ verde / ▼ rojo con texto&lt;br&gt;cantidad · promedio = total / cantidad&lt;br&gt;anillo por categoría · barras por medio&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="920" y="670" width="400" height="95" as="geometry" /></mxCell><mxCell id="ambito-38" value="&lt;b&gt;Clic en una porción o barra&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;filtrarCategoria / filtrarMedio → la URL&lt;br&gt;→ se recargan resumen y tabla&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="920" y="800" width="400" height="75" as="geometry" /></mxCell><mxCell id="ambito-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="ambito-37" target="ambito-38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ambito-40" value="JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ambito-31" target="ambito-37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1012" /><mxPoint x="880" y="717" /></Array></mxGeometry></mxCell><mxCell id="ambito-41" value="&lt;b&gt;¿Por qué en la base?&lt;/b&gt;&lt;br&gt;Sumar en PostgreSQL con los índices que empiezan por iglesia_id evita traer todos los aportes a memoria y da el mismo resultado que verá el listado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="920" y="905" width="400" height="100" as="geometry" /></mxCell><mxCell id="ambito-42" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=4;" parent="1" vertex="1" ><mxGeometry x="1380" y="670" width="230" height="220" as="geometry" /></mxCell><mxCell id="ambito-43" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" ><mxGeometry x="1392" y="704" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-44" value="Frontend (iglesia-web)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="700" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" ><mxGeometry x="1392" y="734" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-46" value="iglesia-seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="730" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-47" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;" parent="1" vertex="1" ><mxGeometry x="1392" y="764" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-48" value="iglesia-api" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="760" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-49" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1" ><mxGeometry x="1392" y="794" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-50" value="Tabla de PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="790" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-51" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" ><mxGeometry x="1392" y="824" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-52" value="Rechazo / error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="820" width="175" height="28" as="geometry" /></mxCell><mxCell id="ambito-53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1" ><mxGeometry x="1392" y="854" width="28" height="20" as="geometry" /></mxCell><mxCell id="ambito-54" value="Nota o decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1" ><mxGeometry x="1428" y="850" width="175" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
