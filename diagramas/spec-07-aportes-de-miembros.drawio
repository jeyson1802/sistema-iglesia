<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="arquitectura" name="1. Arquitectura de aportes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arquitectura-1" value="&lt;b&gt;Arquitectura: aportes de los miembros&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#000000;" parent="1" vertex="1" ><mxGeometry x="40" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-2" value="Componentes del frontend, servicios REST que consumen, clases de iglesia-api que los atienden y tablas que leen o escriben." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" parent="1" vertex="1" ><mxGeometry x="40" y="62" width="1300" height="40" as="geometry" /></mxCell><mxCell id="arquitectura-3" value="iglesia-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="30" y="110" width="760" height="1260" as="geometry" /></mxCell><mxCell id="arquitectura-4" value="Contrato HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="820" y="110" width="340" height="1260" as="geometry" /></mxCell><mxCell id="arquitectura-5" value="iglesia-api · paquete aportes/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#3d9e9a;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;" parent="1" vertex="1" ><mxGeometry x="1190" y="110" width="930" height="1260" as="geometry" /></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;aportes.routes.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/aportes → aportes.ver · /aportes/configuracion → aportes.configurar&lt;br&gt;ambas detrás de &lt;code&gt;iglesiaFijadaGuard&lt;/code&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="150" width="420" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-7" value="&lt;b&gt;AppMenu · construirMenu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Iglesia › Aportes / «Mis aportes» (pi-wallet)&lt;br&gt;Administración › Configuración de aportes (pi-cog)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="490" y="150" width="280" height="75" as="geometry" /></mxCell><mxCell id="arquitectura-8" value="&lt;b&gt;AportesListaComponent (contenedor)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;filtros en la URL · resumen · tabla · diálogos&lt;br&gt;«Mis aportes» y solo lectura para el líder · toast&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="260" width="400" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-9" value="&lt;b&gt;FiltrosAportesComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Hoy · Semana · Mes · Mes anterior · Año · Personalizado&lt;br&gt;categoría · medio · aportante · anulados · chips&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="355" width="340" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-10" value="&lt;b&gt;ResumenAportesComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;total · variación ▲▼ · cantidad · promedio&lt;br&gt;p-chart anillo (categoría) y barras (medio)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="410" y="355" width="360" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;TablaAportesComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tabla en escritorio · tarjetas en el móvil&lt;br&gt;menú por fila · anulados tachados&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="450" width="340" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-12" value="&lt;b&gt;DetalleAporteComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;p-drawer · petición destacada · auditoría&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="410" y="450" width="360" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-13" value="&lt;b&gt;FormularioAporteComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;monto con foco · categoría y medio de un toque&lt;br&gt;«Guardar y registrar otro» · Ctrl/⌘ + Enter&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="545" width="340" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-14" value="&lt;b&gt;AnularAporteComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;resumen de lo que se anula · motivo obligatorio&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="410" y="545" width="360" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-8" target="arquitectura-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-8" target="arquitectura-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-17" value="&lt;b&gt;ConfiguracionAportesComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;moneda + categorías (subir/bajar, editar, desactivar)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="650" width="400" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-18" value="&lt;b&gt;SelectorMonedaComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«S/ · Sol peruano (PEN)» · bloqueada con aportes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="735" width="340" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-19" value="&lt;b&gt;TablaCategorias · FormularioCategoria&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Exige aportante» / «Admite anónimos»&lt;br&gt;p-toggleswitch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="410" y="735" width="360" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-17" target="arquitectura-18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-17" target="arquitectura-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-22" value="&lt;b&gt;AportesMiembroComponent (ficha del miembro)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;total del año · últimos 5 · «Ver todos» → /aportes?miembroId=&lt;br&gt;solo si el perfil puede ver esos aportes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="820" width="460" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-23" value="&lt;b&gt;MonedaPipe (shared/pipes)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Intl.NumberFormat es-PE · «S/ 1,250.00»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="530" y="820" width="240" height="70" as="geometry" /></mxCell><mxCell id="arquitectura-24" value="&lt;b&gt;AportesService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · resumen · obtener · crear · actualizar · anular&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="930" width="340" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-25" value="&lt;b&gt;ConfiguracionAportesService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;moneda como signal (una carga) · monedas · guardar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="410" y="930" width="360" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-26" value="&lt;b&gt;CategoriasAporteService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;listar · crear · actualizar · ordenar · estado&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="50" y="1015" width="340" height="60" as="geometry" /></mxCell><mxCell id="arquitectura-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-8" target="arquitectura-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="295" /><mxPoint x="40" y="960" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-17" target="arquitectura-26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="692" /><mxPoint x="35" y="1045" /></Array></mxGeometry></mxCell><mxCell id="arquitectura-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="arquitectura-22" target="arquitectura-24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arquitectura-30" value="&lt;b&gt;Filtros en la URL&lt;/b&gt;&lt;br&gt;&lt;code&gt;/aportes?desde=…&amp;amp;categoriaId=…&lt;/code&gt;: se comparten, «Atrás» los respeta y la ficha enlaza ya filtrada. Lo que falta o no se entiende vale «mes en curso, sin filtros»." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="1110" width="350" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-31" value="&lt;b&gt;Comodidad local&lt;/b&gt;&lt;br&gt;La última categoría y medio se recuerdan en &lt;code&gt;localStorage&lt;/code&gt; (con try/catch); si no se puede leer, se usa la primera categoría activa y Efectivo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="420" y="1110" width="350" height="110" as="geometry" /></mxCell><mxCell id="arquitectura-32" value="&lt;b&gt;Ámbito en la interfaz&lt;/b&gt;&lt;br&gt;&lt;code&gt;veAportesDeTodaLaIglesia&lt;/code&gt;: ADMIN_IGLESIA o ADMIN_SISTEMA ven todo; el resto, solo lo suyo. Es solo presentación: el backend decide." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="1" vertex="1" ><mxGeometry x="50" y="1235" width="350" height="100" as="geometry" /></mxCell><mxCell id="arquitectura-33" value="&lt;b&gt;GET · PUT /api/aportes/configuracion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ moneda, monedaEditable }&lt;br&gt;PUT: 400 no admitida · 409 con aportes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="150" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-34" value="&lt;b&gt;GET /api/aportes/monedas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;código · nombre · símbolo (java.util.Currency)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="280" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-35" value="&lt;b&gt;/api/categorias-aporte&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GET · POST · PUT /{id} · PUT /orden&lt;br&gt;PATCH /{id}/estado · 409 nombre repetido&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="410" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-36" value="&lt;b&gt;GET /api/aportes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;desde · hasta (≤ 366 días) · categoriaId · medio&lt;br&gt;miembroId · incluirAnulados · página&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="540" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-37" value="&lt;b&gt;GET /api/aportes/resumen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;total · cantidad · totalPeriodoAnterior&lt;br&gt;porCategoria · porMedio (sin anulados)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="670" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-38" value="&lt;b&gt;GET /api/aportes/{id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;200 · 404 (otra iglesia o fuera del ámbito)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="800" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-39" value="&lt;b&gt;POST · PUT /api/aportes[/{id}]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;201/200 · 400 · 404 · 409 (inactivo, exige aportante, anulado)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1" ><mxGeometry x="840" y="930" width="300" height="90" as="geometry" /></mxCell><mxCell id="arquitectura-40" value="&lt;b&gt;PATCH /api/aportes/{id}/anulacion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ motivo } · 400 · 404 · 409 ya anulado&lt;/span&